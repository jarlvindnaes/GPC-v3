---
import { ParticleField } from './ParticleField';
import { EngineFlow } from './EngineFlow';
import { Database, Box, Network, ClipboardList, FileCheck, Leaf, ChartColumn, BadgeCheck, ShoppingCart, Ship } from 'lucide-react';
---
<section class="section section--dark" id="construction-how">
  <ParticleField client:visible={{ rootMargin: "1200px" }} />
  <div class="container">
    <div class="section__head">
      <span class="kicker">The data layer</span>
      <h2>One data layer. <span class="hl">Not ten point tools.</span></h2>
      <p class="sub">Most companies bolt on a new tool for every regulation, and the data scatters across systems. Product Connect replaces the stack with one foundation - enter a fact once, and it feeds every report, EPD, and passport. Calculate a component once; every product that shares it reuses the result.</p>
    </div>
    <div class="engine engine--tiered">
      <EngineFlow client:visible={{ rootMargin: "1200px" }} />
      <div class="engine__tiers" aria-hidden="true">
        <div class="tier">
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__label">Tier 3</span>
          <span class="tier__desc">Raw material data</span>
        </div>
        <div class="tier">
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__label">Tier 2</span>
          <span class="tier__desc">Material data</span>
        </div>
        <div class="tier">
          <span class="tier__bar"></span>
          <span class="tier__label">Tier 1</span>
          <span class="tier__desc">Product data</span>
        </div>
      </div>
      <div class="engine__col">
        <h3>Data in</h3>
        <ul class="engine__list">
          <li><Database /> ERP / PLM / PIM systems</li>
          <li><Box /> 3D / CAD across product lines</li>
          <li class="engine__supplier"><Network /> Multi-tier supplier data</li>
          <li><ClipboardList /> Bills of materials &amp; materials</li>
          <li><FileCheck /> Certificates &amp; test reports</li>
        </ul>
      </div>
      <div class="engine__hub">
        <div class="core"><span class="core__logo" aria-hidden="true"></span><b>PRODUCT CONNECT</b><span>one product graph, every SKU</span></div>
      </div>
      <div class="engine__col">
        <h3>Value out</h3>
        <ul class="engine__list">
          <li class="engine__out">
            <BadgeCheck />
            <div class="engine__out-body">
              <span class="engine__out-title">Compliance</span>
              <ul class="engine__out-pts">
                <li>Regulatory &amp; CBAM reporting</li>
                <li>Risk assessment</li>
                <li>Audit-ready EPDs &amp; DPPs</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <Leaf />
            <div class="engine__out-body">
              <span class="engine__out-title">Sustainability</span>
              <ul class="engine__out-pts">
                <li>GHG accounting &amp; ESG reporting</li>
                <li>Impact measurement</li>
                <li>Stakeholder engagement</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <ChartColumn />
            <div class="engine__out-body">
              <span class="engine__out-title">Development</span>
              <ul class="engine__out-pts">
                <li>Product design &amp; engineering</li>
                <li>Component-level LCA</li>
                <li>Production certification</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <Ship />
            <div class="engine__out-body">
              <span class="engine__out-title">Operations</span>
              <ul class="engine__out-pts">
                <li>Product planning</li>
                <li>Quality control</li>
                <li>Spare parts &amp; resource efficiency</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <ShoppingCart />
            <div class="engine__out-body">
              <span class="engine__out-title">Procurement</span>
              <ul class="engine__out-pts">
                <li>Supplier onboarding</li>
                <li>Contract management</li>
                <li>Spend analysis</li>
              </ul>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
<style is:global>
/* Ported from public/wireframes/wireframe.css (the #how "data layer" section).
   Everything is namespaced under #construction-how: wireframe.css itself carries global
   resets (*, html, body, bare h1-h6) that would restyle the rest of this page, so it is
   deliberately not imported. is:global is used rather than Astro scoping because the
   canvases are rendered by React islands and never receive the scope attribute. */
#construction-how {
  --dark: #11152a;
  --dark-2: #1a2040;
  --dark-line: rgba(255,255,255,0.12);
  --dark-ink: #eef1fb;
  --dark-soft: #aab2cf;
  --indigo: #3e63dd;
  --indigo-soft: #9db4ff;
  --maxw: 1080px;

  position: relative;
  overflow: hidden;
  padding: 92px 0;
  background: var(--dark);
  color: var(--dark-ink);
  line-height: 1.6;
}
#construction-how * { box-sizing: border-box; }
#construction-how > .container { position: relative; z-index: 1; max-width: var(--maxw); margin: 0 auto; padding: 0 28px; }
#construction-how .particle-field { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .55;
  -webkit-mask: linear-gradient(to bottom, transparent 0, #000 12%, #000 86%, transparent 100%);
          mask: linear-gradient(to bottom, transparent 0, #000 12%, #000 86%, transparent 100%); }

#construction-how .section__head { max-width: 64ch; }
#construction-how .kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .2em;
  text-transform: uppercase; color: var(--indigo-soft); margin-bottom: 18px; }
#construction-how h2 { font-size: clamp(26px, 3.6vw, 38px); line-height: 1.12; letter-spacing: -.02em; font-weight: 800; color: var(--dark-ink); }
#construction-how h2 .hl { color: var(--indigo-soft); }
#construction-how .sub { font-size: clamp(16px, 1.9vw, 19px); color: var(--dark-soft); max-width: 60ch; margin-top: 14px; }

/* ---------- Data engine (in -> middle -> out) ---------- */
#construction-how .engine { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center; margin-top: 44px; }
@media (max-width: 820px) { #construction-how .engine { grid-template-columns: 1fr; } }
@media (min-width: 821px) { #construction-how .engine { column-gap: 92px; } }
@media (min-width: 821px) {
  #construction-how .engine--tiered { grid-template-columns: auto auto auto 1fr; column-gap: 40px; }
  #construction-how .engine__list > li:not(.engine__out) { white-space: nowrap; }
}
#construction-how .engine__tiers { display: flex; align-items: center; gap: 12px; }
#construction-how .tier { display: flex; flex-direction: column; align-items: center; gap: 7px; }
#construction-how .tier__bar { width: 30px; height: 8px; border-radius: 3px; background: var(--indigo-soft); opacity: .5; }
#construction-how .tier__label { margin-top: 6px; font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--dark-soft); white-space: nowrap; }
#construction-how .tier__desc { margin-top: 2px; max-width: 70px; font-size: 8.5px; line-height: 1.25; text-align: center; color: var(--dark-soft); opacity: .8; }
@media (max-width: 820px) {
  #construction-how .engine__tiers { flex-direction: column; gap: 10px; margin-bottom: 6px; }
  #construction-how .tier { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 6px; }
  #construction-how .tier__label { width: 100%; text-align: center; margin-top: 2px; }
  #construction-how .tier__desc { width: 100%; max-width: none; margin-top: 0; }
  #construction-how .engine__supplier { order: -1; }
}
#construction-how .engine__flow { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
#construction-how .engine__col h3 { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--dark-soft); margin-bottom: 14px; }
#construction-how .engine__col:has(.engine__supplier) h3 { color: #f2b43c; }
#construction-how .engine__col:has(.engine__out) h3 { color: #41c98a; }
#construction-how .engine__list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; }
#construction-how .engine__list > li { display: flex; align-items: center; gap: 11px; background: var(--dark-2); border: 1px solid var(--dark-line); border-radius: 10px; padding: 12px 16px; font-size: 14.5px; }
#construction-how .engine__list > li > svg { width: 18px; height: 18px; flex: none; color: var(--indigo-soft); }
#construction-how .engine__list > li.engine__out { align-items: flex-start; }
#construction-how .engine__out > svg { margin-top: 2px; }
#construction-how .engine__out-body { display: flex; flex-direction: column; }
#construction-how .engine__out-title { font-weight: 700; font-size: 14.5px; color: var(--dark-ink); }
#construction-how .engine__out-pts { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
#construction-how .engine__out-pts li { position: relative; padding-left: 13px; font-size: 12px; line-height: 1.3; color: var(--dark-soft); }
#construction-how .engine__out-pts li::before { content: ""; position: absolute; left: 1px; top: 7px; width: 4px; height: 4px; border-radius: 50%; background: var(--indigo-soft); opacity: .7; }
#construction-how .engine__hub { text-align: center; }
#construction-how .engine__hub .core { border: 2px solid var(--indigo); border-radius: 16px; padding: 22px 18px; background: rgba(62,99,221,.12); }
#construction-how .engine__hub .core b { display: block; font-size: 18px; }
#construction-how .engine__hub .core span { font-size: 12.5px; color: var(--dark-soft); }
#construction-how .core__logo { display: none; }
@media (min-width: 821px) {
  #construction-how .engine__hub .core { min-height: 220px; display: flex; flex-direction: column; justify-content: center; transform: translateY(17px); }
}
</style>
