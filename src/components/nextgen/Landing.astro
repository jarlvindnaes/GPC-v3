---
import '../../styles/nextgen.css';
import ProductStory from './ProductStory';
import SiteHeader from '../SiteHeader.astro';
import NodeFlow from '../furniture/NodeFlow.astro';
import PcMark from '../PcMark.astro';
import ClosingCta from '../ClosingCta.astro';
import Footer from '../furniture/Footer.astro';
import SeoMeta from '../SeoMeta.astro';
import InputInterface from '../furniture/InputInterface.astro';
import ProductMemory from '../furniture/ProductMemory.astro';
import Integrations from '../furniture/Integrations.astro';
import RouteStory from './RouteStory.astro';
import CinematicHero from './CinematicHero';
import { ExplodingChair } from '../wireframe/ExplodingChair';
interface Props { enterprise?: boolean }
const { enterprise = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = base;
const enterpriseUrl = `${base}enterprise/`;
const howItWorks = `${base}how-it-works/`;
// `enterprise` renders the How it works page (it began as the Enterprise page; /enterprise/ now forwards here).
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{enterprise ? 'How it works · Product Connect' : 'Beautiful furniture. A clearer footprint · Product Connect'}</title>
<meta name="description" content={enterprise ? 'How Product Connect turns a product into connected data: map its components and suppliers, build one product model, and put it to work for calculations, passports and teams.' : 'Calculate your furniture’s carbon footprint and create Digital Product Passports from connected product data.'} />
{enterprise && <SeoMeta title="How it works · Product Connect" description="How Product Connect turns a product into connected data: map its components and suppliers, build one product model, and put it to work for calculations, passports and teams." path="how-it-works/" />}
<meta name="theme-color" content="#141816" />
<link rel="icon" href={`${base}nextgen/favicon.svg`} type="image/svg+xml" /><link rel="icon" href={`${base}favicon-dark.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" /><link rel="icon" href={`${base}favicon-light.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" /><link rel="icon" href={`${base}favicon.ico`} sizes="48x48" /><link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
<script is:inline>try{if(localStorage.getItem("pc-motion-paused")==="1")document.documentElement.classList.add("motion-paused")}catch(e){}</script>
</head>
<body class:list={{enterprise}}>
<a class="skip" href="#main">Skip to content</a>
<SiteHeader theme="dark" current={enterprise ? 'how-it-works' : undefined} />
<main id="main">
<section class="hero cinematic-hero">
{!enterprise && <div class="hero-topline"><span><i></i> PHYSICAL PRODUCTS. CONNECTED INTELLIGENCE.</span><span class="edition">PRODUCT INTELLIGENCE / MADE VISIBLE</span></div>}
<div class="hero-layout">
{enterprise && <div class="hero-chair-stage" aria-hidden="true"><span class="chair-placeholder"><img src={`${base}nextgen/hero-chair-placeholder.webp`} alt="" width="360" height="327" decoding="async" fetchpriority="high"/></span><ExplodingChair client:only="react" variant="soft" framePad={0.45} autoRotate={false} offsetX={0.26} offsetY={0.2} explodeAmount={0.15} view={[-0.4, 0.78, 1]} media="(min-width: 721px)" depthOfField={0.007} /></div>}
<div class="hero-copy"><p class="eyebrow">{enterprise ? 'HOW IT WORKS' : 'CO₂ CALCULATIONS + DIGITAL PRODUCT PASSPORTS'}</p>
<h1>{enterprise ? <>Every product.<br/><em>Taken apart.<br/>Connected.</em></> : <>Beautiful outside.<br/><em>Intelligent<br/>inside.</em></>}</h1>
<p class="hero-description">{enterprise ? 'See how Product Connect breaks a product down to its components, connects the data behind each one, and puts it to work for calculations, passports and the teams who need them.' : 'You make the furniture. We help you understand its impact · and turn your product data into a Digital Product Passport.'}</p>
{!enterprise && <div class="hero-actions"><a class="button lime" href="#contact">{enterprise ? 'Discuss your products' : 'See it with your products'} <span aria-hidden="true">↗︎</span></a><a class="text-link" href="#inside">See what’s inside <span aria-hidden="true">↓</span></a></div>}
</div>
<div class="hero-stage">
{!enterprise && <CinematicHero base={base} client:load />}
</div>
</div>
{!enterprise && <div class="hero-bottom"><span>From the smallest component to the complete story.</span><a href="#foundation">Discover the connection <span aria-hidden="true">↓</span></a></div>}
</section>
{!enterprise && <section class="connection-band" aria-label="Connected product lifecycle"><span>PRODUCT DATA, PUT TO WORK</span><div><a href="#foundation">Materials & components</a><b>→</b><a href="#how-it-works">Carbon intelligence</a><b>→</b><a href="#passport">Product passports</a><b>→</b><a href="#contact">A longer product life</a></div></section>}
<ProductStory base={base} client:visible />
{enterprise && <InputInterface />}
{enterprise && <section class="breaker" aria-labelledby="breaker-title"><span class="eyebrow">PRODUCT CONNECT</span><h2 id="breaker-title">A product expert that<br/><span>knows how the world works</span></h2></section>}
{enterprise && <RouteStory />}
<section class="intro section" id="foundation"><p class="eyebrow">{enterprise ? 'CONNECTED AT THE COMPONENT LEVEL' : 'GOOD DESIGN DESERVES GOOD DATA'}</p><div class="intro-grid"><h2>{enterprise ? <>Better connected.<br/><em>At every level.</em></> : <>Know what’s in it.<br/>Show what<br/><em>it stands for.</em></>}</h2><div><p class="large-copy">{enterprise ? 'A material, a finish or a shared component can appear in thousands of products. Its data should stay connected to all of them.' : 'Your products have a story. The materials you choose. The way they’re made. The life they can have after the first sale.'}</p><p>{enterprise ? 'Product Connect organises that knowledge at the component level, so teams can work from the same foundation across calculations, documentation and product passports.' : 'Product Connect brings that information together. Calculate the carbon footprint, understand what drives it, and share the right information through a product passport.'}</p></div></div>
<NodeFlow />
</section>
<section class="feature section" id="passport"><div class="feature-copy"><p class="eyebrow">{enterprise ? 'ACROSS THE ORGANISATION' : 'BEYOND THE FIRST SALE'}</p><h2>{enterprise ? <>One product.<br/>Many teams.<br/><em>Shared knowledge.</em></> : <>The relationship<br/>doesn’t end<br/><em>at checkout</em></>}</h2><p>{enterprise ? 'Design needs material insight. Sustainability needs traceable calculations. Operations needs reliable product information. Connect the source, so the knowledge travels with the product.' : 'A product passport makes useful information part of the product itself. A simple scan can connect its owner to the materials, the footprint and the guidance that helps it last.'}</p><a class="text-link" href={enterprise ? '#contact' : `${base}dpp/`}>{enterprise ? 'Talk through your use case' : 'Explore a sample passport'} <span>↗︎</span></a></div><div class="feature-panel">{enterprise ? <><p class="eyebrow">ONE FOUNDATION / MULTIPLE USES</p><div class="team-row"><strong>Design & engineering</strong><span>Materials + components</span></div><div class="team-row"><strong>Sustainability</strong><span>Impact + data provenance</span></div><div class="team-row"><strong>Procurement</strong><span>Suppliers + documentation</span></div><div class="team-row"><strong>Sales & aftercare</strong><span>Passports + product knowledge</span></div><div class="panel-bottom"><i></i> Connected through Product Connect</div></> : <><div class="sample-top"><span>PRODUCT IDENTITY / EXAMPLE</span><span>↗︎</span></div><h3>A story worth<br/>keeping</h3><div class="sample-material"><img src={`${base}nextgen/chair.png`} alt="Oak chair shown as a sample product" width="1536" height="1024" loading="lazy"/><span>Oak chair<br/><small>Material. Impact. Care.</small></span></div><div class="sample-links"><span>Explore materials <b>↗︎</b></span><span>Understand the footprint <b>↗︎</b></span><span>Care for your furniture <b>↗︎</b></span></div></>}</div></section>
<section class="process section" id="how-it-works"><div class="section-heading"><div><p class="eyebrow">FROM PRODUCT TO PROOF</p><h2>{enterprise ? <>A shared foundation.<br/><em>A practical starting point.</em></> : <>Start with what you make.<br/><em>Build from there.</em></>}</h2></div></div><div class="steps"><article><div class="step-top"><span>01</span></div><h3>{enterprise ? 'Map the product model' : 'Bring your product data'}</h3><p>{enterprise ? 'Start with a representative product family. Map components, suppliers and the systems that hold the information.' : 'Start with a product, its materials and its bill of materials. We help you organise what you have and identify what is missing.'}</p></article><article><div class="step-top"><span>02</span></div><h3>{enterprise ? 'Build once. Reuse.' : 'See the impact'}</h3><p>{enterprise ? 'Link shared components across variants. Keep source information and data quality visible as the model grows.' : 'Calculate the footprint from the underlying data. See which components contribute most and where better data is needed.'}</p></article><article><div class="step-top"><span>03</span></div><h3>{enterprise ? 'Make the data useful' : 'Give it a passport'}</h3><p>{enterprise ? 'Use the connected model for LCA, product passports and documentation. Expand to additional families and teams.' : 'Publish product information in a Digital Product Passport. Connect customers to materials, care and repair information.'}</p></article></div></section>
{enterprise && <div class="memory-band" id="product-memory"><ProductMemory /></div>}
{enterprise && <section class="provenance section" id="provenance"><div class="section-heading"><div><p class="eyebrow">CONFIDENCE STARTS AT THE SOURCE</p><h2>Know the number.<br/><em>Know where it came from.</em></h2></div></div><div class="provenance-grid"><p>A useful calculation needs more than a result. Keep the origin of each input visible · and distinguish supplier information from team inputs and estimates.</p><div><div class="source-row"><span>01</span><strong>Supplier-provided</strong><p>Information from the people who make the component.</p></div><div class="source-row"><span>02</span><strong>Team-authored</strong><p>Product knowledge entered by your own organisation.</p></div><div class="source-row"><span>03</span><strong>File-extracted</strong><p>Information brought in from product files and models.</p></div><div class="source-row"><span>04</span><strong>Estimated</strong><p>Background data where primary information is missing.</p></div></div></div><div class="epd-note"><strong>Building products and EPDs</strong><p>Use the product model as a foundation for environmental documentation. EPD publication and independent verification depend on the product category, programme and agreed verification process.</p></div></section>}
{enterprise && <Integrations />}
{enterprise && <section class="trust section" id="trust" aria-labelledby="trust-title"><div class="section-heading"><div><p class="eyebrow">TRUST & COMPLIANCE</p><h2 id="trust-title">Audit-ready. Portable.<br/><em>Secure by design.</em></h2></div></div><div class="trust-body"><p class="trust-lead">The reassurance procurement asks for, answered without the spreadsheet risk.</p><div class="trust-grid"><article><span>01</span><h3>Verified, not estimated</h3><p>Suppliers confirm the data for their own components, and every value keeps its source. EPDs follow the programme rules and independent verification.</p></article><article><span>02</span><h3>Keeps pace with regulation</h3><p>We maintain the methods and Product Category Rules behind your numbers. When ESPR, CBAM or EN standards change, updates roll across the catalogue instead of product by product.</p></article><article><span>03</span><h3>Your data stays yours</h3><p>Export everything at any time in open standards such as EN 15804, GS1 and did:web. An asset you own, not a dependency you rent.</p></article><article><span>04</span><h3>Secure by design</h3><p>EU-hosted and GDPR-aligned, encrypted in transit and at rest, with automated backups. Passport credentials are tamper-evident.</p></article></div></div><div class="trust-standards"><span>Standards and rules we build on</span><ul><li>EN 15804</li><li>ISO 14025</li><li>ISO 14040 / 14044</li><li>ESPR</li><li>CBAM</li><li>GS1</li></ul></div></section>}
{!enterprise && <section class="audience section"><p class="eyebrow">{enterprise ? 'SEEN HOW IT WORKS?' : 'MADE TO GROW WITH YOU'}</p><div><h2>{enterprise ? <>Now see<br/><em>what it does for you</em></> : <>Complex portfolio?<br/><em>Meet the bigger picture.</em></>}</h2><a class="button outline" href={enterprise ? `${home}#benefits` : enterpriseUrl}>{enterprise ? 'What we solve' : 'Explore enterprise'} <span>↗︎</span></a></div><p>{enterprise ? 'Less time chasing data, emission numbers you can trust, and Digital Product Passports that keep working after the sale.' : 'For larger manufacturers in furniture and building products: connect suppliers, shared components and your existing systems.'}</p></section>}
<ClosingCta id="contact" text={enterprise ? 'Bring a product family and your data challenges. Let’s explore how a connected foundation could work for your organisation.' : 'Bring one of your products. We’ll walk through its data, its footprint and what its passport could look like.'} subject={enterprise ? 'Product Connect · How it works' : 'Product Connect · Product demo'} />
</main><Footer />
</body></html>
