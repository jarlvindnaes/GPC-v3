---
// The one site header, used by every page (homepage and How it works), so menu changes happen in one
// place. Full-width bar, sticky, and it slides away on scroll-down / returns on a deliberate scroll-up
// (ported from our wireframes' NavAutoHide). `theme` matches the page: light (homepage) or dark
// (How it works). `current` marks the active link.
import PcLogoAnimated from './PcLogoAnimated.astro';

interface Props {
  theme?: 'light' | 'dark';
  current?: 'how-it-works';
}
const { theme = 'light', current } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  // on the homepage its own top (the page dives into the globe chapter from there); elsewhere straight to it
  { label: 'What we solve', href: current ? `${base}#benefits` : base, key: 'home' },
  { label: 'The product model', href: `${base}#product-model` },
  { label: 'How it works', href: `${base}how-it-works/`, key: 'how-it-works' },
];
---
<header class:list={['site-header', `is-${theme}`]} data-site-header>
  <a class="site-brand" href={base} aria-label="Product Connect home">
    <PcLogoAnimated class="site-mark" trigger="hover" />
    <span>product<br />connect</span>
  </a>
  <nav id="site-menu" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} class:list={{ active: link.key && link.key === current }} aria-current={link.key && link.key === current ? 'page' : undefined}>{link.label}</a>
    ))}
    <a class="menu-cta" href="mailto:contact@productconnect.com">Talk to sales <span aria-hidden="true">↗︎</span></a>
  </nav>
  <a class="site-cta" href="mailto:contact@productconnect.com">Talk to sales <span aria-hidden="true">↗︎</span></a>
  <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
    <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: 102px;
    /* Bar runs edge to edge; its contents keep to the page's 1240px max width (4.2% margins below). */
    padding: 0 max(4.2%, calc((100% - 1240px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: Inter, Arial, sans-serif;
    border-bottom: 1px solid var(--sh-rule);
    background: var(--sh-bg);
    color: var(--sh-ink);
    transition: transform 0.3s ease;
  }
  /* slid away on scroll-down (see script) */
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .is-light {
    --sh-bg: #ffffff; /* solid, no backdrop blur: a blur layer over the 3D canvases flickers while scrolling */
    --sh-ink: #242528;
    --sh-soft: #4a4f57;
    --sh-solid: #ffffff; /* fully opaque, for the mobile menu panel */
    --sh-hover: #5c70bf;
    --sh-rule: #e9eaec;
    --sh-accent: #7887d8;
    --sh-cta-border: #dedfe2;
    --sh-cta-bg: #fff;
  }
  .is-dark {
    --sh-bg: #101a2a;
    --sh-ink: #fff;
    --sh-soft: #a8aeaa;
    --sh-solid: #101a2a;
    --sh-hover: #fff;
    --sh-rule: #ffffff14;
    --sh-accent: #d6ef8c;
    --pc-logo-dot: #d6ef8c; /* logo dot in the lime accent on dark */
    --sh-cta-border: #68788c;
    --sh-cta-bg: transparent;
  }
  .site-header a {
    color: inherit;
    text-decoration: none;
  }
  .site-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    line-height: 0.98;
    letter-spacing: -0.7px;
    font-weight: 550;
  }
  /* Product Connect logo (PcLogo): ring in the text colour, so black on light and white on dark */
  .site-header :global(.site-mark) {
    height: 34px;
    --pc-mark-dot: var(--sh-accent);
  }
  nav {
    display: flex;
    gap: 34px;
    font-size: 14px;
    font-weight: 500;
    color: var(--sh-soft);
  }
  nav a {
    position: relative;
    padding: 12px 0;
    white-space: nowrap;
  }
  nav a:hover,
  nav a.active {
    color: var(--sh-hover);
  }
  nav a.active {
    color: var(--sh-ink);
  }
  nav a.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sh-accent);
  }
  .site-cta {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 17px;
    border: 1px solid var(--sh-cta-border);
    border-radius: 7px;
    background: var(--sh-cta-bg);
    white-space: nowrap;
  }
  .site-header a:focus-visible {
    outline: 3px solid #627de7;
    outline-offset: 5px;
  }
  @media (max-width: 1080px) {
    nav {
      gap: 18px;
      font-size: 13px;
    }
  }
  /* The burger and the in-menu "Talk to sales" exist only on narrow screens. */
  .menu-toggle,
  .menu-cta {
    display: none;
  }
  /* Narrow screens: logo + burger in the bar; the links (and Talk to sales) open in a panel below it,
     as on our main site. */
  @media (max-width: 940px) {
    .site-header {
      height: 68px;
      padding: 0 5%;
    }
    .site-brand {
      font-size: 14px;
    }
    .site-header :global(.site-mark) {
      height: 29px;
    }
    .site-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -6px;
      border: 1px solid var(--sh-cta-border);
      border-radius: 10px;
      background: var(--sh-cta-bg);
      color: var(--sh-ink);
      cursor: pointer;
    }
    .menu-toggle svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
    }
    .menu-toggle .icon-close,
    .is-menu-open .menu-toggle .icon-open {
      display: none;
    }
    .is-menu-open .menu-toggle .icon-close {
      display: block;
    }
    .menu-toggle:focus-visible {
      outline: 3px solid #627de7;
      outline-offset: 3px;
    }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 6px 5% 22px;
      background: var(--sh-solid);
      border-bottom: 1px solid var(--sh-rule);
      box-shadow: 0 18px 40px #0b14241f;
      font-size: 18px;
      color: var(--sh-ink);
    }
    .is-menu-open nav {
      display: flex;
    }
    nav a {
      padding: 15px 0 15px 16px;
      border-bottom: 1px solid var(--sh-rule);
    }
    /* Current page / section: the accent dot sits before the label. */
    nav a.active::after {
      left: 0;
      top: 50%;
      bottom: auto;
      width: 6px;
      height: 6px;
      transform: translateY(-50%);
    }
    nav .menu-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 18px;
      padding: 15px;
      border: 1px solid var(--sh-cta-border);
      border-radius: 10px;
      background: var(--sh-ink);
      color: var(--sh-solid);
      font-size: 16px;
      font-weight: 550;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  // iOS Safari colours the area under its floating toolbar from a solid fixed element on the bottom edge, and follows
  // it as its background colour changes (at least 12px tall); it ignores sticky elements (our pinned stories),
  // theme-color, the page background, hidden fixed elements and thinner strips (tested on an iPhone, see
  // IOS_SCROLLING_BEHAVIOR.md). So on touch screens, while a story fills the bottom of the screen, a 12px solid
  // band in the colour currently at the bottom of the screen sits on the bottom edge, with a 72px fade into that colour
  // above it (not on the How it works product story, whose chart runs close to the bottom). Both are removed
  // elsewhere, so the page flows under the toolbar as usual. Removing the band alone leaves Safari's toolbar solid in
  // its last colour, so after a story the band is handed over: it follows whatever colour is now at its edge and is
  // removed once that colour has held for 300ms; if the colour then changes again (slowly scrolling on into the next
  // section), it shows once more in the new colour. That ends when it has been removed over plain page content (not a
  // story); Safari then lets the page flow under the toolbar again.
  if (matchMedia("(hover: none) and (pointer: coarse)").matches) {
    // the pinned stories, and the footer (its own colour under the toolbar at the end of the page)
    const STORIES = ".chapters, [data-model-story], [data-route-story], .product-story, .site-footer";
    // only fully opaque colours count (not cards and overlays that let the story show through)
    const solid = (c: string) => c !== "transparent" && !/^rgba\(/.test(c);
    // the colour at y (the benefits story's colour strip, .story-under, takes no pointer hits; otherwise the first solid
    // background under that point), and the story (if any) the point is in
    const colourAt = (y: number, edge: "top" | "bottom" = "bottom"): [string, HTMLElement | null] => {
      const under = document.querySelector<HTMLElement>(".story-under");
      if (under) {
        const r = under.getBoundingClientRect();
        if (r.top <= y && r.bottom >= y && solid(under.style.backgroundColor)) return [under.style.backgroundColor, under.closest<HTMLElement>(STORIES)];
      }
      const hit = document.elementFromPoint(window.innerWidth / 2, y);
      const story = hit?.closest<HTMLElement>(STORIES) ?? null;
      // the sphere story: the sphere's own colour at the bottom of its canvas (set by data-scenes.ts)
      const sphere = story?.querySelector<HTMLElement>("canvas[data-bottom-colour]");
      if (edge === "bottom" && sphere?.dataset.bottomColour) return [sphere.dataset.bottomColour, story];
      for (let el = hit; el; el = el.parentElement) {
        const c = getComputedStyle(el).backgroundColor;
        if (solid(c)) return [c, story];
      }
      return ["", null];
    };
    const layer = (css: string) => {
      const el = document.createElement("div");
      el.setAttribute("aria-hidden", "true");
      el.style.cssText = `position:fixed;left:0;right:0;pointer-events:none;display:none;${css}`;
      document.body.append(el);
      return el;
    };
    // at z-index 1 both pass under the menus (site header 60, story tab row 15) and the stories' text, dots and totals
    // (2), and over their globes and canvases
    const BAND = "12px"; // Safari follows 12px; 2px and 8px are too thin
    const band = layer(`bottom:0;height:${BAND};z-index:1`);
    // the fade blends in over 72px, then stays solid down to the band over the gap between the story's pinned panel and
    // the bottom of the screen (the panels end 10px above the bottom of the smaller screen, so with the toolbar shrunk
    // their section shows below them); that gap is measured as you scroll, so no more is covered than needed
    const fade = layer(`bottom:${BAND};height:72px;z-index:1`);
    const PANELS = "[data-story-stage], .model-pin, .route-pin";
    // the same trick at the top: a 12px band on the top edge in the story's colour, for the status bar area (above
    // everything, so it is never hidden)
    const topBand = layer(`top:0;height:${BAND};z-index:2147483000`);
    let shownTop = "";
    // the band's height, measured on a plain (not fixed) invisible element, as the band itself is removed while off
    const probe = document.createElement("div");
    probe.setAttribute("aria-hidden", "true");
    probe.style.cssText = `position:absolute;top:0;left:0;width:0;height:calc(${BAND} + 72px);visibility:hidden;pointer-events:none`;
    document.body.append(probe);
    let queued = 0;
    let shown = "";
    // the handover after a story (see above), for one band: call with on (a story is there) or the colour now at its
    // edge and whether that point is in a story
    const handover = (el: HTMLElement) => {
      let pending = false; // a story was shown and the handover has not finished over plain page content
      let colour = "";
      let timer = 0;
      return (on: boolean, c: string, inStory: boolean) => {
        if (on) {
          window.clearTimeout(timer);
          el.style.display = "block";
          pending = true;
          colour = "";
          return;
        }
        if (!pending || !c || c === colour) return;
        colour = c;
        el.style.backgroundColor = c;
        el.style.display = "block";
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          el.style.display = "none";
          if (!inStory) pending = false;
        }, 300);
      };
    };
    const bandHandover = handover(band);
    const topHandover = handover(topBand);
    const update = () => {
      queued = 0;
      // the full-screen passport overlay is open: it covers the screen edges itself, so Safari should take its colours
      // from it, not from a band underneath (back on when it closes)
      if (document.documentElement.dataset.overlayOpen) {
        band.style.display = fade.style.display = topBand.style.display = "none";
        return;
      }
      const [c, story] = colourAt(window.innerHeight - 4);
      let on = Boolean(story && c);
      if (on) {
        // only once the story's top is 80px clear of where the fade starts (so never over the section or the menu
        // above the story while it scrolls in)
        const box = story!.getBoundingClientRect();
        // (only where there is a fade: the product story gets the band as soon as it reaches the bottom; the footer only
        // over the last 80px of the page, so until then it shows through the toolbar like the rest of the page, and at
        // the very end the toolbar takes the footer's colour instead of turning white)
        const end = document.documentElement.scrollHeight - window.innerHeight - window.scrollY <= 80;
        on = story!.matches(".site-footer") ? end : story!.matches(".product-story") || box.top + 80 <= window.innerHeight - probe.offsetHeight;
        const panel = story!.querySelector<HTMLElement>(PANELS);
        const gap = panel ? Math.max(0, window.innerHeight - panel.getBoundingClientRect().bottom - parseFloat(BAND)) : 0;
        fade.style.height = `${72 + Math.round(gap)}px`;
        // the fade eases out as the story's end comes up (the band stays solid: it is what Safari takes its colour from)
        fade.style.opacity = String(Math.min(1, Math.max(0, (box.bottom - window.innerHeight) / (window.innerHeight * 0.25))));
      }
      bandHandover(on, c, Boolean(story));
      if (!on) shown = "";
      const [top, topStory] = colourAt(parseFloat(BAND) + 2, "top");
      // In the benefits story (.chapters) its chapter tab row sits at the top, in the stage's own colour (its bar,
      // .benefit-nav::before, set by the story script as the chapters change), so there the band takes the tab row's
      // colour: unseen over it, and still handed over when you leave the story (which Safari needs at the top edge too,
      // or the page no longer flows under its toolbar). Decided by the story filling the screen, so it never flickers
      // between the tab row and the story behind it.
      const benefits = Boolean(story?.matches(".chapters"));
      const tabs = benefits ? document.querySelector<HTMLElement>(".benefit-nav") : null;
      const tabColour = tabs ? getComputedStyle(tabs, "::before").backgroundColor : "";
      const topColour = benefits ? (solid(tabColour) ? tabColour : "rgb(255, 255, 255)") : top;
      const topOn = on && Boolean(topColour) && (benefits || !topStory?.matches(".chapters"));
      topHandover(topOn, topColour, Boolean(topStory));
      if (!topOn) shownTop = "";
      if (topOn) {
        if (topColour !== shownTop) {
          shownTop = topColour;
          topBand.style.backgroundColor = topColour;
        }
      }
      // no fade on the How it works product story (its chart runs close to the bottom) or the footer (its last row does)
      fade.style.display = on && !story!.matches(".product-story, .site-footer") ? "block" : "none";
      if (!on || c === shown) return;
      shown = c;
      band.style.backgroundColor = c;
      fade.style.background = `linear-gradient(to bottom, ${c.replace("rgb(", "rgba(").replace(")", ", 0)")}, ${c} 72px)`;
    };
    const queue = () => {
      if (!queued) queued = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    new MutationObserver(() => {
      if (!document.documentElement.dataset.overlayOpen) shown = shownTop = ""; // repaint the bands on close
      queue();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-overlay-open"] });
    update();
  }
</script>
<script>
  // Hide on scroll-down, reveal on a deliberate scroll-up; always shown near the top.
  // (Same thresholds as our wireframes' NavAutoHide.)
  for (const header of document.querySelectorAll<HTMLElement>('[data-site-header]')) {
    let lastY = window.scrollY;
    let anchor = window.scrollY;
    let direction: 'up' | 'down' = 'down';
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      const next = y > lastY ? 'down' : 'up';
      if (next !== direction) {
        anchor = y;
        direction = next;
      }
      if (y <= 64) {
        header.classList.remove('is-hidden');
      } else if (next === 'down' && y - anchor > 10 && !header.classList.contains('is-menu-open')) {
        header.classList.add('is-hidden');
      } else if (next === 'up' && anchor - y > 40) {
        header.classList.remove('is-hidden');
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    // Keyboard users tabbing into the menu always get it back.
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));

    // Burger menu (narrow screens): opens the links in a panel under the bar.
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const setMenu = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // the links sit before the toggle in the markup, so opening hands focus to the first one
      if (open) header.querySelector<HTMLElement>('#site-menu a')?.focus();
    };
    toggle?.addEventListener('click', () => setMenu(!header.classList.contains('is-menu-open')));
    header.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-menu-open')) {
        setMenu(false);
        toggle?.focus();
      }
    });
    window.matchMedia('(min-width: 941px)').addEventListener('change', (event) => {
      if (event.matches) {
        setMenu(false);
      }
    });

    // Active dot on this page: links to sections of the current page (e.g. #benefits on the homepage)
    // get the dot while that section is being read. A link to the page itself (How it works) keeps
    // its fixed `active` from the server.
    const here = window.location.pathname;
    const links = [...header.querySelectorAll<HTMLAnchorElement>('nav a:not(.menu-cta)')];
    // A link to this page's top (What we solve → homepage): jump up instead of reloading,
    // and it holds the dot from the top until another section's link takes over.
    const topLink = links.find((link) => {
      const url = new URL(link.href, window.location.href);
      return url.pathname === here && !url.hash;
    });
    // (the page may take the click over: the homepage dives into its first story chapter instead)
    topLink?.addEventListener('click', (event) => {
      event.preventDefault();
      if (window.dispatchEvent(new Event('site:top-link', { cancelable: true }))) {
        window.scrollTo({ top: 0, behavior: 'instant' });
      }
    });
    const spied = links
      .map((link) => {
        const url = new URL(link.href, window.location.href);
        const target = url.pathname === here && url.hash ? document.getElementById(url.hash.slice(1)) : null;
        return target ? { link, target } : null;
      })
      .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => item !== null);
    if (spied.length || topLink) {
      let spyTicking = false;
      const spy = () => {
        spyTicking = false;
        const line = window.innerHeight * 0.4;
        let current: HTMLAnchorElement | null = null;
        for (const { link, target } of spied) {
          const r = target.getBoundingClientRect();
          if (r.top <= line && r.bottom > line) {
            current = link;
          }
        }
        // The top link owns everything above the first linked section.
        const firstTop = Math.min(...spied.map(({ target }) => target.getBoundingClientRect().top));
        if (!current && topLink && firstTop > line) {
          current = topLink;
        }
        for (const link of [...spied.map((item) => item.link), ...(topLink ? [topLink] : [])]) {
          const on = link === current;
          link.classList.toggle('active', on);
          if (on) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!spyTicking) {
            spyTicking = true;
            requestAnimationFrame(spy);
          }
        },
        { passive: true },
      );
      spy();
    }
  }
</script>
