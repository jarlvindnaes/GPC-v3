---
// The closing call to action, shared by the homepage and How it works: "Your products. Let's connect the dots.",
// on the site's near-black, with the soft glow and faint dot grid of the dark sections.
import ArrowIcon from './ArrowIcon.astro';
import ParticleOrb from './ParticleOrb.astro';

interface Props {
  id?: string;
  text: string;
  subject: string; // the email's subject line
}
const { id, text, subject } = Astro.props;
---
<section class="closing-cta" id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <p class="closing-cta-eyebrow">Let’s make it concrete</p>
  <h2 id={id ? `${id}-title` : undefined}>Your products.<br/><em>Let’s connect the dots.</em></h2>
  <div class="closing-cta-bottom">
    <p>{text}</p>
    <div class="closing-cta-action">
      <ParticleOrb />
      <a class="closing-cta-button" href={`mailto:contact@productconnect.com?subject=${encodeURIComponent(subject)}`}>Let’s start a conversation <ArrowIcon /></a>
    </div>
  </div>
  <p class="closing-cta-email"><a href={`mailto:contact@productconnect.com?subject=${encodeURIComponent(subject)}`}>contact@productconnect.com</a></p>
</section>
<style>
  .closing-cta{position:relative;isolation:isolate;overflow:hidden;padding:112px max(7%, calc((100% - 1240px) / 2));background:radial-gradient(ellipse 50% 70% at 78% 40%,#2a3634a6 0%,#141c2266 45%,transparent 72%),#0a1017;color:#f5f6f0;font-family:Inter,Arial,sans-serif}
  /* a faint dot grid fading out to the right, and a hairline of light along the top */
  .closing-cta::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:radial-gradient(#ffffff1a 1px,transparent 1.6px);background-size:28px 28px;-webkit-mask-image:radial-gradient(ellipse 60% 80% at 30% 50%,#000 10%,transparent 70%);mask-image:radial-gradient(ellipse 60% 80% at 30% 50%,#000 10%,transparent 70%)}
  .closing-cta::after{content:"";position:absolute;left:0;right:0;top:0;height:1px;pointer-events:none;background:linear-gradient(90deg,transparent,#d6ef8c73 35%,#8fb3ff59 65%,transparent)}
  .closing-cta-eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 28px;padding:8px 14px 8px 12px;border:1px solid #ffffff24;border-radius:999px;background:#ffffff0a;backdrop-filter:blur(8px);font:500 11px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;color:#c3cad3}
  .closing-cta-eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:#d6ef8c;box-shadow:0 0 10px #d6ef8c99}
  .closing-cta h2{margin:0;font-size:clamp(44px,5.2vw,72px);font-weight:480;line-height:1.07;letter-spacing:-.05em;color:#f7f8f4}
  /* (font: inherit throughout, as the pages' own em styles differ) */
  .closing-cta h2 em{display:inline;margin:0;font:inherit;font-style:normal;letter-spacing:inherit;text-transform:none;color:#7f8893}
  .closing-cta-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-top:40px}
  /* the orb above the button, pulled up beside the headline */
  .closing-cta-action{display:flex;flex-direction:column;align-items:center;gap:22px;flex:none;width:min(420px,100%);margin-top:-344px}
  .closing-cta-action :global(.particle-orb){margin-bottom:50px} /* (the orb 50px higher than the button's top) */
  .closing-cta-bottom>p{max-width:465px;margin:16px 0;font-size:16px;line-height:1.75;color:#b4bcc6}
  /* the page's main call to action: larger than the other buttons, in the hero's light primary style */
  .closing-cta-button{display:flex;align-items:center;gap:30px;flex:none;padding:18px 23px;border:1px solid #f7f7f2;border-radius:7px;background:#f7f7f2;color:#15181c;font-size:14px;font-weight:600;text-decoration:none;box-shadow:0 10px 30px #0006;transition:transform .2s,background .2s}
  .closing-cta-button:hover{background:#fff;transform:translateY(-2px)}
  @media(prefers-reduced-motion:reduce){.closing-cta-button{transition:none}.closing-cta-button:hover{transform:none}}
  .closing-cta-button:focus-visible{outline:2px solid #d6ef8c;outline-offset:3px}
  .closing-cta-email{margin:25px 0 0;font-size:12px;color:#8a93a0}
  .closing-cta-email a{color:inherit;text-decoration:none}
  .closing-cta-email a:hover{color:#f5f6f0;text-decoration:underline;text-underline-offset:3px}
  .closing-cta-email a:focus-visible{outline:2px solid #d6ef8c;outline-offset:3px;border-radius:2px}
  /* content keeps to the site's 1240px width on wide screens (padding: its own, or the content edge if larger) */
  @media(max-width:1000px){.closing-cta{padding:80px 6%}}
  @media(max-width:700px){
    .closing-cta{padding:65px 6%}
    .closing-cta h2{font-size:49px}
    .closing-cta-bottom{flex-direction:column;align-items:flex-start;gap:15px;margin-top:20px}
    .closing-cta-action{align-self:stretch;margin-top:12px}
    .closing-cta-bottom>p{font-size:15px;margin:15px 0}
    .closing-cta-button{gap:18px;padding:16px 18px;font-size:12px}
  }
</style>
