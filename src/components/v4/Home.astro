---
import './home.css';
import NodeFlow from './NodeFlow.astro';
import Footer from './Footer.astro';
import Scale from './Scale.astro';
import McpGraphic from './McpGraphic.astro';
import BenefitProof from './BenefitProof.astro';
import BrandStrip from './BrandStrip.astro';
const base = import.meta.env.BASE_URL;
const contact = 'mailto:hello@getproductconnect.com';
const benefits = [
 {id:'save-time',label:'Save time',title:'Less data chasing.',lead:'Your team’s time, back.',text:'Gather thousands of data points from across your supply chain, effortlessly. Give your team back the time to turn that knowledge into real improvements.'},
 {id:'spot-opportunities',label:'Spot opportunities',title:'Know where to focus.',lead:'Make every improvement count.',text:'Turn millions of product and impact data points into clear priorities. See what matters most, where to focus, and which changes can make the biggest difference.'},
 {id:'improve-products',label:'Improve products',title:'From product data to proof.',lead:'A faster path to environmental reporting.',text:'Once your data is captured and processed, get an environmental overview in minutes. Turn insights into better product choices and prepare EPD documentation for furniture, product series and components—with EN 15804+A2 and applicable product category rules guiding the reporting process.'},
 {id:'prove-progress',label:'Prove progress',title:'Lead the change.',lead:'Show the progress.',text:'Give your ESG team the data to drive improvements—and the evidence to bring the company with you. Track what’s changing, measure the results, and make progress clear to everyone, from design teams to the boardroom.'},
 {id:'connect-customers',label:'Connect with customers',title:'A webshop built in every product.',lead:'Create a new sales infrastructure across your entire portfolio.',text:'Connect with product owners, sell spare parts, accessories, and services. Turn sold products into new revenue opportunities.'}
];
const capabilities = [
 ['Every change, traceable.','A complete ledger of inputs, with timestamped field history. Know what changed, when, and where the data came from.'],
 ['Data in every dimension.','3D models, materials, components, and specifications—connected in one scalable data foundation.'],
 ['Your supply chain, mapped.','Suppliers, components, and their relationships. Trace how every part connects to the finished product.'],
 ['Impact built into the model.','Impact calculations connected directly to your product data, alongside emissions and scores.'],
 ['Built to connect.','MCP access makes your product model available to AI tools and agents, with the context they need to work.']
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Make the best product, show the world. — Product Connect</title><meta name="description" content="Product Connect crunches all your product data—see what drives impact, measure improvements, and show the evidence in Digital Product Passports."/><link rel="icon" href={`${base}nextgen/favicon.svg`}/><link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="theme-color" content="#ffffff"/><style is:inline set:html={`@font-face{font-family:Inter;src:url("${base}fonts/inter-latin.woff2") format("woff2");font-display:swap;font-weight:100 900}`} /></head>
<body><a class="skip" href="#main">Skip to content</a>
<header class="header"><a class="brand" href={base}><span class="mark">p<span>c</span></span>Product Connect</a><nav aria-label="Main navigation"><a href="#benefits">Platform</a><a href={`${base}how-it-works/`}>How it works</a><a href={`${base}pricing/`}>Pricing</a></nav><a class="button small" href={contact}>Talk to sales <span>↗</span></a></header>
<main id="main"><section class="hero frame"><div class="hero-copy hero-chair"><img class="hero-backdrop" src={`${base}v4/exploded-chair-backdrop.webp`} alt="" width="1672" height="941" fetchpriority="high"/><div class="hero-editorial"><span class="eyebrow"><i></i> PRODUCT CONNECT</span><h1><span>Make the best product,</span><span>show the world.</span></h1><p>Product Connect crunches all your product data - see what drives impact, measure improvements, and show the evidence in our next generation <strong>Digital Product Passports.</strong></p><div class="actions"><a class="button" href={contact}>Talk to sales</a><a class="button primary" href={`${base}pricing/`}>Start for free <span>↗</span></a></div></div><button class="chair-passport-trigger" type="button" aria-haspopup="dialog" aria-controls="chair-passport"><span aria-hidden="true">▦</span><span>Explore its passport ↗</span></button></div>
<dialog id="chair-passport" class="chair-passport-dialog" aria-label="Interactive Digital Product Passport"><div class="passport-dialog-top"><span>Digital Product Passport · Demo</span><button type="button" class="passport-expand" aria-label="Expand phone">⤢</button><button type="button" class="passport-close" aria-label="Close passport">×</button></div><div class="passport-embed-shell"><iframe data-src={`${base}passport-preview/`} title="Interactive product passport with product information, care, impact and spare parts" width="375" height="812"></iframe></div><p class="passport-demo-note">Illustrative product passport · Webshop coming this fall</p></dialog>
<div class="hero-visual"><div class="window"><div class="window-bar"><span class="dots">● ● ●</span><span>Product Connect / Supply chain</span><span class="live">● Connected</span></div><img src={`${base}v4/globe-screenshot.webp`} width="1024" height="648" loading="lazy" alt="Product Connect supply chain globe showing connected suppliers and transport routes"/></div><div class="float-note"><span class="check">✓</span><div>One product. All the knowledge.<small>Materials · Suppliers · Impact · Passport</small></div></div></div></section>
<BrandStrip />
<section id="benefits" class="benefits frame"><div class="section-intro"><span class="tag">Platform</span><h2>Your next product expert. Always on.<br/><span>Gathers your data. Finds your next improvement.<br/>Helps you prove progress and turn products into new sales.</span></h2></div><div class="benefit-layout"><aside class="benefit-nav"><nav aria-label="Product benefits">{benefits.map((b,i)=><a href={`#${b.id}`} data-benefit-link={b.id} aria-current={i===0?'location':undefined}><span class="nav-number">0{i+1}</span>{b.label}<span class="nav-arrow">↗</span></a>)}</nav><p>From product data<br/>to what comes next.</p></aside><div class="chapters">{benefits.map((b,i)=><section id={b.id} class="chapter" data-chapter><div class="chapter-heading"><span class="chapter-number">0{i+1} / 05</span>{i===4&&<span class="coming">Coming this fall</span>}<h3>{b.title} <span>{b.lead}</span></h3><p>{b.text}</p>{i===2&&<small class="epd-process-note">EPD publication follows the applicable programme rules and independent verification.</small>}</div>
<div class:list={['ui-stage',`stage-${i}`]}>
{i===0&&<div class="screen-card"><div class="ui-bar"><span>◈ Supply chain</span><span class="pill">Connected data</span></div><img src={`${base}v4/supply-chain.webp`} width="956" height="544" loading="lazy" decoding="async" alt="Product Connect supply chain interface, connecting suppliers and component data"/><div class="ui-footer"><span class="check">✓</span> Supplier and component data, together.</div></div>}
{i===1&&<div class="screen-card dashboard"><div class="ui-bar"><span>◈ Portfolio overview</span><span class="pill">Illustrative data</span></div><div class="dashboard-body"><div class="metric"><small>Product carbon footprint</small><strong>24.8 <em>kg CO₂e</em></strong><span>Cross Chair / Oak</span></div><div class="chart-title">Where the impact comes from</div>{[['Materials',72,'17.9'],['Manufacturing',17,'4.2'],['Transport',8,'2.0'],['Packaging',3,'0.7']].map(([label,value,total])=><div class="bar-row"><span>{label}</span><div class="bar-track"><i style={`width:${value}%`}></i></div><b>{total}</b></div>)}<div class="insight"><span>↗</span><div><strong>Start with materials</strong><p>Explore the components behind your product’s footprint.</p></div></div></div></div>}
{i===2&&<div class="screen-card compare"><div class="ui-bar"><span>◈ Compare components</span><span class="pill">Illustrative scenario</span></div><div class="compare-body"><div class="product-thumb"><img src={`${base}v4/chair.webp`} width="640" height="427" alt="Oak chair used in the product comparison" loading="lazy"/><span>Cross Chair<small>Material comparison</small></span></div><div class="compare-grid"><div><small>Current material</small><h4>Oak / baseline</h4><strong>17.9 <em>kg CO₂e</em></strong><div class="compare-line"></div></div><div class="selected"><small>Alternative material</small><h4>Oak / scenario</h4><strong>14.2 <em>kg CO₂e</em></strong><div class="compare-line shorter"></div></div></div><div class="ui-footer">Materials <span>→</span> Components <span>→</span> Better decisions</div></div></div>}
{i===3&&<div class="screen-card report"><div class="ui-bar"><span>◈ Product progress</span><span class="pill">Illustrative data</span></div><div class="report-body"><span class="report-label">CROSS CHAIR / MATERIAL SCENARIO</span><h4>A clearer picture<br/>of your progress.</h4><div class="progress-metrics"><div><small>Baseline</small><strong>24.8</strong></div><span>→</span><div><small>Updated scenario</small><strong>21.1</strong></div><span class="delta">−15%</span></div><small>kg CO₂e per product · illustrative comparison</small><div class="record"><span class="check">✓</span><span>Component changes documented</span></div><div class="record"><span class="check">✓</span><span>Source information connected</span></div><div class="record"><span class="check">✓</span><span>Product and portfolio evidence</span></div></div></div>}
{i===4&&<div class="passport-composition"><div class="passport-copy"><span class="tag">Digital Product Passport</span><h4>The next chapter<br/>starts here.</h4><a href={`${base}dpp/`}>Explore the passport <span>↗</span></a></div><div class="phone"><div class="phone-top">Product Connect <span>◈</span></div><img src={`${base}v4/chair.webp`} width="640" height="427" alt="Chair in its Digital Product Passport" loading="lazy"/><div class="phone-body"><small>YOUR PRODUCT</small><h4>Cross Chair</h4><p>Made to stay with you.</p><div>Materials & impact <span>↗</span></div><div>Care & repair <span>↗</span></div><div>Spare parts <span>↗</span></div><span class="coming">Shop · Coming this fall</span></div></div></div>}
</div><BenefitProof index={i} /><div class="chapter-caption">{i===0?<><strong>Free your team to make improvements.</strong><span>Agents handle the research and busywork.</span></>:i===4?<><strong>Build a new revenue stream.</strong><span>Sell spare parts, accessories and new products direct to consumer using your digital passport’s built-in webshop features.</span></>:<><strong>{b.label}.</strong><span>Connected through your product model.</span></>}</div></section>)}</div></div></section>
<section class="getting-started frame"><NodeFlow /><div class="time-value-copy"><span class="tag">Self-building</span><h2>Live from day one. <span>Bring your data. Map your supply chain, uncover insights, and publish your first Digital Product Passports — all on day one.</span></h2><a class="button" href={`${base}how-it-works/`}>See how it works <span>↗</span></a></div></section>
<section class="model" id="product-model"><div class="model-inner frame"><div class="model-atmosphere"><div class="model-title"><p>A new way to understand your products.</p><h2>Dynamic Product Model</h2></div><div class="model-horizon data-sphere" role="img" aria-label="Data rains onto a spherical product model, connecting information across its surface"><canvas data-scene="sphere" aria-hidden="true"></canvas></div></div><div class="capabilities">{capabilities.map(([title,text],i)=><article><span class="cap-icon">{['▤','◎','◈','⌁','⌘'][i]}</span><h3>{title}</h3><p>{text}</p></article>)}</div><div class="signals"><div><span class="tag">Signals</span><h2>Scattered data.<br/>Connected knowledge.<br/><span>Better decisions.</span></h2><a class="button dark-button" href={`${base}platform/`}>See more <span>↗</span></a></div><div class="signal-map data-vortex" role="img" aria-label="Incoming product data passes through our Input interface and converges at the Dynamic Product Model"><canvas data-scene="lens" aria-hidden="true"></canvas></div></div><div class="api api-reference"><div class="api-copy"><h2>API. MCP.<br/><span>Connect to Product Connect.</span></h2><a class="button dark-button" href={`${contact}?subject=Product%20Connect%20API%20and%20MCP`}>Explore integrations <span>↗</span></a></div><McpGraphic /></div></div></section>
<section class="customer-story frame" aria-label="Customer testimonial preview"><span class="tag">Testimonial · copy to be confirmed</span><blockquote>“A clearer picture of every product.<br/><span>A better foundation for what comes next.”</span></blockquote><img class="quote-portrait" src={`${base}v4/testimonial-portrait.webp`} alt="Fictional bearded man, placeholder portrait" width="80" height="80" loading="lazy"/><p class="quote-attribution">Mikkel Sørensen<small>Head of Design · Fjordform Studio, Denmark</small></p><p class="quote-note">Fictional testimonial, person and company for design preview.</p></section>
<Scale />
<section class="enterprise-invite frame"><p class="eyebrow">MADE TO GROW WITH YOU</p><div><h2>Complex portfolio?<br/><span>Meet the bigger picture.</span></h2><a class="button" href={`${base}enterprise/`}>Explore enterprise <span>↗</span></a></div><p>For larger manufacturers in furniture and building products: connect suppliers,<br/> shared components and your existing systems.</p></section>
<section class="closing frame"><span class="eyebrow">PRODUCT CONNECT</span><h2>Your products have more potential.<br/><span>Put it to work.</span></h2><div class="actions"><a class="button" href={contact}>Talk to sales</a><a class="button primary" href={`${base}pricing/`}>Start for free <span>↗</span></a></div></section></main><Footer />
<script>
import { initDataScenes } from "./data-scenes";
const disposeScenes = initDataScenes();
document.addEventListener("astro:before-swap", disposeScenes, { once: true });
const passportDialog=document.querySelector<HTMLDialogElement>('#chair-passport')!;
const passportTrigger=document.querySelector<HTMLButtonElement>('.chair-passport-trigger')!;
passportTrigger.addEventListener('click',()=>{
 const frame=passportDialog.querySelector<HTMLIFrameElement>('iframe')!;
 if(!frame.hasAttribute('src'))frame.src=frame.dataset.src!;
 passportDialog.show();
});
passportDialog.querySelector('.passport-expand')?.addEventListener('click',()=>{passportDialog.close();passportDialog.showModal();});
passportDialog.querySelector('.passport-close')?.addEventListener('click',()=>passportDialog.close());
passportDialog.addEventListener('click',e=>{if(e.target===passportDialog){const r=passportDialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)passportDialog.close();}});
passportDialog.addEventListener('close',()=>passportTrigger.focus({preventScroll:true}));
const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-benefit-link]'));
const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
let pending = false;
function updateActive() {
 const line = Math.min(window.innerHeight * .38, 300);
 let active = chapters[0];
 for (const chapter of chapters) { if (chapter.getBoundingClientRect().top <= line) active = chapter; }
 for (const link of links) { if (link.dataset.benefitLink === active?.id) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); }
 pending = false;
}
window.addEventListener('scroll', () => { if (!pending) { pending = true; requestAnimationFrame(updateActive); } }, {passive:true});
window.addEventListener('resize', updateActive);
updateActive();
</script></body></html>
