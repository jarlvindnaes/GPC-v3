---
const {index} = Astro.props;
const stories = [
 {name:'Sofie Lind',role:'Supply Chain Manager',initials:'SL',quote:'I want our team spending less time chasing supplier files and more time doing something useful with the data.',proof:'Time returned to the team',measure:'Hours spent gathering data before and after onboarding.'},
 {name:'Anders Holm',role:'Sustainability Lead',initials:'AH',quote:'The useful part is knowing where to start. Which material, which supplier, which change will actually move the needle?',proof:'Impact hotspots identified',measure:'Share of the product footprint traced to priority components.'},
 {name:'Mikkel Sørensen',role:'Head of Design',initials:'MS',quote:'We need to understand the trade-offs while we’re designing, then carry that same evidence through to the report.',proof:'From data to documentation',measure:'Time to prepare a report, with verification tracked separately.'},
 {name:'Frederikke Møller',role:'ESG Manager',initials:'FM',quote:'I want to walk into a meeting with a clear answer: here’s what we changed, here’s the result, and here’s what we do next.',proof:'Progress the company can see',measure:'Change against a documented baseline, linked to source data.'},
 {name:'Jonas Berg',role:'Aftercare Director',initials:'JB',quote:'When someone needs a spare part, I want them to find the right one straight from the product they already own.',proof:'A connection beyond the sale',measure:'Passport engagement and spare-part conversion after launch this fall.'}
];
const story=stories[index];
---
<aside class="benefit-proof" aria-label={`${story.role} perspective, illustrative draft`}>
 <div class="proof-voice"><span class="proof-status">Illustrative persona · draft quote</span><blockquote>“{story.quote}”</blockquote><div class="proof-person"><span class="proof-avatar" aria-hidden="true">{story.initials}</span><div><strong>{story.name}</strong><small>{story.role} · fictional persona</small></div></div></div>
 <div class="proof-evidence"><span class="proof-status">Evidence to validate</span><h4>{story.proof}</h4><p>{story.measure}</p><small>Customer result pending</small></div>
</aside>
<style>
.benefit-proof{display:grid;grid-template-columns:1.5fr 1fr;gap:28px;padding:28px 36px;background:#fff;border-top:1px solid #e7eaf0}.proof-status{font:10px Inter,Arial,sans-serif;letter-spacing:.04em;color:#8b93a2}.proof-voice blockquote{font:400 18px/1.45 Georgia,serif;letter-spacing:-.015em;color:#424a56;margin:12px 0 18px}.proof-person{display:flex;align-items:center;gap:10px}.proof-avatar{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#eef1f8;color:#7b8bae;font:11px Inter,sans-serif;flex-shrink:0}.proof-person strong{font-size:11px;font-weight:500}.proof-person small{display:block;font-size:10px;color:#959baa;margin-top:3px}.proof-evidence{border-left:1px solid #e1e6ef;padding-left:24px;align-self:center}.proof-evidence h4{font-size:15px;line-height:1.3;letter-spacing:-.02em;margin:12px 0 8px}.proof-evidence p{font-size:12px;line-height:1.5;color:#7f8795}.proof-evidence>small{display:block;font-size:10px;color:#9ba1ad;margin-top:12px}@media(max-width:720px){.benefit-proof{grid-template-columns:1fr;padding:24px;gap:20px}.proof-evidence{padding-left:16px}.proof-voice blockquote{font-size:17px}}
</style>
