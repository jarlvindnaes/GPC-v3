---
const curve = (x:number) => 590 - 570 * (x/1200)**2.35;
const points = Array.from({length:121},(_,i)=>`${i===0?'M':'L'}${i*10},${curve(i*10)}`).join(' ');
---
<section class="scale-section frame" aria-labelledby="scale-title">
 <svg viewBox="0 0 1200 650" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="scale-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#718de4" stop-opacity=".12"/><stop offset="1" stop-color="#718de4" stop-opacity="0"/></linearGradient></defs><g class="scale-reveal"><path d={`${points} L1200,650 L0,650 Z`} fill="url(#scale-fill)"/>{Array.from({length:101},(_,i)=><line x1={i*12} x2={i*12} y1={curve(i*12)} y2="650" stroke="#dce2ee" stroke-width=".7"/>)}<path class="scale-line" d={points} fill="none" stroke="#7089d9" stroke-width="2" vector-effect="non-scaling-stroke"/><circle class="scale-spark" r="4" fill="#7089d9"><animateMotion dur="7s" repeatCount="indefinite" path={points}/></circle></g></svg>
 <div class="scale-copy"><span class="tag">Built to scale</span><h2 id="scale-title">Built for your team.<br/><span>Ready for your entire company.</span></h2><div class="scale-details"><p><strong>Tenant isolation</strong><span>Designed to keep each organisation’s data separate</span></p><p><strong>Elastic architecture</strong><span>Built to grow with your data and workloads</span></p><p><strong>Multi-tenant core</strong><span>Shared infrastructure. Distinct company workspaces.</span></p><p><strong>API &amp; MCP</strong><span>Structured access for systems and AI tools</span></p></div></div>
</section>
<style>
.scale-section{position:relative;min-height:660px;overflow:hidden;background:#fff;border-top:1px solid #e9eaec;border-bottom:1px solid #e9eaec}.scale-section svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.scale-copy{position:relative;z-index:1;padding:85px 50px 160px;max-width:770px}.scale-copy h2{font-size:clamp(32px,4vw,48px);line-height:1.13;margin-top:27px}.scale-copy h2 span{color:#8a909b}.scale-details{display:grid;grid-template-columns:1fr 1fr;gap:28px 32px;margin-top:48px;max-width:540px}.scale-details p{border-left:2px solid #8295d1;padding-left:18px;line-height:1.4}.scale-details strong{display:block;font-size:21px;font-weight:500;color:#242528}.scale-details p span{display:block;font-size:13px;margin-top:5px;color:#72777e}.scale-reveal{clip-path:inset(0 100% 0 0);transition:clip-path 2.4s cubic-bezier(.22,1,.36,1)}.scale-section.is-visible .scale-reveal{clip-path:inset(0)}.scale-spark{filter:drop-shadow(0 0 6px #7089d9);opacity:0}.scale-section.is-visible .scale-spark{opacity:1;transition:opacity 1s 2s}@media(max-width:720px){.scale-copy{padding:60px 24px 180px}.scale-section{min-height:640px}.scale-details{gap:24px 20px}.scale-details strong{font-size:18px}.scale-section svg{top:160px;height:calc(100% - 160px)}}@media(prefers-reduced-motion:reduce){.scale-reveal{clip-path:none;transition:none}.scale-spark{display:none}}
</style>
<script>
const observer=new IntersectionObserver(entries=>{for(const entry of entries){entry.target.classList.toggle('is-visible',entry.isIntersecting);const svg=entry.target.querySelector('svg');if(entry.isIntersecting)svg?.unpauseAnimations();else svg?.pauseAnimations();}},{threshold:.15});document.querySelectorAll('.scale-section').forEach(section=>observer.observe(section));document.addEventListener('astro:before-swap',()=>observer.disconnect(),{once:true});
</script>
