<div class="mcp-graphic" role="img" aria-label="Product data flows through MCP to AI tools, with requests returning to the product model">
<svg viewBox="0 0 560 360" fill="none" aria-hidden="true">
<defs><linearGradient id="mcp-metal" x2="1" y2="1"><stop stop-color="#a9bed4" stop-opacity=".16"/><stop offset=".5" stop-color="#a9bed4" stop-opacity=".025"/><stop offset="1" stop-color="#a9bed4" stop-opacity=".12"/></linearGradient><radialGradient id="mcp-halo"><stop stop-color="#8da7cd" stop-opacity=".18"/><stop offset="1" stop-color="#8da7cd" stop-opacity="0"/></radialGradient></defs>
<ellipse cx="290" cy="180" rx="185" ry="140" fill="url(#mcp-halo)"/>
<g stroke="url(#mcp-spectrum)" stroke-width=".5" opacity=".22">{Array.from({length:18},(_,i)=><ellipse cx="281" cy="180" rx={48+i*4} ry={20+i*3} transform={`rotate(${i*10} 281 180)`}/>)}</g>
<g fill="#adbed3" opacity=".5">{Array.from({length:65},(_,i)=>{const a=i*2.399,r=80+(i%13)*7;return <circle cx={281+Math.cos(a)*r*1.5} cy={180+Math.sin(a)*r*.8} r={i%5===0?1.2:.55}/>})}</g>
<g stroke="#a7b6ce" stroke-width=".5" opacity=".18">{Array.from({length:11},(_,i)=><path d={`M148 ${135+i*9} C200 ${70+i*19} 240 ${260-i*15} 320 180 S410 ${75+i*17} 466 ${105+i*15}`}/>)}</g>
<g stroke="#a3b4c5" stroke-opacity=".28"><path d="M112 155H210Q230 155 245 180H350Q370 180 395 105H458"/><path d="M112 180H458"/><path d="M112 205H210Q230 205 245 180H350Q370 180 395 255H458"/></g>
<g fill="#c4d5ed" class="mcp-packets">{['M112 155H210Q230 155 245 180H350Q370 180 395 105H458','M112 180H458','M458 255H395Q370 180 350 180H245Q230 205 210 205H112'].map((path,i)=><circle r="2"><animateMotion path={path} dur={`${5+i}s`} begin={`${-i*2}s`} repeatCount="indefinite"/></circle>)}</g>
<defs><radialGradient id="mcp-orb" cx=".32" cy=".25"><stop stop-color="#263741"/><stop offset=".65" stop-color="#0c151c"/><stop offset="1" stop-color="#03070b"/></radialGradient><linearGradient id="mcp-spectrum"><stop stop-color="#b68b62"/><stop offset=".4" stop-color="#b5c8b5"/><stop offset=".7" stop-color="#88aec9"/><stop offset="1" stop-color="#8c81bc"/></linearGradient></defs>
<g stroke="#91a5be" stroke-opacity=".3" fill="url(#mcp-metal)"><path d="M26 125V234C26 265 148 265 148 234V125"/><ellipse cx="87" cy="125" rx="61" ry="20"/><path d="M26 219C26 249 148 249 148 219M26 234C26 265 148 265 148 234"/></g>
<g stroke="#9bafc6" stroke-opacity=".2" fill="none">{Array.from({length:7},(_,i)=><ellipse cx="87" cy={137+i*16} rx="61" ry="20"/>)}</g><circle cx="87" cy="183" r="56" fill="url(#mcp-halo)"/><circle cx="87" cy="183" r="32" fill="url(#mcp-orb)" stroke="url(#mcp-spectrum)" stroke-width="1.2"/>
<g class="mcp-orrery" stroke="#a4b7d0" stroke-opacity=".35"><animateTransform attributeName="transform" type="rotate" from="0 281 180" to="360 281 180" dur="90s" repeatCount="indefinite"/>{[0,1,2,3,4,5,6,7].map(i=><ellipse cx="281" cy="180" rx={13+i*5} ry={49+i*5} transform={`rotate(${i*12-18} 281 180)`}/>)}</g>
<g stroke="#92a9c4" stroke-opacity=".45">{[105,180,255].map((y,i)=><g><circle cx="466" cy={y} r="24" fill="url(#mcp-halo)"/>{[0,1,2].map(n=><ellipse cx="466" cy={y} rx="19" ry="8" transform={`rotate(${n*60+i*15} 466 ${y})`}/>)}</g>)}</g>
<g fill="#a3afbe" font-family="Inter, sans-serif" font-size="11" text-anchor="middle"><text x="87" y="293">Product database</text><text x="281" y="293">MCP</text><text x="466" y="309">AI tools</text></g>
</svg></div>
<style>
.mcp-graphic{position:relative;width:50%;flex-shrink:0}.mcp-graphic svg{display:block;width:100%;height:auto}.mcp-packets{filter:drop-shadow(0 0 4px #a1bad9)}@media(max-width:720px){.mcp-graphic{width:100%;margin-top:24px}}@media(prefers-reduced-motion:reduce){.mcp-packets{display:none}}
</style>
<script>
const mcpObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{const svg=entry.target.querySelector('svg');if(entry.isIntersecting&&!matchMedia('(prefers-reduced-motion: reduce)').matches)svg?.unpauseAnimations();else svg?.pauseAnimations();}));document.querySelectorAll('.mcp-graphic').forEach(el=>mcpObserver.observe(el));document.addEventListener('astro:before-swap',()=>mcpObserver.disconnect(),{once:true});
</script>
