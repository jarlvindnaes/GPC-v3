---
const base = import.meta.env.BASE_URL;
const groups = [
 {title:'Platform', links:[['Overview',base],['How it works',`${base}how-it-works/`],['Digital Product Passports',`${base}dpp/`]]},
 {title:'Product Connect', links:[['Enterprise',`${base}enterprise/`],['Pricing',`${base}pricing/`],['About us',`${base}about/`]]},
 {title:'Let’s connect', links:[['Talk to sales','mailto:hello@getproductconnect.com'],['Explore integrations','mailto:hello@getproductconnect.com?subject=Product%20Connect%20integrations']]}
];
---
<footer class="site-footer frame">
 <div class="footer-main"><div class="footer-identity"><a class="brand" href={base}><span class="mark">p<span>c</span></span>Product Connect</a><p>Make better products,<br/>show the world.</p><a class="footer-email" href="mailto:hello@getproductconnect.com">hello@getproductconnect.com ↗</a></div>
 {groups.map(group=><nav aria-label={group.title}><h2>{group.title}</h2>{group.links.map(([label,url])=><a href={url}>{label}</a>)}</nav>)}</div>
 <div class="footer-bottom"><span>© {new Date().getFullYear()} Product Connect</span><span>Product data. Connected.</span><a href="#main">Back to top ↑</a></div>
</footer>
<style>
.site-footer{display:block;padding:64px 48px 24px;background:#f8f9fb;border-top:1px solid #e7e9ee;color:#727987;font:400 13px Inter,Arial,sans-serif}.footer-main{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:35px}.brand{display:flex;align-items:center;gap:12px;color:#242528;font-size:16px;font-weight:600;letter-spacing:-.04em;text-decoration:none}.mark{display:inline-block;font-size:31px;font-weight:750;letter-spacing:-.22em;width:35px;transform:rotate(-12deg)}.mark span{color:#7887d8}.footer-identity p{margin:24px 0 18px;line-height:1.7}.footer-email{font-size:11px}.site-footer nav{display:flex;flex-direction:column;gap:15px}.site-footer nav h2{font-size:12px;color:#292e38;font-weight:600;letter-spacing:0;margin:8px 0 9px}.site-footer a{color:inherit;text-decoration:none}.site-footer a:hover{color:#5c70bf}.site-footer a:focus-visible{outline:2px solid #627de7;outline-offset:5px}.footer-bottom{margin-top:56px;padding-top:22px;border-top:1px solid #e1e5eb;display:flex;justify-content:space-between;gap:20px;font-size:11px}@media(max-width:800px){.footer-main{grid-template-columns:1fr 1fr;gap:35px}.site-footer{padding:40px 24px 22px}}@media(max-width:480px){.footer-main{gap:28px 16px}.footer-identity{grid-column:1/-1}.footer-bottom{flex-wrap:wrap}.footer-bottom>span:nth-child(2){display:none}}
</style>
<style>
.site-footer{background:#111214;color:#9298a2;border-color:#292b30}.site-footer .brand,.site-footer nav h2{color:#f0f2f5}.site-footer .footer-bottom{border-color:#292b30}.site-footer a:hover{color:#c4cef2}.footer-identity p{color:#9298a2}
</style>
