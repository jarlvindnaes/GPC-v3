---
import ArrowIcon from '../ArrowIcon.astro';
import MotionToggle from '../MotionToggle.astro';
import PcLogoAnimated from '../PcLogoAnimated.astro';
// the old site's connected dots (wireframe/ParticleField.tsx), faint behind the footer
import { ParticleField } from '../wireframe/ParticleField';
const base = import.meta.env.BASE_URL;
const groups = [
 {title:'Platform', links:[['What we solve',base],['How it works',`${base}how-it-works/`],['Digital Product Passports',`${base}#product-passports`]]},
 {title:'Product Connect', links:[['The product model',`${base}product-model/`],['Integrations',`${base}how-it-works/#integrations`]]},
 {title:'Let’s connect', links:[['Talk to sales','mailto:contact@productconnect.com'],['Explore integrations','mailto:contact@productconnect.com?subject=Product%20Connect%20integrations']]}
];
---
<footer class="site-footer frame">
 <ParticleField client:visible={{ rootMargin: "400px" }} />
 <div class="footer-main"><div class="footer-identity"><a class="brand" href={base} aria-label="Product Connect home"><PcLogoAnimated class="footer-mark" trigger="hover" /><span>product<br/>connect</span></a><p>Make better products,<br/>show the world.</p><a class="footer-email" href="mailto:contact@productconnect.com">contact@productconnect.com <ArrowIcon /></a></div>
 {groups.map(group=><nav aria-label={group.title}><h2>{group.title}</h2>{group.links.map(([label,url])=><a href={url}>{label}</a>)}</nav>)}</div>
 <div class="footer-bottom"><span>© {new Date().getFullYear()} Product Connect</span><span>Product data. Connected.</span><MotionToggle /><a href="#main">Back to top <span aria-hidden="true">↑</span></a></div>
</footer>
<style>
.site-footer{display:block;padding:64px 48px 24px;background:#f8f9fb;border-top:1px solid #e7e9ee;color:#727987;font:400 13px Inter,Arial,sans-serif}.footer-main{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:35px}.brand{display:flex;align-items:center;gap:12px;color:#242528;font-size:17px;line-height:.98;font-weight:550;letter-spacing:-.7px;text-decoration:none}.mark{display:inline-block;font-size:48px;font-weight:600;letter-spacing:-7px;line-height:1;padding-right:5px}.mark span{color:#7887d8;letter-spacing:-3px}.footer-identity p{margin:24px 0 18px;line-height:1.7}.footer-email{font-size:11px}.site-footer nav{display:flex;flex-direction:column;gap:15px}.site-footer nav h2{font-size:12px;color:#292e38;font-weight:600;letter-spacing:0;margin:8px 0 9px}.site-footer a{color:inherit;text-decoration:none}.site-footer a:hover{color:#5c70bf}.site-footer a:focus-visible{outline:2px solid #627de7;outline-offset:5px}.footer-bottom{margin-top:56px;padding-top:22px;border-top:1px solid #e1e5eb;display:flex;justify-content:space-between;gap:20px;font-size:11px}@media(max-width:800px){.footer-main{grid-template-columns:1fr 1fr;gap:35px}.site-footer{padding:40px 24px 22px}}@media(max-width:480px){.footer-main{gap:28px 16px}.footer-identity{grid-column:1/-1}.footer-bottom{flex-wrap:wrap}.footer-bottom>span:nth-child(2){display:none}}
</style>
<style>
/* the same footer on every page: full width, its content kept within the 1240px frame (the homepage's .frame box
   would otherwise make it a narrower dark block than on How it works) */
.site-footer{max-width:none;margin:0;border-left:0;border-right:0}
@media(min-width:801px){.site-footer{padding-inline:max(48px,calc((100% - 1240px) / 2 + 48px))}}
.site-footer :global(.footer-mark){height:34px;--pc-mark-dot:#7887d8;--pc-logo-dot:#d6ef8c} /* dark footer: lime logo dot */
.site-footer{background:#111214;color:#9298a2;border-color:#292b30}.site-footer .brand,.site-footer nav h2{color:#f0f2f5}.site-footer .footer-bottom{border-color:#292b30}.site-footer a:hover{color:#c4cef2}.footer-identity p{color:#9298a2}
</style>
<style>
/* the dots: just above the footer's background, under all else, faint; never taking the pointer (on the field itself:
   its island wrapper is display: contents) */
.site-footer{position:relative;isolation:isolate}
.site-footer :global(.particle-field){position:absolute;inset:0;z-index:-1;overflow:hidden;opacity:.18;pointer-events:none}
@media(prefers-reduced-motion:reduce){.site-footer :global(.particle-field){opacity:.14}}
</style>
<style>
/* the bottom row's items on one centre line (the motion toggle is taller than the text beside it) */
.footer-bottom{align-items:center}
</style>
<style>
/* the email and its arrow on one line (the arrow wrapped below it when the column is narrow) */
.footer-email{display:inline-flex;align-items:center;white-space:nowrap}
</style>
