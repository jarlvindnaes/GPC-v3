---
// "CO₂ numbers you can trust": a dark life-cycle waterfall inspired by the product's own LCA report
// (ProductConnect WebApp/routes/reports and the LCA background report). The declared GWP-total is built up
// module by module (A1-A5, C1-C4, EN 15804+A2), landing exactly on the total; Module D is shown apart, below
// the baseline, because EN 15804 reports it outside the declared total. Chips name the method and data
// sources, and a strip shows the per-dataset data-quality rating (geography, time, technology) the report
// uses. Illustrative numbers for a chair, not a real result.
const modules = [
  { code: 'A1', name: 'Raw materials', value: 14.6, group: 'a13' },
  { code: 'A2', name: 'Transport to factory', value: 1.1, group: 'a13' },
  { code: 'A3', name: 'Manufacturing', value: 4.2, group: 'a13' },
  { code: 'A4', name: 'Distribution', value: 1.5, group: 'a45' },
  { code: 'A5', name: 'Installation', value: 0.4, group: 'a45' },
  { code: 'C1', name: 'Deconstruction', value: 0.1, group: 'c' },
  { code: 'C2', name: 'Transport to treatment', value: 0.3, group: 'c' },
  { code: 'C3', name: 'Waste processing', value: 0.5, group: 'c' },
  { code: 'C4', name: 'Disposal', value: 2.1, group: 'c' },
];
const total = Math.round(modules.reduce((sum, m) => sum + m.value, 0) * 10) / 10; // 24.8
const credit = -1.9; // Module D: benefits beyond the system boundary
// Vertical scale: top of the chart is 28 kg, bottom is -3 kg (room for D under the baseline).
const top = 28;
const bottom = -3;
const pct = (v: number) => ((v - bottom) / (top - bottom)) * 100;
let running = 0;
const bars = modules.map((m, i) => {
  const from = running;
  running += m.value;
  return { ...m, base: pct(from), height: pct(running) - pct(from), delay: i * 70 };
});
const baseline = pct(0);
const quality = [
  { label: 'Geography', grade: 'VG', level: 5 },
  { label: 'Time', grade: 'G', level: 4 },
  { label: 'Technology', grade: 'VG', level: 5 },
];
const fmt = (v: number) => v.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---
<div class="co2" data-co2-proof role="img" aria-label={`Illustrative life-cycle result: ${fmt(total)} kilograms CO2 equivalent, built up from modules A1 to C4 per EN 15804+A2, with module D credit of ${fmt(credit)} kilograms reported separately.`}>
  <div class="co2-head" aria-hidden="true">
    <div>
      <span class="co2-eyebrow">Lounge chair · GWP-total</span>
      <strong class="co2-total">{fmt(total)}<em>kg CO₂e</em></strong>
      <span class="co2-scope">A1–A5 · C1–C4 · D reported separately</span>
    </div>
    <ul class="co2-chips">
      <li>EN 15804+A2</li>
      <li>ISO 14040/44</li>
      <li>EF 3.1</li>
      <li>ecoinvent 3.11</li>
    </ul>
  </div>

  <div class="co2-chart" aria-hidden="true" style={`--baseline:${baseline}%`}>
    <div class="co2-cols">
      {bars.map((b) => (
        <div class:list={['co2-col', `g-${b.group}`]} title={`${b.code} ${b.name}: ${fmt(b.value)} kg CO₂e`}>
          <span class="co2-area"><span class="co2-bar" style={`bottom:${b.base}%;height:${b.height}%;--d:${b.delay}ms`}>
            <span class="co2-val">{fmt(b.value)}</span>
          </span></span>
          <span class="co2-code">{b.code}</span>
        </div>
      ))}
      <div class="co2-col g-total" title={`Declared total: ${fmt(total)} kg CO₂e`}>
        <span class="co2-area"><span class="co2-bar" style={`bottom:${baseline}%;height:${pct(total) - baseline}%;--d:${bars.length * 70 + 80}ms`}>
          <span class="co2-val">{fmt(total)}</span>
        </span></span>
        <span class="co2-code">Total</span>
      </div>
      <div class="co2-col g-d" title={`Module D, beyond the system boundary: ${fmt(credit)} kg CO₂e`}>
        <span class="co2-area"><span class="co2-bar" style={`bottom:${pct(credit)}%;height:${baseline - pct(credit)}%;--d:${bars.length * 70 + 220}ms`}>
          <span class="co2-val">{fmt(credit)}</span>
        </span></span>
        <span class="co2-code">D</span>
      </div>
    </div>
    <div class="co2-groups">
      <span style="flex:3">Product stage</span>
      <span style="flex:2">Construction</span>
      <span style="flex:4">End of life</span>
      <span style="flex:1"></span>
      <span style="flex:1">Beyond</span>
    </div>
  </div>

  <div class="co2-foot" aria-hidden="true">
    <span class="co2-foot-label">Data quality</span>
    {quality.map((q) => (
      <span class="co2-q">
        <span>{q.label}</span>
        <span class="co2-meter">{[1, 2, 3, 4, 5].map((n) => <i class:list={{ on: n <= q.level }} />)}</span>
        <b>{q.grade}</b>
      </span>
    ))}
    <span class="co2-note">Illustrative data</span>
  </div>
</div>

<script>
  // Build the waterfall up when the panel scrolls into view (once). Without JS or with reduced motion the
  // bars are simply shown.
  const panel = document.querySelector<HTMLElement>("[data-co2-proof]");
  if (panel && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    panel.classList.add("co2-pending");
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          panel.classList.add("co2-in");
          observer.disconnect();
        }
      },
      { threshold: 0.4 }
    );
    observer.observe(panel);
  }
</script>

<style>
  .co2 {
    --ink: #eef1fb;
    --soft: #9aa3bf;
    --line: #ffffff1f;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 26px 32px 18px;
    color: var(--ink);
    background: radial-gradient(ellipse at 70% 30%, #1d2754 0%, #0e1430 50%, #070a17 100%);
    overflow: hidden;
  }
  .co2-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .co2-eyebrow {
    display: block;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c5cff2;
  }
  .co2-total {
    display: block;
    margin-top: 6px;
    font-size: 38px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .co2-total em {
    margin-left: 8px;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--soft);
  }
  .co2-scope {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--soft);
  }
  .co2-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    max-width: 300px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .co2-chips li {
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 11px;
    color: #d7ddf3;
    background: #ffffff0a;
  }

  .co2-chart {
    position: relative;
    flex: 1;
    min-height: 120px;
    display: flex;
    flex-direction: column;
  }
  .co2-cols {
    position: relative;
    flex: 1;
    display: flex;
    gap: 10px;
  }
  .co2-col {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  /* The bar area (above the code label); bars are placed in % of it, the baseline (0 kg) runs across it. */
  .co2-area {
    position: relative;
    flex: 1;
  }
  .co2-area::before {
    content: "";
    position: absolute;
    left: -5px;
    right: -5px;
    bottom: var(--baseline);
    height: 1px;
    background: #ffffff2e;
  }
  .co2-bar {
    position: absolute;
    left: 0;
    right: 0;
    min-height: 2px;
    border-radius: 4px;
    transform-origin: bottom;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d), opacity 0.4s ease var(--d);
  }
  .co2-code {
    height: 22px;
    line-height: 22px;
    text-align: center;
    font-size: 11px;
    color: var(--soft);
  }
  .co2-val {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translate(-50%, -4px);
    font-size: 10.5px;
    color: #c9d1ee;
    white-space: nowrap;
  }
  .g-a13 .co2-bar { background: linear-gradient(180deg, #9aa8f0, #6f7dce); }
  .g-a45 .co2-bar { background: linear-gradient(180deg, #7f8fd8, #5463ad); }
  .g-c .co2-bar { background: linear-gradient(180deg, #8d99b8, #5d6886); }
  .g-total .co2-bar { background: linear-gradient(180deg, #ffffff, #c9d0ee); }
  .g-total .co2-val { color: #fff; font-weight: 600; }
  .g-total .co2-code { color: #fff; }
  .g-d .co2-bar {
    background: repeating-linear-gradient(135deg, #7fd6a833 0 4px, transparent 4px 8px);
    border: 1px dashed #7fd6a8;
    transform-origin: top;
  }
  .g-d .co2-val { color: #9fe3bf; } /* above the baseline (the bar's top), clear of the D label below */
  .g-d .co2-code { color: #9fe3bf; }
  .g-total { margin-left: 10px; }

  .co2-groups {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7f88a6;
  }
  .co2-groups span {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .co2-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--soft);
  }
  .co2-foot-label {
    color: #c5cff2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 10.5px;
  }
  .co2-q {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .co2-q b {
    color: var(--ink);
    font-weight: 600;
  }
  .co2-meter {
    display: inline-flex;
    gap: 2px;
  }
  .co2-meter i {
    width: 10px;
    height: 4px;
    border-radius: 2px;
    background: #ffffff1f;
  }
  .co2-meter i.on {
    background: #7fd6a8;
  }
  .co2-note {
    margin-left: auto;
    font-size: 10.5px;
    color: #6f7896;
  }

  /* Build-up on scroll-in */
  .co2-pending .co2-bar {
    transform: scaleY(0);
    opacity: 0;
  }
  .co2-pending.co2-in .co2-bar {
    transform: none;
    opacity: 1;
  }
  .co2-pending .co2-val {
    opacity: 0;
    transition: opacity 0.4s ease calc(var(--d, 0ms) + 0.45s);
  }
  .co2-pending.co2-in .co2-val {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .co2 { padding: 18px 16px 14px; gap: 12px; }
    .co2-head { flex-direction: column; gap: 12px; }
    .co2-chips { justify-content: flex-start; max-width: none; }
    .co2-total { font-size: 30px; }
    .co2-cols { gap: 5px; }
    .co2-area::before { left: -3px; right: -3px; }
    .g-total { margin-left: 4px; }
    .co2-val { display: none; }
    .g-total .co2-val, .g-d .co2-val { display: block; }
    .co2-groups { display: none; }
    .co2-chart { min-height: 170px; }
    .co2-note { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .co2-bar, .co2-val { transition: none; }
  }
</style>
