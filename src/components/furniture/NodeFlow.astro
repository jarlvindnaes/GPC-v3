---
import './node-flow.css';
import PcLogoAnimated from '../PcLogoAnimated.astro';
const nodes=[
['cad','CAD files','Geometry',8,12],['bom','Bill of materials','Product structure',8,30],['source','Supplier records','Primary data',8,50],['docs','Documents','Certificates',8,70],['spec','Specifications','Materials',8,88],
['files','Product files','CAD · BOM',29,25],['suppliers','Supply chain','Suppliers · Sources',29,50],['materials','Components','Materials · Parts',29,75],
['pc','Product Connect','One connected product model',50,50],
['impact','Impact insights','Understand & improve',71,25],['passport','Product passports','Publish & share',71,50],['evidence','Product evidence','Trace & document',71,75],
['carbon','Carbon footprint','Product impact',92,12],['compare','Comparisons','Better decisions',92,30],['care','Care & repair','Product knowledge',92,50],['shop','Spare parts','Coming this spring',92,70],['trace','Traceability','Source evidence',92,88]
];
const edges=[['cad','files'],['bom','files'],['source','suppliers'],['docs','suppliers'],['spec','materials'],['bom','materials'],['files','pc'],['suppliers','pc'],['materials','pc'],['pc','impact'],['pc','passport'],['pc','evidence'],['impact','carbon'],['impact','compare'],['passport','care'],['passport','shop'],['evidence','trace']];
---
<div class="node-diagram" data-node-diagram><div class="diagram-toolbar"><span>YOUR DATA</span><span>CONNECTED KNOWLEDGE</span><span>PUT TO WORK</span></div><p class="node-swipe" aria-hidden="true">Swipe to follow the flow →</p><div class="node-scroll"><div class="node-stage"><svg class="node-wires" aria-hidden="true"><defs><linearGradient id="flow-stroke" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100%" y2="0"><stop stop-color="#c6cfdf"/><stop offset=".5" stop-color="#859dd0"/><stop offset="1" stop-color="#c6cfdf"/></linearGradient></defs>{edges.map(([from,to])=> <path data-from={from} data-to={to} stroke="url(#flow-stroke)" fill="none"/>)}</svg>{nodes.map(([id,title,subtitle,x,y])=><button type="button" class:list={['flow-node',{'flow-hub':id==='pc','flow-leaf':['cad','bom','source','docs','spec','carbon','compare','care','shop','trace'].includes(String(id))}]} data-node={id} data-x={x} data-y={y} style={`left:${x}%;top:${y}%`} aria-describedby="node-help"><span class="node-symbol" aria-hidden="true">{id==='pc'?<PcLogoAnimated class="hub-logo" trigger="hover" />:id==='files'?'▤':id==='suppliers'?'◎':id==='materials'?'◈':id==='impact'?'⌁':id==='passport'?'▥':'✓'}</span><strong>{title}</strong><small>{subtitle}</small></button>)}</div></div><p id="node-help" class="sr-only">Drag a node to explore the connections. You can also use the arrow keys.</p></div>
<script>
import { initNodeFlow } from './node-flow';
const cleanup=initNodeFlow();
document.addEventListener('astro:before-swap',cleanup,{once:true});
// Phones: fade whichever edge still has more diagram beyond it; each fade shrinks away as that end is reached.
for (const scroller of document.querySelectorAll<HTMLElement>('.node-scroll')) {
 const FADE = 56;
 const edges = () => {
  const left = scroller.scrollLeft;
  const right = scroller.scrollWidth - scroller.clientWidth - left;
  scroller.style.setProperty('--fade-l', `${Math.round(Math.min(FADE, Math.max(0, left)))}px`);
  scroller.style.setProperty('--fade-r', `${Math.round(Math.min(FADE, Math.max(0, right)))}px`);
 };
 scroller.addEventListener('scroll', edges, { passive: true });
 new ResizeObserver(edges).observe(scroller);
 edges();
}
</script>
