---
// "CO₂ numbers you can trust": a dark miniature of Product Connect's professional LCA report
// (ProductConnect/application/product-connect/WebApp/routes/reports/-components/professional): summary metric
// cards, then top component contributors, in the product's dark chart
// palette. It moves from the overview to the contributors as you scroll (or takes turns on its own outside the pinned story). Illustrative numbers for a lounge chair, not a real result.
const metrics = [
  { icon: 'leaf', tone: 'emerald', value: '24.8', unit: 'kg CO₂ eq', label: 'Carbon impact' },
  { icon: 'zap', tone: 'amber', value: '312.5', unit: 'MJ', label: 'Energy use' },
  { icon: 'drop', tone: 'sky', value: '86.4', unit: 'L', label: 'Water use' },
  { icon: 'bin', tone: 'slate', value: '1.9', unit: 'kg', label: 'Waste generated' },
];
const highlights = [
  { value: '13%', label: 'Recycled content' },
  { value: '58%', label: 'Bio-based content' },
  { value: 'A1-A5, C1-C4, D', label: 'Modules' },
];

// --- Top component contributors (kg CO₂ eq), largest first; they add up to the 24.8 kg total ---
// Parts of the TAKT Soft Lounge Chair model, so each gets the passport's turning 3D thumbnail (part ids
// from dppProductData.ts).
const contributors = [
  { name: 'Leather seat', part: 'seat-cushion', value: 9.8 },
  { name: 'Back shell', part: 'back-shell', value: 4.6 },
  { name: 'Seat shell', part: 'seat-shell', value: 3.9 },
  { name: 'Armrests', part: 'armrest', value: 2.4 },
  { name: 'Legs', part: 'front-leg', value: 2.1 },
  { name: 'Rails', part: 'seat-rail', value: 1.1 },
  { name: 'Bolts', part: 'bolt', value: 0.9 },
];
const barMax = 15; // headroom above the tallest bar for its thumbnail and value

const views = ['Overview', 'Contributors'];
const START = 0; // opens on the overview
import { DppPartThumb } from '../dpp/DppPartThumb';
const nf = (v: number, d = 1) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
---
<div class="rep" data-co2-report>

  <div class="rep-views">
    <section class="rep-view is-active" data-view="0" aria-label="Overview">
      <span class="rep-view-note" aria-hidden="true">Illustrative data</span>
      <div class="rep-metrics">
        {metrics.map((m) => (
          <div class="rep-card">
            <span class:list={['rep-icon', `t-${m.tone}`]} aria-hidden="true">
              {m.icon === 'leaf' && <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>}
              {m.icon === 'zap' && <svg viewBox="0 0 24 24"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>}
              {m.icon === 'drop' && <svg viewBox="0 0 24 24"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>}
              {m.icon === 'bin' && <svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>}
            </span>
            <span class="rep-metric"><b>{m.value}</b> <small>{m.unit}</small></span>
            <span class="rep-label">{m.label}</span>
          </div>
        ))}
      </div>
      <div class="rep-highlights">
        {highlights.map((h) => (
          <div class="rep-card rep-hl"><b>{h.value}</b><span>{h.label}</span></div>
        ))}
      </div>
    </section>

    <section class="rep-view" data-view="1" aria-label="Top component contributors">
      <h4>Top component contributors <small>kg CO₂ eq</small><span class="rep-view-note" aria-hidden="true">Illustrative data</span></h4>
      <div class="rep-bars" aria-hidden="true">
        <div class="sk-tip bar-tip"><b></b><span></span></div>
        {[0, 5, 10, 15].map((g) => <span class="rep-grid" style={`bottom:calc(var(--lab) + (100% - var(--lab)) * ${g / barMax})`}><em>{g}</em></span>)}
        {contributors.map((c, i) => (
          <div class="rep-barcol" style={`--i:${i}`} data-title={c.name} data-kg={nf(c.value)}>
            <span class="rep-bar" style={`height:${(c.value / barMax) * 100}%`}></span>
            <span class="rep-thumb rep-barthumb" style={`bottom:calc(${(c.value / barMax) * 100}% + 5px)`}><DppPartThumb client:visible partId={c.part} label={`3D model: ${c.name}`} /></span>
            <span class="rep-barval" style={`bottom:calc(${(c.value / barMax) * 100}% + 52px)`}>{nf(c.value)}</span>
            <span class="rep-barname">{c.name}</span>
          </div>
        ))}
      </div>
    </section>

  </div>

  <span class="rep-note">Illustrative data</span>
</div>

<script>
  import { motionPaused } from "../../utilities/motion";
  // No view menu: in the pinned story, scrolling moves from the overview to the contributors; elsewhere (stacked
  // chapters on phones) the views take turns every STEP while the report is on screen, holding while hovered.
  // With reduced motion or "Pause animations" the timed turns stop; the scroll still moves between views.
  const root = document.querySelector<HTMLElement>("[data-co2-report]");
  if (root) {
    const views = Array.from(root.querySelectorAll<HTMLElement>(".rep-view"));
    const reduce = motionPaused(); // system setting or the footer's "Pause animations"
    const STEP = 5000;
    let current = Math.max(0, views.findIndex((v) => v.classList.contains("is-active")));
    let visible = false;
    let hovering = false;
    // Story: until this chapter has fully arrived, the report waits on the start view with its timer paused
    // (in the pinned stage it sits under the earlier chapter, so it counts as on screen while still hidden).
    let waiting = false;
    let stopped = reduce;
    // Timed turns (outside the pinned story): time only counts while on screen, not hovered and not scroll-driven.
    let elapsed = 0;
    const show = (index: number) => {
      current = index;
      views.forEach((v, i) => v.classList.toggle("is-active", i === index));
      elapsed = 0;
    };
    // Contributors hover (mirrors the product's BarChart): highlight the hovered bar, dim the rest, tooltip.
    const barArea = root.querySelector<HTMLElement>(".rep-bars");
    const barTip = barArea?.querySelector<HTMLElement>(".bar-tip");
    if (barArea && barTip) {
      const cols = Array.from(barArea.querySelectorAll<HTMLElement>(".rep-barcol"));
      for (const col of cols) {
        col.addEventListener("pointermove", (event) => {
          barArea.classList.add("is-hl");
          cols.forEach((c) => c.classList.toggle("on", c === col));
          barTip.querySelector("b")!.textContent = col.dataset.title ?? "";
          barTip.querySelector("span")!.textContent = `${col.dataset.kg} kg CO₂ eq`;
          const box = barArea.getBoundingClientRect();
          const x = Math.min(event.clientX - box.left + 14, box.width - barTip.offsetWidth - 4);
          barTip.style.left = `${Math.max(4, x)}px`;
          barTip.style.top = `${Math.min(event.clientY - box.top + 14, box.height - barTip.offsetHeight)}px`;
          barTip.classList.add("on");
        });
      }
      barArea.addEventListener("pointerleave", () => {
        barArea.classList.remove("is-hl");
        cols.forEach((c) => c.classList.remove("on"));
        barTip.classList.remove("on");
      });
    }
    // Scroll story (Home.astro): while this chapter is pinned, scrolling moves through the views in order from
    // the start view.
    const ORDER = [0, 1];
    let scrubbed = false;
    let seg = -1;
    window.addEventListener("co2report:scroll", (event) => {
      const { arrived, held } = (event as CustomEvent<{ arrived: number; held: number }>).detail;
      const was = scrubbed;
      const wasWaiting = waiting;
      waiting = arrived < 0.999;
      if (waiting) {
        if (current !== 0 || !wasWaiting) {
          show(0); // the overview, held until the chapter has arrived
        }
        seg = -1;
      }
      scrubbed = arrived >= 0.999 && held < 0.999;
      if (scrubbed) {
        const next = Math.floor(Math.min(ORDER.length - 0.001, Math.max(0, held) * ORDER.length));
        if (next !== seg) {
          seg = next;
          if (ORDER[seg] !== current) {
            show(ORDER[seg]);
          }
        }
      } else if (was) {
        seg = -1;
      }
    });
    const TICK = 250;
    window.setInterval(() => {
      if (stopped || scrubbed || waiting || hovering || !visible || document.documentElement.classList.contains("story-stage")) {
        return;
      }
      elapsed += TICK;
      if (elapsed >= STEP) {
        show((current + 1) % views.length);
      }
    }, TICK);
    root.addEventListener("pointerenter", () => { hovering = true; });
    root.addEventListener("pointerleave", () => { hovering = false; });
    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
    }, { threshold: 0.4 }).observe(root);
  }
</script>

<style>
  .rep {
    --bg: #090e18;
    --card: #0d1320;
    --border: #1f2635;
    --fg: #eef1f6;
    --muted: #8b93a7;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 14px 22px 12px;
    color: var(--fg);
    background: var(--bg);
    overflow: hidden;
    font-feature-settings: "tnum";
  }
  /* Small print in the card's bottom-right corner. */
  .rep-note { position: absolute; right: 16px; bottom: 9px; z-index: 1; font-size: 11px; color: #5f677c; pointer-events: none; }

  .rep-views { position: relative; flex: 1; min-height: 0; margin-top: 14px; }
  .rep-view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s linear 0.45s;
  }
  .rep-view.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s;
  }
  .rep-view h4 { margin: 0; font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
  .rep-view h4 small { margin-left: 6px; font-size: 11px; font-weight: 400; color: var(--muted); }
  /* "Illustrative data" in a view's heading row (shown where the page asks for it: home.css, the pinned emissions
     chapter on wider screens); the corner .rep-note covers everywhere else */
  .rep-view-note { display: none; }

  .rep-card { border: 1px solid var(--border); border-radius: 12px; background: var(--card); }
  .rep-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .rep-metrics .rep-card { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 10px 10px; padding: 14px; }
  .rep-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; }
  .rep-icon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .t-emerald { background: #022c22; color: #10b981; }
  .t-amber { background: #451a03; color: #f59e0b; }
  .t-sky { background: #082f49; color: #0ea5e9; }
  .t-slate { background: #1e293b; color: #94a3b8; }
  .rep-metric b { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
  .rep-metric small { font-size: 12px; color: var(--muted); }
  .rep-label { grid-column: 1 / -1; font-size: 13px; color: var(--muted); }
  .rep-highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; flex: 1; }
  .rep-hl { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 12px; text-align: center; }
  .rep-hl b { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; }
  .rep-hl span { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  .sk-tip {
    position: absolute;
    z-index: 2;
    padding: 9px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #111827f2;
    box-shadow: 0 10px 30px #0008;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease-out;
  }
  .sk-tip.on { opacity: 1; }
  .sk-tip b { display: block; font-size: 13px; font-weight: 700; white-space: nowrap; }
  .sk-tip span { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }

  .rep-bars { --lab: 24px; position: relative; flex: 1; display: flex; gap: 12px; margin: 14px 0 0 26px; padding-bottom: var(--lab); }
  .rep-grid { position: absolute; left: 0; right: 0; height: 0; border-top: 1px dashed #2a3345; }
  .rep-grid em { position: absolute; left: -24px; top: -7px; font-size: 10.5px; font-style: normal; color: var(--muted); }
  .rep-barcol { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
  .rep-bar {
    position: relative;
    display: block;
    border: 1.5px solid hsl(226 70% 65%);
    border-bottom: 0;
    border-radius: 5px 5px 0 0;
    background: hsl(226 70% 65% / 0.3);
    transform-origin: bottom;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .rep-barval { position: absolute; left: 50%; transform: translateX(-50%); font-size: 11px; font-weight: 500; color: var(--muted); white-space: nowrap; transition: color 150ms ease-out, font-size 150ms ease-out; }
  /* Hover, as in the product's BarChart: the hovered bar gets a thicker outline and a glow and its value turns
     bold; the other bars (and their parts) dim to 0.4. */
  .rep-barcol { cursor: pointer; }
  .rep-bar { transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 150ms ease-out, box-shadow 150ms ease-out; }
  .rep-bars.is-hl .rep-barcol:not(.on) .rep-bar { opacity: 0.4; }
  .rep-barthumb { transition: opacity 0.4s ease calc(var(--i, 0) * 60ms + 650ms), filter 150ms ease-out; }
  .rep-bars.is-hl .rep-barcol:not(.on) .rep-barthumb { filter: opacity(0.4); } /* filter, so it is not held back by the fade-in delay */
  .rep-barcol.on .rep-bar { box-shadow: 0 0 0 2.5px hsl(226 70% 65%), 0 0 10px 1px hsl(226 70% 65% / 0.7); }
  .rep-barcol.on .rep-barval { color: var(--fg); font-size: 12.5px; font-weight: 700; }
  .rep-bars .bar-tip { left: 0; top: 0; }
  .rep-barname { position: absolute; left: 50%; bottom: -22px; transform: translateX(-50%); font-size: 11px; color: var(--muted); white-space: nowrap; }
  .rep-view:not(.is-active) .rep-bar { transform: scaleY(0); }
  .rep-view.is-active .rep-bar { transition-delay: calc(var(--i, 0) * 60ms + 150ms), 0s, 0s; } /* stagger the growth only, not hover */

  /* Rounded tile behind each 3D part, as in Product Connect's product lists. */
  .rep-thumb { display: block; width: 38px; height: 38px; flex: none; padding: 3px; border-radius: 9px; background: #1c2333; }
  /* Each part's 3D thumbnail sits on top of its bar, its value above it; both arrive after the bar has grown. */
  .rep-barthumb { position: absolute; left: 50%; width: 42px; height: 42px; transform: translateX(-50%); }
  .rep-barthumb, .rep-barval { transition: opacity 0.4s ease calc(var(--i, 0) * 60ms + 650ms); }
  .rep-view:not(.is-active) .rep-barthumb, .rep-view:not(.is-active) .rep-barval { opacity: 0; transition: none; }

  /* Each view stages its contents when it becomes active. */
  .rep-metrics .rep-card, .rep-hl { transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
  /* Flow chart: the entrance uses opacity (links) and filter (nodes), so hover's own fades stay instant. */
  .rep-view:not(.is-active) :is(.rep-metrics .rep-card, .rep-hl) { opacity: 0; transform: translateY(14px) scale(0.97); transition: none; }
  .rep-view.is-active .rep-metrics .rep-card:nth-child(1) { transition-delay: 0.08s; }
  .rep-view.is-active .rep-metrics .rep-card:nth-child(2) { transition-delay: 0.16s; }
  .rep-view.is-active .rep-metrics .rep-card:nth-child(3) { transition-delay: 0.24s; }
  .rep-view.is-active .rep-metrics .rep-card:nth-child(4) { transition-delay: 0.32s; }
  .rep-view.is-active .rep-hl:nth-child(1) { transition-delay: 0.42s; }
  .rep-view.is-active .rep-hl:nth-child(2) { transition-delay: 0.5s; }
  .rep-view.is-active .rep-hl:nth-child(3) { transition-delay: 0.58s; }

  @media (max-width:599px) {
    .rep { padding: 12px 12px 10px; }
    .rep-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .rep-metrics .rep-card { padding: 10px; }
    .rep-metric b { font-size: 18px; }
    .rep-highlights { gap: 8px; }
    .rep-hl b { font-size: 15px; }
    .rep-hl span { font-size: 9px; }
      .rep-bars { gap: 6px; }
    .rep-bars { --lab: 30px; margin-left: 22px; }
    .rep-barthumb { width: 32px; height: 32px; }
    .rep-barval { margin-bottom: -8px; }
    .rep-thumb:not(.rep-barthumb) { width: 32px; height: 32px; border-radius: 8px; }
    .rep-barname { width: 100%; bottom: auto; top: calc(100% + 4px); font-size: 9px; line-height: 1.15; text-align: center; white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rep-view, .rep-bar { transition: none; }
  }
</style>
