---
import ArrowIcon from '../ArrowIcon.astro';
import '../../index.css';
import './home.css';
import '../../styles/story-teaser.css';
import { LazyPassportPhone, LazySupplyChainGlobe } from '../LazyIslands';
import Footer from './Footer.astro';
import ClosingCta from '../ClosingCta.astro';
import SeoMeta from '../SeoMeta.astro';
import SiteHeader from '../SiteHeader.astro';
import StoryDotsNav from '../StoryDotsNav.astro';
import ProductMemory from './ProductMemory.astro';
import McpGraphic from './McpGraphic.astro';
import Scale from './Scale.astro';
import BenefitProof from './BenefitProof.astro';
import BrandStrip from './BrandStrip.astro';
import Co2Report from './Co2Report.astro';
import { Award, ClipboardCheck, FileSpreadsheet, Flag, Presentation, QrCode, ScanSearch, ShieldAlert, UserRoundPlus } from 'lucide-react';
const base = import.meta.env.BASE_URL;
// Page title and description for search and link previews: Product Connect is for any physical product, not only furniture.
const pageTitle = 'Make better products, show the world · Product Connect';
const pageDescription = 'One platform for all your product data. Calculate CO₂ and environmental impact, track every improvement, and show it in Digital Product Passports.';
const contact = 'mailto:contact@productconnect.com';
const getStarted = 'mailto:contact@productconnect.com?subject=Getting%20started%20with%20Product%20Connect';
// The testimonial (portrait, person, company, quote) is a fictional placeholder; hidden until an approved one exists.
const SHOW_DRAFT_TESTIMONIAL = false;
const benefits = [
 {id:'harvest-data',short:'Suppliers',label:'Supplier data & management',title:'Stop chasing suppliers.',lead:'Save time and effort collecting data',text:'No spreadsheets, no emails back and forth. Suppliers onboard through a state-of-the-art experience and enter their data directly in the platform. Suppliers are rewarded for helping you out with LCA data on their own products.'},
 {id:'trusted-co2',short:'Emissions',label:'Trusted emission numbers',title:'Emission numbers you can trust.',lead:'EPD calculations in days, not months',text:'Auditor-grade calculations built on EN 15804+A2 and the ISO standards behind every EPD, verified and validated end to end. It’s a world first, and it cuts the whole EPD process from months to weeks.'},
 {id:'analyse-improve',short:'Analyse',label:'Analyse & improve',title:'Know exactly what to fix',lead:'Better products, more deals won.',text:'See where your impact really comes from, and what will move it most: a material, a component, a supplier. Improve your products and your supply chain with confidence, and bring better numbers to every tender.'},
 {id:'product-passports',short:'Clients',label:'Connect with clients',title:'Open new sales channels',lead:'Tomorrow’s customer experience.',text:'Every product gets a passport that stays up to date, one scan away, and connects you directly with the people who own it. Give your sales team a story competitors can’t match, and set the standard in your category.'},
 {id:'beat-regulation',short:'EU rules',label:'Beat EU regulation',title:'Ahead of the rules. Ahead of the rest.',lead:'New EU rules are on their way.',text:'Get your Digital Product Passports in place early, and outperform the competitors still scrambling to catch up.'}
];
// A bullet's key phrase is marked **like this** in its text and set apart (.pt-hl), so the bullet reads at a glance
// (its text in one span, .pt-text: the bullet is a flex row, which would lay the pieces out as columns)
// Rotating end of the benefits heading: "A product expert that …".
const expertPhrases = ['never sleeps','gathers the data','spots the gains','proves the progress','opens new sales'];
// Chapter 1's paragraph as titled bullet steps in the globe card (shown one step at a time).
// Full stops (see CLAUDE.md): a headline of several sentences keeps them ("Ahead of the rules. Ahead of the rest.");
// a single-sentence headline, step title or eyebrow has none; bullets and body text are sentences and keep theirs.
const supplierSteps: { title: string; points: Point[] }[] = [
 { title: 'Stop chasing suppliers', points: [[FileSpreadsheet, '**No spreadsheets** or emails back and forth.']] },
 { title: 'Save time and effort', points: [[UserRoundPlus, '**Suppliers enter their data directly**, and get LCA data on their own products in return.']] },
 { title: 'Real risk assessments', points: [[ShieldAlert, '**Manage all tiers** in your supply chain and do real risk assessments.']] }
];
// Chapter 2's paragraph as titled bullet steps in its card.
const co2Steps: { title: string; points: Point[] }[] = [
 { title: 'Audit-ready by design', points: [[ClipboardCheck, 'Auditor-grade calculations built on **EN 15804+A2** and the ISO standards behind every EPD.']] },
 { title: 'Verified & validated', points: [[Award, 'The world’s first end-to-end verified tool for broad use: **EPD calculations in days, not months**.']] }
];
// Chapters with a small eyebrow (from the lead) above the headline (the title), like chapters 1 and 2.
const eyebrowChapters = ['analyse-improve', 'product-passports', 'beat-regulation'];
// Chapters whose paragraph is shown as check bullets.
// Each bullet carries an icon that leans into its text (lucide); the check mark remains the fallback in CSS.
type Point = [typeof Award, string, string]; // (icon, bullet, its short title for the story dot tooltip)
const chapterPoints: Record<string, Point[]> = {
 'beat-regulation': [
  [Flag, 'Get your Digital Product Passports in place early, and **outperform the competitors** still scrambling to catch up.', 'Get there early']
 ],
 'analyse-improve': [
  [ScanSearch, 'See what drives your impact, from materials to suppliers, and **improve your products with confidence**.', 'What drives your impact']
 ],
 'product-passports': [
  [QrCode, 'Every product gets a passport that stays up to date, one scan away, and **connects you directly** with the people who own it.', 'A direct line to every owner'],
  [Presentation, 'Give your sales team a story competitors can’t match, and **set the standard in your category**.', 'A story competitors can’t match']
 ]
};
// "Ahead of the rules": a background effect in the chapter's blue: the EU flag's twelve stars fly in from the
// right and settle into their circle, which sits low on the right so the stage edges cut it off.
const starPoints = Array.from({ length: 10 }, (_, i) => {
 const r = i % 2 ? 0.382 : 1;
 const t = (i * Math.PI) / 5 - Math.PI / 2;
 return `${(r * Math.cos(t)).toFixed(3)},${(r * Math.sin(t)).toFixed(3)}`;
}).join(' ');
const euStars = Array.from({ length: 12 }, (_, i) => {
 const t = (i * Math.PI) / 6;
 return {
  x: (50 + 40 * Math.sin(t)).toFixed(2),
  y: (50 - 40 * Math.cos(t)).toFixed(2),
  fx: 420 + ((i * 97) % 5) * 90,
  fy: Math.round((((i * 53) % 7) - 3) * 55),
  r: 140 + ((i * 37) % 4) * 45,
  a: (0.62 + ((i * 5) % 12) * 0.05).toFixed(3)
 };
});
// Each capability's visual inside the dome: three from their explainer sections on How it works (Product memory's
// chart, the Input interface's lens, the MCP graphic), two drawn for the story (model-scenes.ts), the chart with its key point (its
// section's headline) under it
const capKeys: Record<string, [string, string]> = {
 'product-memory': ['An EPD is a snapshot.', 'Your product model remembers.']
};
// the model story's chapter tabs (its menu along the top, like the What we solve story's): short names
const capTabs: Record<string, string> = { 'input-interface': 'Connected knowledge', integrations: 'Built to connect', 'product-memory': 'Full traceability', 'supply-chain': 'Mapped supply chain', impact: 'Live impact' };
const capabilities = [
 ['Connected knowledge. Better decisions.','3D models, materials, components, and specifications · connected in one scalable data foundation.','input-interface'],
 ['Built to connect','MCP access makes your product model available to AI tools and agents, with the context they need to work.','integrations'],
 ['Every change, traceable','A complete ledger of inputs, with timestamped field history. Know what changed, when, and where the data came from.','product-memory'],
 ['Your supply chain, mapped','Suppliers, components, and their relationships. Trace how every part connects to the finished product.','supply-chain'],
 ['Impact built into the model','Impact calculations connected directly to your product data, alongside emissions and scores.','impact'], // (no How it works section on impact yet)
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={pageDescription}/><SeoMeta title={pageTitle} description={pageDescription} /><link rel="icon" href={`${base}nextgen/favicon.svg`} type="image/svg+xml"/><link rel="icon" href={`${base}favicon-dark.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)"/><link rel="icon" href={`${base}favicon-light.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: light)"/><link rel="icon" href={`${base}favicon.ico`} sizes="48x48"/><link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}/><link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="theme-color" content="#ffffff"/><style is:inline set:html={`@font-face{font-family:Inter;src:url("${base}fonts/inter-latin.woff2") format("woff2");font-display:swap;font-weight:100 900}`} /><script is:inline>try{if(localStorage.getItem("pc-motion-paused")==="1")document.documentElement.classList.add("motion-paused")}catch(e){}</script></head>
<body><a class="skip" href="#main">Skip to content</a>
<SiteHeader theme="light" />
<main id="main"><section class="hero frame"><div class="hero-copy hero-chair"><picture class="hero-picture"><source media="(max-width:599px)" srcset={`${base}v4/hero-chair-mobile-828.webp 828w, ${base}v4/hero-chair-mobile-1242.webp 1242w`} sizes="100vw" width="828" height="1028"/><img class="hero-backdrop" src={`${base}v4/hero-chair-closeup.webp`} alt="" width="976" height="1098" fetchpriority="high"/></picture><div class="hero-editorial"><span class="eyebrow"><i></i> PRODUCT CONNECT</span><h1><span>Make better products,</span><span>show the world</span></h1><p>One platform for all your product data. Calculate CO₂ and environmental impact, track every improvement, and show the proof in next-generation <strong>Digital Product Passports.</strong></p><div class="actions"><a class="button" href={contact}>Talk to sales</a><a class="button primary" href={getStarted}>Start for free <ArrowIcon /></a></div></div><button class="chair-passport-trigger" type="button" tabindex="0" aria-haspopup="dialog" data-open-passport><span class="qr-badge" aria-hidden="true"><svg class="qr" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="6.5" height="6.5" rx="1.4"/><rect x="14" y="3.5" width="6.5" height="6.5" rx="1.4"/><rect x="3.5" y="14" width="6.5" height="6.5" rx="1.4"/><path d="M14 14h2.5v2.5M20.5 14v.01M14 20.5h2.5M20.5 17.5v3M18.5 20.5h.01M6.75 6.75h.01M17.25 6.75h.01M6.75 17.25h.01"/></svg></span><span>Explore its passport</span><ArrowIcon /></button></div></section>
<p class="eyebrow brand-eyebrow">Trusted with product data from circular market leaders</p>
<BrandStrip />
<section class="benefits benefits-intro frame" aria-label="What Product Connect does"><div class="section-intro"><span class="eyebrow">PRODUCT CONNECT</span><h2><span class="sr-only">A product expert that never sleeps. Gathers the data. Spots the gains. Proves the progress. Opens new sales.</span><i class="expert-line" aria-hidden="true">A product expert that <span class="expert-rotator" data-expert-rotator>{expertPhrases.map((phrase,i)=><span class:list={['expert-phrase',{'is-active':i===0}]}>{phrase}</span>)}</span></i></h2></div></section>
<section id="benefits" class="story-teaser teaser-globe" data-story-teaser="what-we-solve" aria-labelledby="teaser-globe-title"><div class="teaser-inner frame"><div class="teaser-copy"><p class="teaser-eyebrow">What we solve</p><h2 id="teaser-globe-title">From supplier data<br/><span>to new sales.</span></h2><p class="teaser-text">Learn how we turn your supply chain data into impact numbers you can trust and act on, and connect you with the people who own your products.</p><ul class="teaser-points"><li>Suppliers enter their data directly</li><li>Audit-ready EPD calculations</li><li>Passports that open new sales channels</li></ul><button type="button" class="teaser-open" data-story-open="what-we-solve">Experience the full story <ArrowIcon /></button></div><div class="teaser-visual globe-stage" role="img" aria-label="An interactive globe tracing one product's supply chain. Drag to turn it."><LazySupplyChainGlobe client:only="react" size={0.6} /></div></div></section>
<section id="benefits-story" class="benefits frame" data-story-takeover="what-we-solve" data-story-name="the What we solve story"><div class="benefit-layout"><aside class="benefit-nav"><nav aria-label="Product benefits">{benefits.map((b,i)=><a href={`#${b.id}`} data-benefit-link={b.id} aria-current={i===0?'location':undefined}><span class="nav-full">{b.label}</span><span class="nav-short">{b.short}</span><span class="nav-arrow" aria-hidden="true">↗︎</span></a>)}</nav><p>From product data<br/>to what comes next.</p></aside><div class="chapters"><div class="story-stage" data-story-stage><div class="story-bg" aria-hidden="true"></div><div class="story-tint" aria-hidden="true"></div>{benefits.map((b,i)=><section id={b.id} class="chapter" data-chapter><div class="chapter-pin">{i>1&&<div class="chapter-heading">{eyebrowChapters.includes(b.id) ? <><span class="chapter-eyebrow">{b.lead.replace(/\.$/,'')}</span><h3>{b.title.split(/(?<=\.) /).map((part, j) => j > 0 ? <><br/><span class="title-after">{part}</span></> : part)}</h3>{chapterPoints[b.id] ? <ul class="chapter-points">{chapterPoints[b.id].map(([Icon, p, title])=><li data-title={title}><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span><span class="pt-text">{p.split('**').map((part, j) => (j % 2 ? <strong class="pt-hl">{part}</strong> : part))}</span></li>)}</ul> : <p>{b.text}</p>}</> : <><h3>{b.title} <span>{b.lead}</span></h3><p>{b.text}</p>{i===1&&<small class="epd-process-note">EPD publication follows the applicable programme rules and independent verification.</small>}</>}</div>}
<div class:list={['ui-stage',`stage-${i}`]}>
{i===0&&<div class="hero-visual live-visual"><div class="window live-window"><div class="globe-intro"><h3 class="sr-only">Supply chain management</h3><span class="intro-eyebrow" aria-hidden="true">Supply chain management</span></div><div class="globe-points">{supplierSteps.map((step)=><div class="step"><p class="step-title">{step.title}</p>{step.points.map(([Icon, point])=><p class="sentence"><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span><span class="pt-text">{point.split('**').map((part, j) => (j % 2 ? <strong class="pt-hl">{part}</strong> : part))}</span></p>)}</div>)}</div><div class="globe-stage" role="img" aria-label="Interactive globe tracing one product's supply chain, from raw materials and component suppliers to the factory and the product owner"><LazySupplyChainGlobe client:only="react" size={0.655} /></div></div></div>}
{i===1&&<div class="co2-card"><div class="globe-intro co2-intro"><h3 class="sr-only">{b.title.replace(/\.$/, '')}</h3><span class="intro-eyebrow" aria-hidden="true">{b.title.replace(/\.$/, '')}</span></div><div class="globe-points co2-points">{co2Steps.map((step)=><div class="step"><p class="step-title">{step.title}</p>{step.points.map(([Icon, point])=><p class="sentence"><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span><span class="pt-text">{point.split('**').map((part, j) => (j % 2 ? <strong class="pt-hl">{part}</strong> : part))}</span></p>)}</div>)}</div><small class="co2-note">EPD publication follows the applicable programme rules and independent verification.</small><div class="co2-report-wrap"><span class="co2-illustrative" aria-hidden="true">Illustrative data</span><Co2Report /></div></div>}
{i===2&&<div class="screen-card compare"><div class="ui-bar"><span>Compare components</span><span class="pill">Illustrative data</span></div><div class="compare-body"><div class="product-thumb" data-reveal-at="0.62"><img src={`${base}v4/chair.webp`} width="640" height="427" alt="Oak chair used in the product comparison" loading="lazy"/><span>Cross Chair<small>Material comparison</small></span></div><div class="compare-grid"><div data-reveal-at="0.72"><small>Current material</small><h4>Oak / baseline</h4><strong>17.9 <em>kg CO₂e</em></strong><div class="compare-line"></div></div><div class="selected" data-reveal-at="1.22"><small>Alternative material</small><h4>Oak / scenario</h4><strong>14.2 <em>kg CO₂e</em></strong><div class="compare-line shorter"></div></div></div></div></div>}
{b.id==='beat-regulation'&&<div class="eu-flag" data-reveal-at="0.87" aria-hidden="true">{euStars.map((st)=><svg class="eu-star" viewBox="-1 -1 2 2" aria-hidden="true" style={`--x:${st.x}%;--y:${st.y}%;--fx:${st.fx}px;--fy:${st.fy}px;--r:${st.r}deg;--a:${st.a}`}><polygon points={starPoints} /></svg>)}</div>}
{i===3&&<div class="passport-composition"><div class="phone-live"><LazyPassportPhone client:only="react" /></div><small class="phone-caption">This passport is interactive. Enlarge it to explore.</small></div>}

</div><BenefitProof index={i} /></div></section>)}<StoryDotsNav class="benefit-dots-nav" before="Product Connect community" after="Dynamic Product Model"><ol class="benefit-dots" aria-hidden="true"></ol></StoryDotsNav></div><div class="story-markers" aria-hidden="true">{benefits.map((b)=><div class="story-marker" data-story-marker={b.id}></div>)}</div></div></div></section>

<section class="customer-story user-quote frame" aria-label="What our users say"><figure><svg class="quote-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/></svg><blockquote class="quote-balance">Adding data to Product Connect <span>reminds me of how it was to play ‘The Sims’</span></blockquote><figcaption class="quote-person"><img src={`${base}v4/alex-williamson.webp`} alt="" width="56" height="56" loading="lazy"/><span><strong>Alex Williamson</strong><small>Experience Sustainability Specialist · New Works</small></span></figcaption></figure></section>
<section id="product-model" class="story-teaser teaser-model model" data-story-teaser="product-model" aria-labelledby="teaser-model-title"><div class="model-inner frame"><div class="model-atmosphere"><div class="model-title"><p>Understand your products in a new way</p><h2 id="teaser-model-title">Dynamic Product Model</h2></div><div class="model-horizon data-sphere" role="img" aria-label="Data rains onto a spherical product model, connecting information across its surface"><canvas data-scene="sphere" aria-hidden="true"></canvas></div><div class="teaser-copy"><p class="teaser-text">Learn how one living model of your products <br class="dome-break"/>lets you work fast and see insights the moment your data changes.</p><button type="button" class="teaser-open" data-story-open="product-model">Experience the full story <ArrowIcon /></button></div></div></div></section>
<section class="model" id="product-model-story" data-story-takeover="product-model" data-story-name="the Dynamic Product Model story"><div class="model-inner frame"><div class="model-story" data-model-story><div class="model-pin"><nav class="model-tabs" aria-label="Dynamic Product Model chapters"><div class="model-tabs-row">{capabilities.map(([title,,anchor],i)=><button type="button" data-model-tab={i} aria-current={i===0?'step':undefined} title={title}>{capTabs[anchor] ?? title}</button>)}<span class="nav-dot" aria-hidden="true"></span></div></nav><div class="model-atmosphere"><div class="model-title"><p>Understand your products in a new way</p><h2>Dynamic Product Model</h2></div><div class="model-horizon data-sphere" role="img" aria-label="Data rains onto a spherical product model, connecting information across its surface"><canvas data-scene="sphere" aria-hidden="true"></canvas></div></div><div class="capabilities">{capabilities.map(([title,text,anchor],i)=><article style={`--i:${i}`}><h3>{title}</h3><p>{text}</p>{anchor === 'product-memory' && <div class="cap-visual cap-memory"><ProductMemory compact /></div>}{anchor === 'input-interface' && <div class="cap-visual cap-lens" role="img" aria-label="Incoming product data passes through our Input interface and converges at the Dynamic Product Model"><canvas data-scene="lens" data-rim aria-hidden="true"></canvas></div>}{anchor === 'integrations' && <div class="cap-visual cap-mcp"><McpGraphic /></div>}{anchor === 'supply-chain' && <div class="cap-visual cap-scene" role="img" aria-label="Materials, components and suppliers mapped into the finished product, one path traced at a time"><canvas data-scene="supply" aria-hidden="true"></canvas></div>}{anchor === 'impact' && <div class="cap-visual cap-scene" role="img" aria-label="Product data flows into the product model, which updates its impact breakdown by life cycle stage as changes come in (illustrative figures)"><canvas data-scene="impact" aria-hidden="true"></canvas></div>}{capKeys[anchor] && <p class="cap-key">{capKeys[anchor][0]} <span>{capKeys[anchor][1]}</span></p>}</article>)}</div><StoryDotsNav class="model-dots-nav" before="What we solve" after="Built for your team"><ol class="model-dots" aria-hidden="true">{capabilities.map(([title])=><li data-title={title}></li>)}</ol></StoryDotsNav></div></div></div></section>
{SHOW_DRAFT_TESTIMONIAL && <section class="customer-story frame" aria-label="Customer testimonial preview"><span class="tag">Testimonial · copy to be confirmed</span><blockquote>“A clearer picture of every product.<br/><span>A better foundation for what comes next.”</span></blockquote><img class="quote-portrait" src={`${base}v4/testimonial-portrait.webp`} alt="Fictional bearded man, placeholder portrait" width="80" height="80" loading="lazy"/><p class="quote-attribution">Mikkel Sørensen<small>Head of Design · Fjordform Studio, Denmark</small></p><p class="quote-note">Fictional testimonial, person and company for design preview.</p></section>}
<Scale />

<ClosingCta id="contact" text="Bring one of your products. We’ll walk through its data, its footprint and what its passport could look like." subject="Product Connect · Product demo" /></main><Footer />
<script>
import { motionPaused } from "../../utilities/motion";
import { glideToStep, registerSnapPoints } from "../../utilities/storySnap";
import { initStoryTakeovers } from "../../utilities/storyTakeover";
import { initReveal } from "../../utilities/reveal";
// the big stories wait behind their teasers, and take over the page when opened (utilities/storyTakeover.ts)
initStoryTakeovers();
initReveal(); // (the sections' text fades up into place as it is reached)
import { initDataScenes } from "./data-scenes";
const disposeScenes = initDataScenes();
document.addEventListener("astro:before-swap", disposeScenes, { once: true });
// Chapter tab row: one dot that slides under whichever item is current (the items' own ::after dot is the
// no-JS fallback). Follows aria-current, which the scroll code below sets.
{
 const nav = document.querySelector<HTMLElement>('.benefit-nav nav');
 if (nav) {
  const dot = document.createElement('span');
  dot.className = 'nav-dot';
  dot.setAttribute('aria-hidden', 'true');
  nav.append(dot);
  const place = () => {
   const current = nav.querySelector<HTMLElement>('a[aria-current]');
   if (!current) return;
   dot.style.transform = `translateX(${current.offsetLeft + current.offsetWidth / 2 - 2}px)`;
   // when the row is wider than the screen (phones), keep the current chapter centred in it
   if (nav.scrollWidth > nav.clientWidth + 1) {
    nav.scrollTo({ left: current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
   }
  };
  place();
  void dot.offsetWidth; // first placement without the slide
  nav.classList.add('has-dot');
  new MutationObserver(place).observe(nav, { subtree: true, attributeFilter: ['aria-current'] });
  new ResizeObserver(place).observe(nav);
 }
}
// Benefits heading: cycle the phrase after "A product expert that". The rotator's width follows the
// visible phrase, so the centred line re-centres smoothly (static first phrase with reduced motion).
const rotator = document.querySelector<HTMLElement>('[data-expert-rotator]');
if (rotator) {
 const phrases = Array.from(rotator.children) as HTMLElement[];
 let current = 0;
 const fit = () => { rotator.style.width = `${phrases[current].scrollWidth}px`; };
 fit();
 document.fonts?.ready.then(fit);
 window.addEventListener('resize', fit);
 if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const timer = window.setInterval(() => {
   if (document.hidden || document.documentElement.dataset.overlayOpen || motionPaused()) return; // paused by the footer toggle
   const previous = phrases[current];
   current = (current + 1) % phrases.length;
   previous.classList.remove('is-active');
   previous.classList.add('is-leaving');
   window.setTimeout(() => previous.classList.remove('is-leaving'), 700);
   phrases[current].classList.add('is-active');
   fit();
  }, 2600);
  document.addEventListener("astro:before-swap", () => window.clearInterval(timer), { once: true });
 }
}
