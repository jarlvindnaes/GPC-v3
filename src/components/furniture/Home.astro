---
import '../../index.css';
import './home.css';
import { PassportPhone } from '../wireframe/PassportPhone';
import Footer from './Footer.astro';
import SeoMeta from '../SeoMeta.astro';
import SiteHeader from '../SiteHeader.astro';
import Scale from './Scale.astro';
import BenefitProof from './BenefitProof.astro';
import BrandStrip from './BrandStrip.astro';
import Co2Report from './Co2Report.astro';
import { SupplyChainGlobe } from '../SupplyChainGlobe';
import { Award, ClipboardCheck, FileSpreadsheet, Flag, Gift, Landmark, MailX, Presentation, QrCode, ScanSearch, ShieldAlert, ShoppingBag, Timer, TrendingUp, UserRoundPlus, UsersRound } from 'lucide-react';
const base = import.meta.env.BASE_URL;
// Page title and description for search and link previews: Product Connect is for any physical product, not only furniture.
const pageTitle = 'Make better products, show the world · Product Connect';
const pageDescription = 'One platform for all your product data. Calculate CO₂ and environmental impact, track every improvement, and show the proof in next-generation Digital Product Passports.';
const contact = 'mailto:contact@productconnect.com';
const getStarted = 'mailto:contact@productconnect.com?subject=Getting%20started%20with%20Product%20Connect';
// The testimonial (portrait, person, company, quote) is a fictional placeholder; hidden until an approved one exists.
const SHOW_DRAFT_TESTIMONIAL = false;
const benefits = [
 {id:'harvest-data',short:'Suppliers',label:'Supplier data & management',title:'Stop chasing suppliers.',lead:'Save time and effort collecting data',text:'No spreadsheets, no emails back and forth. Suppliers onboard through a state-of-the-art experience and enter their data directly in the platform. Suppliers are rewarded for helping you out with LCA data on their own products.'},
 {id:'trusted-co2',short:'Emissions',label:'Trusted emission numbers',title:'Emission numbers you can trust.',lead:'EPD calculations in days, not months',text:'Auditor-grade calculations built on EN 15804+A2 and the ISO standards behind every EPD, verified and validated end to end. It’s a world first, and it cuts the whole EPD process from months to weeks.'},
 {id:'analyse-improve',short:'Analyse',label:'Analyse & improve',title:'Know exactly what to fix',lead:'Better scores, better products, more deals won.',text:'See where your impact really comes from, and what will move it most: a material, a component, a supplier. Improve your products and your supply chain with confidence, and bring better numbers to every tender.'},
 {id:'product-passports',short:'Passports',label:'Next-gen passports',title:'Show your impact to the world',lead:'Living Product Passports for B2B and B2C.',text:'Every product gets a passport that stays up to date: materials, impact, care and repair, one scan away. Give your sales team a story competitors can’t match, and set the standard in your category.'},
 {id:'connect-clients',short:'Sales',label:'Connect with clients',title:'Open new sales channels',lead:'Build tomorrow’s customer experience today.',text:'Our passport infrastructure connects you directly with the people who own your products. Sell spare parts, accessories and services, and create customer experiences your competitors can’t offer yet.'},
 {id:'beat-regulation',short:'EU rules',label:'Beat EU regulation',title:'Ahead of the rules. Ahead of the rest.',lead:'Compliant years before you have to be.',text:'New EU rules for product data and Digital Product Passports are on their way. Don’t scramble to keep up. Get there early, and outperform the competitors who are still catching up.'}
];
// Rotating end of the benefits heading: "A product expert that …".
const expertPhrases = ['never sleeps','gathers the data','spots the gains','proves the progress','opens new sales'];
// Chapter 1's paragraph as titled bullet steps in the globe card (shown one step at a time).
// Full stops (see CLAUDE.md): a headline of several sentences keeps them ("Ahead of the rules. Ahead of the rest.");
// a single-sentence headline, step title or eyebrow has none; bullets and body text are sentences and keep theirs.
const supplierSteps: { title: string; points: Point[] }[] = [
 { title: 'Stop chasing suppliers', points: [[FileSpreadsheet, 'No spreadsheets.'], [MailX, 'No emails back and forth.']] },
 { title: 'Save time and effort', points: [[UserRoundPlus, 'Suppliers onboard through a state-of-the-art experience and enter their data directly in the platform.'], [Gift, 'Suppliers are rewarded for helping you out with LCA data on their own products.']] },
 { title: 'Real risk assessments', points: [[ShieldAlert, 'Manage all tiers in your supply chain and do real risk assessments.']] }
];
// Chapter 2's paragraph as titled bullet steps in its card.
const co2Steps: { title: string; points: Point[] }[] = [
 { title: 'Audit-ready by design', points: [[ClipboardCheck, 'Auditor-grade calculations built on EN 15804+A2 and the ISO standards behind every EPD.']] },
 { title: 'Verified and validated end to end', points: [[Award, 'It’s a world first, and it cuts the whole EPD process from months to weeks.'], [Timer, 'EPD calculations in days, not months.']] }
];
// Chapters with a small eyebrow (from the lead) above the headline (the title), like chapters 1 and 2.
const eyebrowChapters = ['analyse-improve', 'product-passports', 'connect-clients', 'beat-regulation'];
// Chapters whose paragraph is shown as check bullets.
// Each bullet carries an icon that leans into its text (lucide); the check mark remains the fallback in CSS.
type Point = [typeof Award, string];
const chapterPoints: Record<string, Point[]> = {
 'beat-regulation': [
  [Landmark, 'New EU rules for product data and Digital Product Passports are on their way.'],
  [Flag, 'Don’t scramble to keep up. Get there early, and outperform the competitors who are still catching up.']
 ],
 'analyse-improve': [
  [ScanSearch, 'See where your impact really comes from, and what will move it most: a material, a component, a supplier.'],
  [TrendingUp, 'Improve your products and your supply chain with confidence, and bring better numbers to every tender.']
 ],
 'product-passports': [
  [QrCode, 'Every product gets a passport that stays up to date: materials, impact, care and repair, one scan away.'],
  [Presentation, 'Give your sales team a story competitors can’t match, and set the standard in your category.']
 ],
 'connect-clients': [
  [UsersRound, 'Our passport infrastructure connects you directly with the people who own your products.'],
  [ShoppingBag, 'Sell spare parts, accessories and services, and create customer experiences your competitors can’t offer yet.']
 ]
};
// "Ahead of the rules": a background effect in the chapter's blue: the EU flag's twelve stars fly in from the
// right and settle into their circle, which sits low on the right so the stage edges cut it off.
const starPoints = Array.from({ length: 10 }, (_, i) => {
 const r = i % 2 ? 0.382 : 1;
 const t = (i * Math.PI) / 5 - Math.PI / 2;
 return `${(r * Math.cos(t)).toFixed(3)},${(r * Math.sin(t)).toFixed(3)}`;
}).join(' ');
const euStars = Array.from({ length: 12 }, (_, i) => {
 const t = (i * Math.PI) / 6;
 return {
  x: (50 + 40 * Math.sin(t)).toFixed(2),
  y: (50 - 40 * Math.cos(t)).toFixed(2),
  fx: 420 + ((i * 97) % 5) * 90,
  fy: Math.round((((i * 53) % 7) - 3) * 55),
  r: 140 + ((i * 37) % 4) * 45,
  a: (0.62 + ((i * 5) % 12) * 0.05).toFixed(3)
 };
});
// Each capability's explainer section on How it works (its "Learn more" link).
const capabilities = [
 ['Every change, traceable','A complete ledger of inputs, with timestamped field history. Know what changed, when, and where the data came from.','product-memory'],
 ['Data in every dimension','3D models, materials, components, and specifications · connected in one scalable data foundation.','input-interface'],
 ['Your supply chain, mapped','Suppliers, components, and their relationships. Trace how every part connects to the finished product.','supply-chain'],
 ['Impact built into the model','Impact calculations connected directly to your product data, alongside emissions and scores.','provenance'],
 ['Built to connect','MCP access makes your product model available to AI tools and agents, with the context they need to work.','integrations']
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={pageDescription}/><SeoMeta title={pageTitle} description={pageDescription} /><link rel="icon" href={`${base}nextgen/favicon.svg`} type="image/svg+xml"/><link rel="icon" href={`${base}favicon-dark.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)"/><link rel="icon" href={`${base}favicon-light.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: light)"/><link rel="icon" href={`${base}favicon.ico`} sizes="48x48"/><link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}/><link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="theme-color" content="#ffffff"/><style is:inline set:html={`@font-face{font-family:Inter;src:url("${base}fonts/inter-latin.woff2") format("woff2");font-display:swap;font-weight:100 900}`} /><script is:inline>try{if(localStorage.getItem("pc-motion-paused")==="1")document.documentElement.classList.add("motion-paused")}catch(e){}</script></head>
<body><a class="skip" href="#main">Skip to content</a>
<SiteHeader theme="light" />
<main id="main"><section class="hero frame"><div class="hero-copy hero-chair"><picture class="hero-picture"><source media="(max-width:599px)" srcset={`${base}v4/hero-chair-mobile-828.webp 828w, ${base}v4/hero-chair-mobile-1242.webp 1242w`} sizes="100vw" width="828" height="1028"/><img class="hero-backdrop" src={`${base}v4/hero-chair-closeup.webp`} alt="" width="976" height="1098" fetchpriority="high"/></picture><div class="hero-editorial"><span class="eyebrow"><i></i> PRODUCT CONNECT</span><h1><span>Make better products,</span><span>show the world</span></h1><p>One platform for all your product data. Calculate CO₂ and environmental impact, track every improvement, and show the proof in next-generation <strong>Digital Product Passports.</strong></p><div class="actions"><a class="button" href={contact}>Talk to sales</a><a class="button primary" href={getStarted}>Start for free <span>↗︎</span></a></div></div><button class="chair-passport-trigger" type="button" data-open-passport><span class="qr-badge" aria-hidden="true"><svg class="qr" viewBox="0 0 25 25" aria-hidden="true" shape-rendering="crispEdges"><path stroke="currentColor" d="M0 0.5h7m1 0h2m3 0h1m2 0h1m1 0h7M0 1.5h1m5 0h1m6 0h1m2 0h1m1 0h1m5 0h1M0 2.5h1m1 0h3m1 0h1m1 0h1m2 0h3m1 0h1m2 0h1m1 0h3m1 0h1M0 3.5h1m1 0h3m1 0h1m1 0h2m1 0h1m1 0h2m3 0h1m1 0h3m1 0h1M0 4.5h1m1 0h3m1 0h1m1 0h4m1 0h4m1 0h1m1 0h3m1 0h1M0 5.5h1m5 0h1m2 0h1m2 0h1m1 0h1m3 0h1m5 0h1M0 6.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M9 7.5h1m1 0h1m2 0h2M0 8.5h4m2 0h1m1 0h1m5 0h1m1 0h2m2 0h3m1 0h1M0 9.5h2m3 0h1m1 0h1m1 0h1m6 0h2m1 0h1m3 0h1M1 10.5h7m9 0h1m2 0h1M1 11.5h1m1 0h1m1 0h1m1 0h1m3 0h4m3 0h2m1 0h2M0 12.5h3m2 0h5m1 0h10m1 0h3M1 13.5h1m1 0h2m5 0h2m2 0h7m3 0h1M1 14.5h2m1 0h1m1 0h2m1 0h1m2 0h1m4 0h2m1 0h1m1 0h2M0 15.5h1m1 0h4m1 0h1m1 0h2m3 0h1m2 0h1m1 0h2m3 0h1M3 16.5h1m2 0h1m3 0h1m2 0h1m2 0h9M8 17.5h1m2 0h4m1 0h1m3 0h1m1 0h1m1 0h1M0 18.5h7m3 0h1m3 0h1m1 0h1m1 0h1m1 0h1m1 0h3M0 19.5h1m5 0h1m2 0h2m1 0h1m1 0h3m3 0h1m2 0h2M0 20.5h1m1 0h3m1 0h1m3 0h2m4 0h6m2 0h1M0 21.5h1m1 0h3m1 0h1m1 0h1m1 0h2m1 0h1m3 0h2m1 0h5M0 22.5h1m1 0h3m1 0h1m1 0h1m2 0h3m1 0h1m1 0h2m1 0h1m1 0h2M0 23.5h1m5 0h1m1 0h1m1 0h2m1 0h1m1 0h1m1 0h1m2 0h1m1 0h1M0 24.5h7m1 0h2m2 0h3m3 0h7"/></svg></span><span>Explore its passport ↗︎</span></button></div></section>
<p class="eyebrow brand-eyebrow">Trusted with product data from circular market leaders</p>
<BrandStrip />
<section id="benefits" class="benefits frame"><div class="section-intro"><span class="eyebrow">PRODUCT CONNECT</span><h2><span class="sr-only">A product expert that never sleeps. Gathers the data. Spots the gains. Proves the progress. Opens new sales.</span><i class="expert-line" aria-hidden="true">A product expert that <span class="expert-rotator" data-expert-rotator>{expertPhrases.map((phrase,i)=><span class:list={['expert-phrase',{'is-active':i===0}]}>{phrase}</span>)}</span></i></h2></div><div class="benefit-layout"><aside class="benefit-nav"><nav aria-label="Product benefits">{benefits.map((b,i)=><a href={`#${b.id}`} data-benefit-link={b.id} aria-current={i===0?'location':undefined}><span class="nav-full">{b.label}</span><span class="nav-short">{b.short}</span><span class="nav-arrow">↗︎</span></a>)}</nav><p>From product data<br/>to what comes next.</p></aside><div class="chapters"><div class="story-stage" data-story-stage><div class="story-tint" aria-hidden="true"></div>{benefits.map((b,i)=><section id={b.id} class="chapter" data-chapter><div class="chapter-pin">{i>1&&<div class="chapter-heading">{eyebrowChapters.includes(b.id) ? <>{b.id==='connect-clients'&&<span class="coming">Coming this spring</span>}<span class="chapter-eyebrow">{b.lead.replace(/\.$/,'')}</span><h3>{b.title}</h3>{chapterPoints[b.id] ? <ul class="chapter-points">{chapterPoints[b.id].map(([Icon, p])=><li><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span>{p}</li>)}</ul> : <p>{b.text}</p>}{b.id==='product-passports'&&<small class="phone-caption">The passport displayed on this 3D model is interactive. You can enlarge it to really engage with its content.</small>}</> : <>{b.id==='connect-clients'&&<span class="coming">Coming this spring</span>}<h3>{b.title} <span>{b.lead}</span></h3><p>{b.text}</p>{i===1&&<small class="epd-process-note">EPD publication follows the applicable programme rules and independent verification.</small>}</>}</div>}
<div class:list={['ui-stage',`stage-${i}`]}>
{i===0&&<div class="hero-visual live-visual"><div class="window live-window"><div class="globe-intro"><h3 class="sr-only">Supply chain management</h3><span class="intro-eyebrow" aria-hidden="true">Supply chain management</span></div><div class="globe-points">{supplierSteps.map((step)=><div class="step"><p class="step-title">{step.title}</p>{step.points.map(([Icon, point])=><p class="sentence"><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span>{point}</p>)}</div>)}</div><div class="globe-stage" role="img" aria-label="Interactive globe tracing one product's supply chain, from raw materials and component suppliers to the factory and the product owner"><SupplyChainGlobe client:only="react" size={0.655} /></div></div></div>}
{i===1&&<div class="co2-card"><div class="globe-intro co2-intro"><h3 class="sr-only">{b.title.replace(/\.$/, '')}</h3><span class="intro-eyebrow" aria-hidden="true">{b.title.replace(/\.$/, '')}</span></div><div class="globe-points co2-points">{co2Steps.map((step)=><div class="step"><p class="step-title">{step.title}</p>{step.points.map(([Icon, point])=><p class="sentence"><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span>{point}</p>)}</div>)}</div><small class="co2-note">EPD publication follows the applicable programme rules and independent verification.</small><div class="co2-report-wrap"><Co2Report /></div></div>}
{i===2&&<div class="screen-card compare"><div class="ui-bar"><span>Compare components</span><span class="pill">Illustrative data</span></div><div class="compare-body"><div class="product-thumb"><img src={`${base}v4/chair.webp`} width="640" height="427" alt="Oak chair used in the product comparison" loading="lazy"/><span>Cross Chair<small>Material comparison</small></span></div><div class="compare-grid"><div><small>Current material</small><h4>Oak / baseline</h4><strong>17.9 <em>kg CO₂e</em></strong><div class="compare-line"></div></div><div class="selected"><small>Alternative material</small><h4>Oak / scenario</h4><strong>14.2 <em>kg CO₂e</em></strong><div class="compare-line shorter"></div></div></div><div class="ui-footer">Materials <span>→</span> Components <span>→</span> Better decisions</div></div></div>}
{b.id==='beat-regulation'&&<div class="eu-flag" aria-hidden="true">{euStars.map((st)=><svg class="eu-star" viewBox="-1 -1 2 2" aria-hidden="true" style={`--x:${st.x}%;--y:${st.y}%;--fx:${st.fx}px;--fy:${st.fy}px;--r:${st.r}deg;--a:${st.a}`}><polygon points={starPoints} /></svg>)}</div>}
{i===3&&<div class="passport-composition"><div class="phone-live"><PassportPhone client:only="react" /></div></div>}
{b.id==='connect-clients'&&<div class="screen-card report"><div class="ui-bar"><span>◈ Customer channel</span><span class="pill">Coming this spring</span></div><div class="report-body"><span class="report-label">CROSS CHAIR / AFTER THE SALE</span><h4>Every passport,<br/>a storefront</h4><div class="record"><span class="check">✓</span><span>Spare parts, matched to the exact product</span></div><div class="record"><span class="check">✓</span><span>Accessories and upgrades</span></div><div class="record"><span class="check">✓</span><span>Care and repair services</span></div><div class="record"><span class="check">✓</span><span>A direct line to every product owner</span></div></div></div>}
</div><BenefitProof index={i} /></div></section>)}</div><div class="story-markers" aria-hidden="true">{benefits.map((b)=><div class="story-marker" data-story-marker={b.id}></div>)}</div></div></div></section>

<section class="model" id="product-model"><div class="model-inner frame"><div class="model-story" data-model-story><div class="model-pin"><div class="model-atmosphere"><div class="model-title"><p>A new way to understand your products.</p><h2>Dynamic Product Model</h2></div><div class="model-horizon data-sphere" role="img" aria-label="Data rains onto a spherical product model, connecting information across its surface"><canvas data-scene="sphere" aria-hidden="true"></canvas></div></div><div class="capabilities">{capabilities.map(([title,text,anchor],i)=><article style={`--i:${i}`}><span class="cap-icon">{['▤','◎','◈','⌁','⌘'][i]}</span><h3>{title}</h3><p>{text}</p><a class="button dark-button cap-link" href={`${base}how-it-works/#${anchor}`}>Learn more<span class="sr-only"> about {title.toLowerCase()}</span> <span aria-hidden="true">↗︎</span></a></article>)}</div><ol class="model-dots" aria-hidden="true">{capabilities.map(()=><li></li>)}</ol></div></div></div></section>
{SHOW_DRAFT_TESTIMONIAL && <section class="customer-story frame" aria-label="Customer testimonial preview"><span class="tag">Testimonial · copy to be confirmed</span><blockquote>“A clearer picture of every product.<br/><span>A better foundation for what comes next.”</span></blockquote><img class="quote-portrait" src={`${base}v4/testimonial-portrait.webp`} alt="Fictional bearded man, placeholder portrait" width="80" height="80" loading="lazy"/><p class="quote-attribution">Mikkel Sørensen<small>Head of Design · Fjordform Studio, Denmark</small></p><p class="quote-note">Fictional testimonial, person and company for design preview.</p></section>}
<Scale />

<section class="closing frame"><span class="eyebrow">PRODUCT CONNECT</span><h2>Your products have more potential.<br/><span>Put it to work.</span></h2><div class="actions"><a class="button" href={contact}>Talk to sales</a><a class="button primary" href={getStarted}>Start for free <span>↗︎</span></a></div></section></main><Footer />
<script>
import { motionPaused } from "../../utilities/motion";
import { initDataScenes } from "./data-scenes";
const disposeScenes = initDataScenes();
document.addEventListener("astro:before-swap", disposeScenes, { once: true });
// Chapter tab row: one dot that slides under whichever item is current (the items' own ::after dot is the
// no-JS fallback). Follows aria-current, which the scroll code below sets.
{
 const nav = document.querySelector<HTMLElement>('.benefit-nav nav');
 if (nav) {
  const dot = document.createElement('span');
  dot.className = 'nav-dot';
  dot.setAttribute('aria-hidden', 'true');
  nav.append(dot);
  const place = () => {
   const current = nav.querySelector<HTMLElement>('a[aria-current]');
   if (!current) return;
   dot.style.transform = `translateX(${current.offsetLeft + current.offsetWidth / 2 - 2}px)`;
   // when the row is wider than the screen (phones), keep the current chapter centred in it
   if (nav.scrollWidth > nav.clientWidth + 1) {
    nav.scrollTo({ left: current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
   }
  };
  place();
  void dot.offsetWidth; // first placement without the slide
  nav.classList.add('has-dot');
  new MutationObserver(place).observe(nav, { subtree: true, attributeFilter: ['aria-current'] });
  new ResizeObserver(place).observe(nav);
 }
}
// Benefits heading: cycle the phrase after "A product expert that". The rotator's width follows the
// visible phrase, so the centred line re-centres smoothly (static first phrase with reduced motion).
const rotator = document.querySelector<HTMLElement>('[data-expert-rotator]');
if (rotator) {
 const phrases = Array.from(rotator.children) as HTMLElement[];
 let current = 0;
 const fit = () => { rotator.style.width = `${phrases[current].scrollWidth}px`; };
 fit();
 document.fonts?.ready.then(fit);
 window.addEventListener('resize', fit);
 if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const timer = window.setInterval(() => {
   if (document.hidden || document.documentElement.dataset.overlayOpen || motionPaused()) return; // paused by the footer toggle
   const previous = phrases[current];
   current = (current + 1) % phrases.length;
   previous.classList.remove('is-active');
   previous.classList.add('is-leaving');
   window.setTimeout(() => previous.classList.remove('is-leaving'), 700);
   phrases[current].classList.add('is-active');
   fit();
  }, 2600);
  document.addEventListener("astro:before-swap", () => window.clearInterval(timer), { once: true });
 }
}
// Benefits scroll story: ONE stage. On desktop the six chapters are layers of a single sticky stage
// (html.story-stage); the page scrolls past invisible markers (one per chapter, sized in home.css) and each
// chapter's --k runs 0 -> 2 over its own marker: 0 -> 1 arriving (elements fly in), 1 -> 2 its steps play;
// at 2 it fades out as the next one arrives. The stage background fades from dark to light as chapter 3
// arrives (--dark). Phones / short screens keep the stacked chapters with the same reveals (k from each
// chapter's own position). CSS turns --k into the reveals (home.css "Scroll story" / "One stage").
if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
 const storyChapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
 const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-story-marker]'));
 const stage = document.querySelector<HTMLElement>('[data-story-stage]');
 const tabRow = document.querySelector<HTMLElement>('.benefit-nav');
 const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
 const storyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-benefit-link]'));
 // The stage sits right under the chapter menu: --tab-row follows the menu's real height (it changes with the
 // labels and screen size), so no strip of page shows between them.
 if (tabRow) {
  const syncTabRow = () => document.documentElement.style.setProperty('--tab-row', `${tabRow.offsetHeight}px`);
  new ResizeObserver(syncTabRow).observe(tabRow);
  syncTabRow();
 }
 const stageQuery = matchMedia('(min-height: 600px)'); // pinned story on any screen tall enough (phones in portrait too); short screens stack
 const ARRIVE = 0.4; // share of the screen height each later chapter spends arriving
 const OVERLAP = 0.22; // ...starting this much (share of the screen height) before the previous one has left, so they crossfade
 // Each later chapter starts arriving a little before the previous one has finished fading out (a true crossfade,
 // no blank moment); the CO₂ chapter (index 1) much earlier, while the supplier globe's last stars are still
 // drifting away. Each still ends where it did (its own scroll is stretched by the same amount).
 const overlapFor = (i: number) => (i === 1 ? 1.0 : OVERLAP + 0.15);
 document.documentElement.classList.add('story-on');
 const clamp = (v: number) => Math.min(1, Math.max(0, v));
 const pinLineNow = () => Math.max(0, siteHeader?.getBoundingClientRect().bottom ?? 0) + (tabRow?.offsetHeight ?? 53);
 let shownPassportTab = 'about';
 let harvestExit = 0;
 let shownPassportPart: string | null = null;
 let wantedPassportPart: string | null = null;
 let wantedPassportZoom = 1;
 let shownPassportShift = 0;
