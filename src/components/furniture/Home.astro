---
import ArrowIcon from '../ArrowIcon.astro';
import '../../index.css';
import './home.css';
import '../../styles/typography.css';
import '../../styles/story-teaser.css';
import { LazyPassportPhone, LazySupplyChainGlobe } from '../LazyIslands';
import Footer from './Footer.astro';
import ClosingCta from '../ClosingCta.astro';
import SeoMeta from '../SeoMeta.astro';
import SiteHeader from '../SiteHeader.astro';
import StoryDotsNav from '../StoryDotsNav.astro';
import HeroDataQuality from './HeroDataQuality.astro';
import BenefitProof from './BenefitProof.astro';
import BrandStrip from './BrandStrip.astro';
import HelpSection from './HelpSection.astro';
import DataNodes from './DataNodes.astro';
import QuoteCarousel from './QuoteCarousel.astro';
import Co2Report from './Co2Report.astro';
import { Award, ClipboardCheck, FileSpreadsheet, Presentation, QrCode, ScanSearch, ShieldAlert, UserRoundPlus } from 'lucide-react';
const base = import.meta.env.BASE_URL;
// Page title and description for search and link previews: Product Connect is for any physical product, not only furniture.
const pageTitle = 'Your product data finally has a home · Product Connect';
const pageDescription = 'Product data for manufacturers. Product Connect brings every component, material and supplier into one model, so design, sourcing, sales and sustainability all work from the same truth.';
const contact = 'mailto:contact@productconnect.com';
const walkthrough = 'mailto:contact@productconnect.com?subject=Book%20a%20Product%20Connect%20walkthrough';
// The testimonial (portrait, person, company, quote) is a fictional placeholder; hidden until an approved one exists.
const SHOW_DRAFT_TESTIMONIAL = false;
const benefits = [
 // The four pillars, one per buyer function. (Order follows the scroll story's colour hand-offs: globe, report, comparison, passport.)
 {id:'harvest-data',short:'Supply chain',label:'Run a sharper supply chain',title:'Stop chasing suppliers.',lead:'Every tier mapped',text:'Suppliers enter their own data, and every tier of your supply chain is mapped, so risk and changes are visible.'},
 {id:'trusted-co2',short:'Compliance',label:'Be ready for any ask',title:'Ready for any ask.',lead:'Days, not months',text:'When someone asks for an EPD, a CO₂ number or a passport, the data is already there. New EU rules are covered too.'},
 {id:'analyse-improve',short:'Products',label:'Build better products',title:'Build better products',lead:'See what drives cost and impact.',text:'See what every component costs in material, supplier and impact, and compare alternatives before you commit.'},
 {id:'product-passports',short:'Sales',label:'Sell with proof',title:'Sell with proof',lead:'Answers in minutes, not weeks.',text:'Answer spec requests, tenders and customer questions in minutes, and give every product a passport that connects you to its owner.'}
];
// A bullet's key phrase is marked **like this** in its text and set apart (.pt-hl), so the bullet reads at a glance
// (its text in one span, .pt-text: the bullet is a flex row, which would lay the pieces out as columns)
// Chapter 1's paragraph as titled bullet steps in the globe card (shown one step at a time).
// Full stops (see CLAUDE.md): a headline of several sentences keeps them ("Ahead of the rules. Ahead of the rest.");
// a single-sentence headline, step title or eyebrow has none; bullets and body text are sentences and keep theirs.
const supplierSteps: { title: string; points: Point[] }[] = [
 { title: 'Stop chasing suppliers', points: [[FileSpreadsheet, '**No spreadsheets** or emails back and forth.']] },
 { title: 'Save time and effort', points: [[UserRoundPlus, '**Suppliers enter their data directly**, and get LCA data on their own products in return.']] },
 { title: 'Real risk assessments', points: [[ShieldAlert, '**Manage all tiers** in your supply chain and do real risk assessments.']] }
];
// Chapter 2's paragraph as titled bullet steps in its card.
const co2Steps: { title: string; points: Point[] }[] = [
 { title: 'Audit-ready by design', points: [[ClipboardCheck, 'Calculations on **EN 15804+A2** and the ISO standards behind every EPD, built to be verified end to end.']] },
 { title: 'Days, not months', points: [[Award, 'When someone asks for an EPD, a CO₂ number or a passport, **the data is already there**. New EU rules are covered too.']] }
];
// Chapters with a small eyebrow (from the lead) above the headline (the title), like chapters 1 and 2.
const eyebrowChapters = ['analyse-improve', 'product-passports'];
// Chapters whose paragraph is shown as check bullets.
// Each bullet carries an icon that leans into its text (lucide); the check mark remains the fallback in CSS.
type Point = [typeof Award, string, string]; // (icon, bullet, its short title for the story dot tooltip)
const chapterPoints: Record<string, Point[]> = {
 'analyse-improve': [
  [ScanSearch, 'See what every component costs in material, supplier and impact, and **compare alternatives before you commit**.', 'Compare before you commit']
 ],
 'product-passports': [
  [Presentation, 'Answer spec requests, tenders and customer questions **in minutes**, from the same product data.', 'Answers in minutes'],
  [QrCode, 'Every product gets a passport, one scan away, that **connects you directly** with the people who own it.', 'A direct line to every owner']
 ]
};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={pageDescription}/><SeoMeta title={pageTitle} description={pageDescription} /><link rel="icon" href={`${base}nextgen/favicon.svg`} type="image/svg+xml"/><link rel="icon" href={`${base}favicon-dark.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)"/><link rel="icon" href={`${base}favicon-light.png`} type="image/png" sizes="32x32" media="(prefers-color-scheme: light)"/><link rel="icon" href={`${base}favicon.ico`} sizes="48x48"/><link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}/><link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="theme-color" content="#ffffff"/><style is:inline set:html={`@font-face{font-family:Inter;src:url("${base}fonts/inter-latin.woff2") format("woff2");font-display:swap;font-weight:100 900}`} /><script is:inline>try{if(localStorage.getItem("pc-motion-paused")==="1")document.documentElement.classList.add("motion-paused")}catch(e){}</script></head>
<body><a class="skip" href="#main">Skip to content</a>
<SiteHeader theme="light" cta="Book a walkthrough" ctaHref={walkthrough} />
<main id="main"><section class="hero hero-space hero-light" aria-labelledby="hero-title"><div class="hero-space-stage" aria-hidden="true"><HeroDataQuality /></div><div class="hero-space-inner"><div class="hero-editorial"><span class="eyebrow"><i></i> Product data for manufacturers</span><h1 id="hero-title"><span>Your product data</span><span>finally has a home</span></h1><p class="hero-body">Right now it’s probably a mess. Everyone’s is. Product Connect brings every component, material and supplier into one model, so design, sourcing, sales and sustainability all work from the same truth.</p><div class="actions"><a class="button primary" href="#benefits-story">See how it works <ArrowIcon /></a><a class="hero-textlink" href={walkthrough}>Book a walkthrough</a></div></div></div><p class="sr-only">Illustration: raw product data from suppliers, spreadsheets, the ERP and 3D models is distilled into clean values and approved into one product record with a quality score.</p></section>
<p class="eyebrow brand-eyebrow">Trusted by market leaders</p>
<BrandStrip />
<HelpSection />
<DataNodes />
<section id="benefits" class="story-teaser teaser-globe" data-story-teaser="what-we-solve" aria-labelledby="teaser-globe-title"><div class="teaser-inner frame"><div class="teaser-copy"><p class="teaser-eyebrow">What we solve</p><h2 id="teaser-globe-title">From supplier data<br/><span>to new sales.</span></h2><p class="teaser-text">Turn your supply chain data into decisions every team can act on: better products, steadier sourcing, and a sales story competitors can’t match.</p><button type="button" class="teaser-open" data-story-open="what-we-solve">Experience the full story <ArrowIcon /></button></div><div class="teaser-visual globe-stage" role="img" aria-label="An interactive globe tracing one product's supply chain. Drag to turn it."><LazySupplyChainGlobe client:only="react" size={0.6} /></div></div></section>
<section id="benefits-story" class="benefits frame" data-story-takeover="what-we-solve" data-story-name="the What we solve story"><div class="benefit-layout"><aside class="benefit-nav"><nav aria-label="Product benefits">{benefits.map((b,i)=><a href={`#${b.id}`} data-benefit-link={b.id} aria-current={i===0?'location':undefined}><span class="nav-full">{b.label}</span><span class="nav-short">{b.short}</span><span class="nav-arrow" aria-hidden="true">↗︎</span></a>)}</nav><p>From product data<br/>to what comes next.</p></aside><div class="chapters"><div class="story-stage" data-story-stage><div class="story-bg" aria-hidden="true"></div><div class="story-tint" aria-hidden="true"></div>{benefits.map((b,i)=><section id={b.id} class="chapter" data-chapter><div class="chapter-pin">{i>1&&<div class="chapter-heading">{eyebrowChapters.includes(b.id) ? <><span class="chapter-eyebrow">{b.lead.replace(/\.$/,'')}</span><h3>{b.title.split(/(?<=\.) /).map((part, j) => j > 0 ? <><br/><span class="title-after">{part}</span></> : part)}</h3>{chapterPoints[b.id] ? <ul class="chapter-points">{chapterPoints[b.id].map(([Icon, p, title])=><li data-title={title}><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span><span class="pt-text">{p.split('**').map((part, j) => (j % 2 ? <strong class="pt-hl">{part}</strong> : part))}</span></li>)}</ul> : <p>{b.text}</p>}</> : <><h3>{b.title} <span>{b.lead}</span></h3><p>{b.text}</p>{i===1&&<small class="epd-process-note">EPD publication follows the applicable programme rules and independent verification.</small>}</>}</div>}
<div class:list={['ui-stage',`stage-${i}`]}>
{i===0&&<div class="hero-visual live-visual"><div class="window live-window"><div class="globe-intro"><h3 class="sr-only">Supply chain management</h3><span class="intro-eyebrow" aria-hidden="true">Supply chain management</span></div><div class="globe-points">{supplierSteps.map((step)=><div class="step"><p class="step-title">{step.title}</p>{step.points.map(([Icon, point])=><p class="sentence"><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span><span class="pt-text">{point.split('**').map((part, j) => (j % 2 ? <strong class="pt-hl">{part}</strong> : part))}</span></p>)}</div>)}</div><div class="globe-stage" role="img" aria-label="Interactive globe tracing one product's supply chain, from raw materials and component suppliers to the factory and the product owner"><LazySupplyChainGlobe client:only="react" size={0.655} /></div></div></div>}
{i===1&&<div class="co2-card"><div class="globe-intro co2-intro"><h3 class="sr-only">{b.title.replace(/\.$/, '')}</h3><span class="intro-eyebrow" aria-hidden="true">{b.title.replace(/\.$/, '')}</span></div><div class="globe-points co2-points">{co2Steps.map((step)=><div class="step"><p class="step-title">{step.title}</p>{step.points.map(([Icon, point])=><p class="sentence"><span class="pt-icon" aria-hidden="true"><Icon size={13} strokeWidth={1.8} /></span><span class="pt-text">{point.split('**').map((part, j) => (j % 2 ? <strong class="pt-hl">{part}</strong> : part))}</span></p>)}</div>)}</div><small class="co2-note">EPD publication follows the applicable programme rules and independent verification.</small><div class="co2-report-wrap"><span class="co2-illustrative" aria-hidden="true">Illustrative data</span><Co2Report /></div></div>}
{i===2&&<div class="screen-card compare"><div class="ui-bar"><span>Compare components</span><span class="pill">Illustrative data</span></div><div class="compare-body"><div class="product-thumb" data-reveal-at="0.62"><img src={`${base}v4/chair.webp`} width="640" height="427" alt="Oak chair used in the product comparison" loading="lazy"/><span>Cross Chair<small>Material comparison</small></span></div><div class="compare-grid"><div data-reveal-at="0.72"><small>Current material</small><h4>Oak / baseline</h4><strong>17.9 <em>kg CO₂e</em></strong><div class="compare-line"></div></div><div class="selected" data-reveal-at="1.22"><small>Alternative material</small><h4>Oak / scenario</h4><strong>14.2 <em>kg CO₂e</em></strong><div class="compare-line shorter"></div></div></div></div></div>}
{i===3&&<div class="passport-composition"><div class="phone-live"><LazyPassportPhone client:only="react" /></div><small class="phone-caption">This passport is interactive. Enlarge it to explore.</small></div>}

</div><BenefitProof index={i} /></div></section>)}<StoryDotsNav class="benefit-dots-nav" before="Product Connect community" after="Dynamic Product Model"><ol class="benefit-dots" aria-hidden="true"></ol></StoryDotsNav></div><div class="story-markers" aria-hidden="true">{benefits.map((b)=><div class="story-marker" data-story-marker={b.id}></div>)}</div></div></div></section>

<QuoteCarousel />
<section id="product-model" class="story-teaser teaser-model model" aria-labelledby="teaser-model-title"><div class="model-inner frame"><div class="model-atmosphere"><div class="model-title"><p>Understand your products in a new way</p><h2 id="teaser-model-title">Dynamic Product Model</h2></div><div class="model-horizon data-sphere" role="img" aria-label="Data rains onto a spherical product model, connecting information across its surface"><canvas data-scene="sphere" aria-hidden="true"></canvas></div><div class="teaser-copy"><p class="teaser-text">One living model of every product, <br class="dome-break"/>ready for your systems and AI tools.</p><a class="teaser-open" href={`${base}product-model/`}>Explore the product model <ArrowIcon /></a></div></div></div></section>
{SHOW_DRAFT_TESTIMONIAL && <section class="customer-story frame" aria-label="Customer testimonial preview"><span class="tag">Testimonial · copy to be confirmed</span><blockquote>“A clearer picture of every product.<br/><span>A better foundation for what comes next.”</span></blockquote><img class="quote-portrait" src={`${base}v4/testimonial-portrait.webp`} alt="Fictional bearded man, placeholder portrait" width="80" height="80" loading="lazy"/><p class="quote-attribution">Mikkel Sørensen<small>Head of Design · Fjordform Studio, Denmark</small></p><p class="quote-note">Fictional testimonial, person and company for design preview.</p></section>}

<ClosingCta id="contact" text="Bring one of your products. We’ll show you what it looks like with every component, supplier and number in one place, and what your teams could do with it." subject="Product Connect · Product demo" /></main><Footer />
<script>
import { motionPaused } from "../../utilities/motion";
import { glideToStep, registerSnapPoints } from "../../utilities/storySnap";
import { initStoryTakeovers } from "../../utilities/storyTakeover";
import { initReveal } from "../../utilities/reveal";
// the big stories wait behind their teasers, and take over the page when opened (utilities/storyTakeover.ts)
initStoryTakeovers();
initReveal(); // (the sections' text fades up into place as it is reached)
import { initDataScenes } from "./data-scenes";
const disposeScenes = initDataScenes();
document.addEventListener("astro:before-swap", disposeScenes, { once: true });
// Chapter tab row: one dot that slides under whichever item is current (the items' own ::after dot is the
// no-JS fallback). Follows aria-current, which the scroll code below sets.
{
 const nav = document.querySelector<HTMLElement>('.benefit-nav nav');
 if (nav) {
  const dot = document.createElement('span');
  dot.className = 'nav-dot';
  dot.setAttribute('aria-hidden', 'true');
  nav.append(dot);
  const place = () => {
   const current = nav.querySelector<HTMLElement>('a[aria-current]');
   if (!current) return;
   dot.style.transform = `translateX(${current.offsetLeft + current.offsetWidth / 2 - 2}px)`;
   // when the row is wider than the screen (phones), keep the current chapter centred in it
   if (nav.scrollWidth > nav.clientWidth + 1) {
    nav.scrollTo({ left: current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
   }
  };
  place();
  void dot.offsetWidth; // first placement without the slide
  nav.classList.add('has-dot');
  new MutationObserver(place).observe(nav, { subtree: true, attributeFilter: ['aria-current'] });
  new ResizeObserver(place).observe(nav);
 }
}
// Benefits heading: cycle the phrase after "A product expert that". The rotator's width follows the
// visible phrase, so the centred line re-centres smoothly (static first phrase with reduced motion).
const rotator = document.querySelector<HTMLElement>('[data-expert-rotator]');
if (rotator) {
 const phrases = Array.from(rotator.children) as HTMLElement[];
 let current = 0;
 const fit = () => { rotator.style.width = `${phrases[current].scrollWidth}px`; };
 fit();
 document.fonts?.ready.then(fit);
 window.addEventListener('resize', fit);
 if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const timer = window.setInterval(() => {
   if (document.hidden || document.documentElement.dataset.overlayOpen || motionPaused()) return; // paused by the footer toggle
   const previous = phrases[current];
   current = (current + 1) % phrases.length;
   previous.classList.remove('is-active');
   previous.classList.add('is-leaving');
   window.setTimeout(() => previous.classList.remove('is-leaving'), 700);
   phrases[current].classList.add('is-active');
   fit();
  }, 2600);
  document.addEventListener("astro:before-swap", () => window.clearInterval(timer), { once: true });
 }
}
// Benefits scroll story: ONE stage. On desktop the six chapters are layers of a single sticky stage
// (html.story-stage); the page scrolls past invisible markers (one per chapter, sized in home.css) and each
// chapter's --k runs 0 -> 2 over its own marker: 0 -> 1 arriving (elements fly in), 1 -> 2 its steps play;
// at 2 it fades out as the next one arrives. The stage background fades from dark to light as chapter 3
// arrives (--dark). Phones / short screens keep the stacked chapters with the same reveals (k from each
// chapter's own position). CSS turns --k into the reveals (home.css "Scroll story" / "One stage").
if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
 const storyChapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
 const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-story-marker]'));
 const stage = document.querySelector<HTMLElement>('[data-story-stage]');
 const tabRow = document.querySelector<HTMLElement>('.benefit-nav');
 const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
 const storyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-benefit-link]'));
 // The stage sits right under the chapter menu: --tab-row follows the menu's real height (it changes with the
 // labels and screen size), so no strip of page shows between them.
 if (tabRow) {
  const syncTabRow = () => document.documentElement.style.setProperty('--tab-row', `${tabRow.offsetHeight}px`);
  new ResizeObserver(syncTabRow).observe(tabRow);
  syncTabRow();
 }
 const stageQuery = matchMedia('(min-height: 600px)'); // pinned story on any screen tall enough (phones in portrait too); short screens stack
 const ARRIVE = 0.4; // share of the screen height each later chapter spends arriving
 const OVERLAP = 0.22; // ...starting this much (share of the screen height) before the previous one has left, so they crossfade
 // Each later chapter starts arriving a little before the previous one has finished fading out (a true crossfade,
 // no blank moment); the CO₂ chapter (index 1) much earlier, while the supplier globe's last stars are still
 // drifting away. Each still ends where it did (its own scroll is stretched by the same amount).
 const overlapFor = (i: number) => (i === 1 ? 1.0 : OVERLAP + 0.15);
 document.documentElement.classList.add('story-on');
 const clamp = (v: number) => Math.min(1, Math.max(0, v));
 const pinLineNow = () => Math.max(0, siteHeader?.getBoundingClientRect().bottom ?? 0) + (tabRow?.offsetHeight ?? 53);
 let shownPassportTab = 'about';
 let harvestExit = 0;
 let shownPassportPart: string | null = null;
 let wantedPassportPart: string | null = null;
 let passportK = 0; // (the passport chapter's --k on the stage, for its tab and part)
 const wantedPassportZoom = 1; // (no zoom for now: the phone stays its size through Connect with clients)
 let shownPassportShift = 0;
 // Style writes skip unchanged values: each custom property write restyles everything under its element
 const written = new WeakMap<HTMLElement, Map<string, string>>();
 const setVar = (el: HTMLElement, name: string, value: string) => {
  let values = written.get(el);
  if (!values) written.set(el, (values = new Map()));
  if (values.get(name) === value) return;
  values.set(name, value);
  el.style.setProperty(name, value);
 };
 const storyCards = storyChapters.map((chapter) => chapter.querySelector<HTMLElement>('.screen-card')?.closest<HTMLElement>('.ui-stage') ?? null);
 // Played, not scrubbed: elements with data-reveal-at (a --k value) get .is-revealed once their chapter is past it, and
 // home.css eases them in with timed transitions (out again above it)
 const storyReveals = storyChapters.map((chapter) =>
  Array.from(chapter.querySelectorAll<HTMLElement>('[data-reveal-at]')).map((el) => ({ el, at: parseFloat(el.dataset.revealAt || '0') }))
 );
 const passportPhone = document.querySelector<HTMLElement>('#product-passports .phone-live');
 // one dot per step, each chapter's first a little bigger, between the story's previous and next arrows
 // (StoryDotsNav.astro); built from the steps as they are measured (stepTops, the snap points below)
 const benefitDots = stage?.querySelector<HTMLElement>('.benefit-dots-nav') ?? null;
 const dotList = benefitDots?.querySelector<HTMLElement>('.benefit-dots') ?? null;
 let stepDots: HTMLElement[] = [];
 // (each dot's tooltip: its chapter, data-group, over its step, data-title; storySnap shows them)
 const buildDots = (steps: { i: number; title: string }[]) => {
  const same = stepDots.length === steps.length && stepDots.every((dot, n) => dot.dataset.chapter === String(steps[n].i) && dot.dataset.title === steps[n].title);
  if (!dotList || same) return;
  stepDots = steps.map((step, n) => {
   const dot = document.createElement('li');
   dot.dataset.chapter = String(step.i);
   dot.dataset.group = storyLinks[step.i]?.querySelector('.nav-full')?.textContent?.trim() ?? '';
   dot.dataset.title = step.title;
   if (n === 0 || steps[n - 1].i !== step.i) dot.className = 'is-chapter';
   return dot;
  });
  dotList.replaceChildren(...stepDots);
 };
 // (storySnap lights them: the step the page rests on or is gliding to)
 // The stage's colour and passport values go only to the layers that use them (home.css), never the stage itself:
 // a value set there would restyle everything in the story. The stage keeps their starting values.
 const storyBg = stage?.querySelector<HTMLElement>('.story-bg') ?? null;
 const storyTint = stage?.querySelector<HTMLElement>('.story-tint') ?? null;
 const passportChapter = document.getElementById('product-passports');
 const stageTargets: Record<string, (HTMLElement | null)[]> = {
  '--co2': [storyTint],
  '--dark': [storyBg, storyTint],
  '--blue': [storyBg],
  '--warm': [storyBg],
  '--sage': [storyBg, passportChapter], // (and the passport's captions)
  '--pp-zoom': [passportPhone],
  '--pp-shift': [passportPhone]
 };
 const stageValues: Record<string, string> = {};
 const stageVar = (name: string, value: string) => {
  stageValues[name] = value;
  for (const el of stageTargets[name]) if (el) setVar(el, name, value);
 };
 const storyUpdate = () => {
  const staged = stageQuery.matches;
  document.documentElement.classList.toggle('story-stage', staged);
  const vh = window.innerHeight;
  // Where the tab row sits once it sticks (under the header while that is shown), not where it is now.
  const pinLine = pinLineNow();
  // Every measurement first, then the writes (a layout read after a style write forces a fresh layout, per read)
  const markerBoxes = staged ? markers.map((marker) => ({ top: marker.getBoundingClientRect().top, length: Math.max(1, marker.offsetHeight) })) : [];
  const chapterTops = staged ? [] : storyChapters.map((chapter) => chapter.getBoundingClientRect().top);
  const cardTops = staged ? [] : storyCards.map((card) => card?.getBoundingClientRect().top ?? 0);
  // (the phone and stage as last laid out, i.e. with the shift then shown)
  const phoneBox = staged && passportPhone && stage ? { h: passportPhone.offsetHeight, stage: stage.getBoundingClientRect(), phone: passportPhone.getBoundingClientRect() } : null;
  let active = 0;
  storyChapters.forEach((chapter, i) => {
   let k: number;
   if (staged) {
    const { top, length } = markerBoxes[i];
    if (i === 0) {
     // the first chapter arrives as the stage itself comes up the screen, then plays over its marker
     k = clamp((vh - top) / Math.max(1, vh - pinLine - 40)) + clamp((pinLine - top) / length);
    } else {
     const arrive = vh * ARRIVE;
     const overlap = overlapFor(i);
     const d = pinLine - top + vh * overlap;
     k = clamp(d / arrive) + clamp((d - arrive) / Math.max(1, length - arrive + vh * (overlap - OVERLAP)));
    }
    chapter.classList.toggle('is-live', k > 0.001 && (k < 1.999 || i === storyChapters.length - 1));
    if (k >= (i === 0 ? 0 : 0.35)) active = i;
   } else {
    const top = chapterTops[i];
    const e = clamp((vh - top) / Math.max(1, vh - pinLine - 40));
    k = e + clamp((pinLine - top) / (vh * 0.45));
    chapter.classList.add('is-live');
   }
   setVar(chapter, '--k', k.toFixed(3));
   // Stacked layout: a chapter's illustration card sits well below its text, so its contents are timed by the
   // card's own position (built up as it scrolls into the middle of the screen), not by the chapter's top.
   const card = storyCards[i];
   if (card) {
    if (!staged) setVar(card, '--k', (0.6 + 1.4 * clamp((vh * 0.9 - cardTops[i]) / (vh * 0.5))).toFixed(3));
    else if (written.get(card)?.get('--k')) { card.style.removeProperty('--k'); written.get(card)?.delete('--k'); }
   }
   setVar(chapter, '--e', Math.min(1, k).toFixed(3));
   // (stacked layouts time them by the card's own place on screen, like its other contents)
   const revealK = !staged && card ? 0.6 + 1.4 * clamp((vh * 0.9 - cardTops[i]) / (vh * 0.5)) : k;
   for (const { el, at } of storyReveals[i]) el.classList.toggle('is-revealed', revealK >= at);
   if (chapter.id === 'harvest-data') {
    // the globe assembles from scattered stars as the chapter arrives, holds while the bullets play, and
    // disperses back into stars at the end (read by SupplyChainGlobe as --globe-scatter)
    // slow on purpose: fully assembled just as the second step ("Save time and effort") reaches full opacity (k 1.38)
    // Stacked layout (phones, short screens): k runs out while the globe is still on screen, so there it
    // assembles as the card scrolls in, its nodes follow, and it never disperses.
    const scatter = staged
     ? Math.max(1 - clamp((k - 0.05) / 1.33), clamp((k - 1.82) / 0.14)) // exit = the entrance in reverse, starting as the last text fades out
     : 1 - clamp((k - 0.1) / 0.8);
    setVar(chapter, '--globe-scatter', scatter.toFixed(3));
    // leaving: the stars turn sage and the stage fades from navy to the CO₂ charcoal in step with the dispersal
    harvestExit = staged ? clamp((k - 1.82) / 0.14) : 0;
    setVar(chapter, '--globe-tint', harvestExit.toFixed(3));
    // once the globe has assembled, the supply-chain nodes and their labels are placed one by one, done just before
    // the "Save time and effort" step's first bullet comes to rest (k 1.41), so no step stops half way through
    setVar(chapter, '--globe-place', clamp(staged ? (k - 1.26) / 0.14 : (k - 0.7) / 0.4).toFixed(3));
    // risk regions light up red with the last step ("Real risk assessments", k 1.68–1.82 on the stage)
    setVar(chapter, '--globe-risk', clamp(staged ? (k - 1.678) / 0.1 : (k - 1.46) / 0.14).toFixed(3));
   }
   if (chapter.id === 'trusted-co2') {
    window.dispatchEvent(new CustomEvent('co2report:scroll', { detail: { arrived: Math.min(1, k), held: clamp(k - 1) } }));
   }
   if (i === 1 && stage) {
    stageVar('--co2', Math.max(clamp(k / 0.5), clamp(harvestExit * 4)).toFixed(3)); // the How it works palette as chapter 2 arrives; from the globe's dispersal on, done a quarter of the way in
   }
   if (i === 2 && stage) {
    stageVar('--dark', (1 - clamp(k / 0.6)).toFixed(3)); // dark -> light as chapter 3 arrives
    stageVar('--blue', clamp(k * 8).toFixed(3)); // ...and the light is chapter 3's pale blue
   }
   if (i === 3 && stage) {
    if (k > 0) stageVar('--blue', (1 - clamp(k / 0.6)).toFixed(3)); // pale blue -> warm stone as chapter 4 arrives
    stageVar('--warm', clamp(k / 0.6).toFixed(3));
   }
   if (chapter.id === 'product-passports' && stage) {
    // with its second bullet (k from 1.25, see home.css) the passport turns to its parts shop (just before) and
    // selects a part, as if tapped; back to About above it and once the chapter goes
    passportK = staged ? k : 0;
    wantedPassportPart = staged && k >= 1.3 && k < 1.92 ? 'seat-cushion' : null;
   }
  });
  if (!staged) document.getElementById('product-passports')?.removeAttribute('data-render-paused');
  if (staged && stage) syncUnderColour(stage);
  if (staged) {
   // the chapters are stacked in the stage: only the current one takes the pointer (so faded-out chapters
   // above it don't swallow drags on the globe or clicks in the report)
   storyChapters.forEach((chapter, i) => chapter.classList.toggle('is-front', i === active));
   // The passport phone's zoom, kept on screen: capped to the visible part of the stage (16px clear top and
   // bottom; the site header can push the stage down) and nudged up or down to stay inside it.
   if (phoneBox && stage) {
    const h = phoneBox.h;
    const box = phoneBox.stage;
    const top = Math.max(box.top, 0) + 16;
    const bottom = Math.min(window.innerHeight, box.bottom) - 16;
    const zoom = Math.max(1, Math.min(wantedPassportZoom, (bottom - top) / Math.max(1, h)));
    const r = phoneBox.phone;
    const centre = (r.top + r.bottom) / 2 - shownPassportShift;
    let shift = 0;
    if (centre + (zoom * h) / 2 > bottom) shift = bottom - (centre + (zoom * h) / 2);
    if (centre - (zoom * h) / 2 + shift < top) shift = top - (centre - (zoom * h) / 2);
    shift *= Math.min(1, (wantedPassportZoom - 1) / 0.1); // eases in with the zoom; none at normal size
    shownPassportShift = shift;
    stageVar('--pp-zoom', zoom.toFixed(3));
    stageVar('--pp-shift', `${shift.toFixed(1)}px`);
   }
   // the 3D phone only draws while its chapter is on screen (the last chapter: from its arrival on, it never leaves)
   const passports = document.getElementById('product-passports');
   const ppK = parseFloat(passports?.style.getPropertyValue('--k') || '0');
   passports?.toggleAttribute('data-render-paused', !(ppK > 0.001));
   // ...and with the chapter's second bullet the passport turns to its Parts section (spare parts), back to About
   // when you leave
   const passportTab = passportK >= 1.2 && passportK < 1.92 ? 'parts' : 'about';
   if (passportTab !== shownPassportTab) {
    shownPassportTab = passportTab;
    window.dispatchEvent(new CustomEvent('dpp:tab', { detail: passportTab }));
   }
   // (after the tab: the Parts view mounts on the switch and starts listening a moment later, hence the wait)
   if (wantedPassportPart !== shownPassportPart) {
    const part = wantedPassportPart;
    shownPassportPart = part;
    setTimeout(() => window.dispatchEvent(new CustomEvent('dpp:part', { detail: part })), 200);
   }
   storyLinks.forEach((link, i) => {
