 for (const link of links) { if (link.dataset.benefitLink === active?.id) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); }
 pending = false;
}
window.addEventListener('scroll', () => { if (!pending) { pending = true; requestAnimationFrame(updateActive); } }, {passive:true});
window.addEventListener('resize', updateActive);
updateActive();
</script>
<script>
 import { glideToStep, registerSnapPoints } from "../../utilities/storySnap";
 import { sphereCircle } from "./data-scenes";
 // Dynamic Product Model as a second scroll story: on tablet width and up the section pins, the sphere stays as the
 // canvas, and the five capabilities take turns inside its dome (--mk counts through them; home.css places and fades
 // each one). Phones and short screens keep the capabilities as a grid under the sphere.
 const modelStory = document.querySelector<HTMLElement>('[data-model-story]');
 if (modelStory) {
  const query = matchMedia('(min-height: 600px)');
  const dots = Array.from(modelStory.querySelectorAll<HTMLElement>('.model-dots li'));
  const articles = Array.from(modelStory.querySelectorAll<HTMLElement>('.capabilities article'));
  const count = modelStory.querySelectorAll('.capabilities article').length;
  let queued = false;
  const update = () => {
   queued = false;
   const pinned = query.matches;
   document.documentElement.classList.toggle('model-stage', pinned);
   if (!pinned) return;
   // the sphere's top edge, as data-scenes.ts draws it (sphereCircle),
   // so the capability text sits inside the dome at any screen shape
   // (measured on the sphere's own canvas box, which is wider than the screen on phones)
   const horizon = modelStory.querySelector<HTMLElement>('.model-horizon');
   if (horizon) {
    const w = horizon.clientWidth;
    const h = horizon.clientHeight;
    const { r, cy } = sphereCircle(w, h);
    modelStory.style.setProperty('--dome', `${Math.round(horizon.offsetTop + cy - r)}px`);
   }
   const box = modelStory.getBoundingClientRect();
   const pin = modelStory.querySelector<HTMLElement>('.model-pin');
   const run = Math.max(1, modelStory.offsetHeight - (pin?.offsetHeight || window.innerHeight)); // the pinned panel's own run
   const progress = Math.min(1, Math.max(0, -box.top / run));
   // a short lead-in for the sphere before the first capability, and a beat on the last one before release
   const mk = progress * (count + 0.5) - 0.25;
   modelStory.style.setProperty('--mk', mk.toFixed(3));
   const active = Math.min(count - 1, Math.max(0, Math.floor(mk + 0.1)));
   // (with story steps on, storySnap lights the dots: the step chosen, not the one passed)
   if (!document.documentElement.classList.contains('story-snap')) dots.forEach((dot, i) => dot.classList.toggle('is-on', i === active));
   articles.forEach((article, i) => article.classList.toggle('is-on', i === active));
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  window.addEventListener('scroll', queue, { passive: true });
  window.addEventListener('resize', queue);
  query.addEventListener('change', update);
  update();
  // where capability i is in its turn (--mk i + .1 is its own point)
  const storyStart = (i = 0) => {
   const pin = modelStory.querySelector<HTMLElement>('.model-pin');
   const run = Math.max(1, modelStory.offsetHeight - (pin?.offsetHeight || window.innerHeight));
   return modelStory.getBoundingClientRect().top + window.scrollY + run * ((i + 0.35) / (count + 0.5));
  };
  // snap points (utilities/storySnap.ts): each capability in the middle of its turn, fully shown (--mk i + .55)
  // chapter tabs along the top: the current one follows the lit dot (storySnap's chosen step, or the one passed);
  // a tab glides to its capability, like a swipe; one dot slides under the current tab
  const tabs = Array.from(modelStory.querySelectorAll<HTMLButtonElement>('[data-model-tab]'));
  const tabRow = modelStory.querySelector<HTMLElement>('.model-tabs-row');
  const tabDot = tabRow?.querySelector<HTMLElement>('.nav-dot');
  const placeTab = () => {
   const on = Math.max(0, dots.findIndex((dot) => dot.classList.contains('is-on')));
   tabs.forEach((tab, i) => (i === on ? tab.setAttribute('aria-current', 'step') : tab.removeAttribute('aria-current')));
   const current = tabs[on];
   if (!current || !tabDot || !tabRow) return;
   tabDot.style.transform = `translateX(${current.offsetLeft + current.offsetWidth / 2 - 2}px)`;
   if (tabRow.scrollWidth > tabRow.clientWidth + 1) tabRow.scrollTo({ left: current.offsetLeft - (tabRow.clientWidth - current.offsetWidth) / 2, behavior: 'smooth' });
  };
  new MutationObserver(placeTab).observe(modelStory.querySelector('.model-dots')!, { subtree: true, attributeFilter: ['class'] });
  new ResizeObserver(placeTab).observe(tabRow ?? modelStory);
  placeTab();
  requestAnimationFrame(() => tabRow?.classList.add('has-dot')); // (first placement without the slide)
  tabs.forEach((tab, i) => tab.addEventListener('click', () => glideToStep(storyStart(i + 0.45))));
  registerSnapPoints(() => {
   if (!query.matches || !modelStory.getClientRects().length) return []; // (none while the story waits, hidden)
   const pin = modelStory.querySelector<HTMLElement>('.model-pin');
   const run = Math.max(1, modelStory.offsetHeight - (pin?.offsetHeight || window.innerHeight));
   const exit = modelStory.getBoundingClientRect().top + window.scrollY + run; // where it lets go
   return { points: [...articles.map((_, i) => storyStart(i + 0.45)), exit], top: modelStory.getBoundingClientRect().top + window.scrollY, dots: modelStory.querySelector<HTMLElement>('.model-dots'), hintLow: true };
  });
 }
</script></body></html>
