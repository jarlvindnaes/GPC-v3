   });
  }
 };
 // The stage ends a little above the bottom of the screen (iOS Safari, see home.css --edge); the strip below it, and
 // what shows under Safari's toolbar, is .chapters behind it, painted in the stage's current colour. Computed here from
 // the stage's colour values (--blue, --warm, --sage, --dark, --co2) and the colours home.css paints with them (the
 // last .story-bg rule, its ::after and .story-tint); reading those back from the computed styles fails in iOS Safari.
 function syncUnderColour(stage: HTMLElement) {
  const value = (name: string, fallback: number) => {
   const raw = stageValues[name];
   return raw === undefined ? fallback : Number(raw);
  };
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a: number[], b: number[], t: number) => a.map((v, i) => v * t + b[i] * (1 - t)); // a at t, over b
  const dark = value('--dark', 1);
  let colour = mix(hex('#0a1017'), mix(hex('#f6f4ef'), mix(hex('#e1edcc'), hex('#13285a'), value('--sage', 0)), value('--warm', 0)), value('--blue', 0));
  colour = mix(hex('#152239'), colour, dark);
  colour = mix(hex('#0e1615'), colour, value('--co2', 0) * dark);
  // a real element with its colour set directly (iOS Safari can skip repainting a pseudo-element on a variable change)
  const box = stage.parentElement;
  if (!box) return;
  let under = box.querySelector<HTMLElement>(':scope > .story-under');
  if (!under) {
   under = document.createElement('div');
   under.className = 'story-under';
   under.setAttribute('aria-hidden', 'true');
   box.prepend(under);
  }
  under.style.backgroundColor = `rgb(${colour.map((v) => Math.round(v)).join(',')})`;
  // the chapter dots and arrows in dark ink while the stage is light (the passport chapter); the chapter tabs take the
  // stage's colour as their own background, their ink following the same way (home.css)
  const light = (0.2126 * colour[0] + 0.7152 * colour[1] + 0.0722 * colour[2]) / 255 > 0.6;
  benefitDots?.classList.toggle('is-light', light);
  tabRow?.style.setProperty('--nav-bg', `rgb(${colour.map((v) => Math.round(v)).join(',')})`);
  tabRow?.classList.toggle('is-light', light);
 }
 // Steps (utilities/storySnap.ts): each bullet's resting point, where it is fully shown, read from its step's own
 // timings in home.css (--a, --b, --b1, --b2, --o), and the scroll position for a chapter's --k
 const stepNum = (el: Element, name: string) => parseFloat(getComputedStyle(el).getPropertyValue(name));
 // (with a title for each, for its dot's tooltip: a step's own heading, or the start of a bullet)
 // (a bullet's own short title, data-title, or else its first sentence)
 const excerpt = (text: string) => text.trim().replace(/\s+/g, ' ').split(/(?<=[.!?]) /)[0].replace(/[.!?]$/, '');
 const chapterSteps = (chapter: HTMLElement) => {
  const rests: { k: number; title: string }[] = [];
  chapter.querySelectorAll<HTMLElement>('.globe-points .step').forEach((step) => {
   const parts = Array.from(step.querySelectorAll<HTMLElement>(':scope > .sentence'));
   const [a, b, b1, b2] = ['--a', '--b', '--b1', '--b2'].map((name) => stepNum(step, name));
   const first = Number.isFinite(b1) ? b1 : a;
   const end = Number.isFinite(b) && b < 2 ? b : 1.86; // (a step that stays to the chapter's end has --b 9)
   if (!Number.isFinite(first)) return;
   const heading = parts.reduce((text, part) => text.replace(part.textContent ?? '', ''), step.textContent ?? '').trim();
   if (parts.length >= 2 && Number.isFinite(b2)) rests.push({ k: (first + b2) / 2, title: heading }, { k: (b2 + end) / 2, title: heading });
   else rests.push({ k: (first + end) / 2, title: heading });
  });
  chapter.querySelectorAll<HTMLElement>('.chapter-points li').forEach((li) => {
   const a = stepNum(li, '--a');
   const o = stepNum(li, '--o');
   if (Number.isFinite(a)) rests.push({ k: (a + (Number.isFinite(o) && o < 2 ? o : 1.86)) / 2, title: li.dataset.title || excerpt(li.textContent ?? '') });
  });
  return rests.filter((step) => step.k > 0 && step.k < 2);
 };
 const chapterRests = (chapter: HTMLElement) => chapterSteps(chapter).map((step) => step.k);
 const scrollForK = (i: number, k: number) => {
  // (the layout viewport's height, which iOS Safari's toolbar doesn't change as you swipe, and the pin line without
  // the header, which hides on the way down)
  const vh = document.documentElement.clientHeight;
  const pinLine = tabRow?.offsetHeight ?? 53;
  const marker = markers[i];
  const top = marker.getBoundingClientRect().top + window.scrollY;
  const length = Math.max(1, marker.offsetHeight);
  if (i === 0) return top - pinLine + (k - 1) * length; // (its steps all play past k 1)
  const arrive = vh * ARRIVE;
  const overlap = overlapFor(i);
  const d = k <= 1 ? k * arrive : arrive + (k - 1) * Math.max(1, length - arrive + vh * (overlap - OVERLAP));
  return top - (pinLine + vh * overlap - d);
 };
 // where a chapter's lead-in starts, for a jump to its first step (at --k first): --k 0 (the first chapter's lies
 // above the story: there, where the stage pins)
 const chapterLead = (i: number, first: number) => {
  const box = stage?.parentElement;
  const pinned = box ? box.getBoundingClientRect().top + window.scrollY - (tabRow?.offsetHeight ?? 53) : -Infinity;
  return Math.max(scrollForK(i, 0), Math.min(pinned, scrollForK(i, first)));
 };
 // Tabs: on the one-stage layout, scroll to the point where that chapter has fully arrived; with story steps on, jump
 // to where its lead-in starts (--k 0, either way) and glide from there through the lead-in, exactly onto its first
 // step (anywhere near it, and the steps would settle the page one step on in the way it went)
 storyLinks.forEach((link, i) => {
  link.addEventListener('click', (event) => {
   if (!stageQuery.matches || !markers[i]) {
    return;
   }
   event.preventDefault();
   const first = chapterRests(storyChapters[i])[0];
   if (document.documentElement.classList.contains('story-snap-strict') && first !== undefined) {
    window.scrollTo({ top: chapterLead(i, first), behavior: 'instant' });
    glideToStep(scrollForK(i, first));
    return;
   }
   const top = markers[i].getBoundingClientRect().top + window.scrollY;
   const offset = i === 0 ? 2 : window.innerHeight * (ARRIVE - overlapFor(i)) + 2;
   window.scrollTo({ top: top - pinLineNow() + offset, behavior: 'smooth' });
  });
 });
 // Snap points: every chapter's steps, then the exit (the last chapter at its end, where the story lets go)
 registerSnapPoints(() => {
  if (!stageQuery.matches || !stage?.getClientRects().length) return []; // (none while the story waits, hidden)
  const steps = storyChapters.flatMap((chapter, i) =>
   chapterSteps(chapter).map(({ k, title }, n, all) => ({ i, title, top: scrollForK(i, k), lead: n === 0 ? chapterLead(i, all[0].k) : undefined }))
  );
  buildDots(steps);
  // (a dot's jump: a chapter's first step from its lead-in, like its tab; any other from the step before it)
  const leads = steps.map((step, n) => step.lead ?? steps[n - 1]?.top ?? step.top);
  const points = steps.map((step) => step.top);
  points.push(scrollForK(storyChapters.length - 1, 2));
  // (its top edge: where the stage comes up from, for the entry)
  const box = stage?.parentElement ?? markers[0];
  // the supplier chapter's steps sit far apart (its long runway gives the globe room), so its step-to-step glides are
  // capped near the pace of the chapters after it rather than taking time from the distance
  const supplier = chapterRests(storyChapters[0]).map((k) => scrollForK(0, k));
  const quick = supplier.length > 1 ? { from: Math.min(...supplier), to: Math.max(...supplier), ms: 1050 } : undefined;
  return { points, top: box.getBoundingClientRect().top + window.scrollY, quick, dots: dotList, leads };
 });
 // Keyboard: chapters that are not on screen stay focusable (transparent, not hidden), and focusing something in
 // one brings the story to that chapter, so the focused control is always visible (WCAG 2.1.1, 2.4.7, 2.4.11).
 stage?.addEventListener('focusin', (event) => {
  if (!stageQuery.matches) return;
  const chapter = (event.target as HTMLElement).closest<HTMLElement>('[data-chapter]');
  if (!chapter || chapter.classList.contains('is-front')) return;
  const i = storyChapters.indexOf(chapter);
  if (i < 0 || !markers[i]) return;
  // just after the browser's own scroll-into-view for the focused element
  setTimeout(() => {
   const top = markers[i].getBoundingClientRect().top + window.scrollY;
   const offset = i === 0 ? 2 : window.innerHeight * (ARRIVE - overlapFor(i)) + 2;
   window.scrollTo({ top: top - pinLineNow() + offset, behavior: 'instant' });
   storyUpdate();
  }, 0);
 });
 // Measured straight in the scroll handler (a dozen rects), so it never lags a frame behind the scroll.
 window.addEventListener('scroll', storyUpdate, { passive: true });
 window.addEventListener('resize', storyUpdate);
 storyUpdate();
}
// (the trigger takes focus first, so the dialog can hand it back on close: Safari doesn't focus clicked buttons)
document.querySelectorAll<HTMLElement>('[data-open-passport]').forEach(el=>el.addEventListener('click',()=>{
 el.focus();
 // phones, from the hero: the passport on plain white (there the blurred page's edges would leave Safari's toolbar
 // white anyway, so the whole backdrop is); from the stories, over the blurred page as ever
 if (el.closest('.hero') && matchMedia('(hover: none) and (pointer: coarse)').matches) document.documentElement.dataset.passportPlain = '';
 window.dispatchEvent(new CustomEvent('passport:open'));
}));
new MutationObserver(() => { if (!document.documentElement.dataset.overlayOpen) delete document.documentElement.dataset.passportPlain; }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-overlay-open'] });
const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-benefit-link]'));
const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
let pending = false;
function updateActive() {
 if (document.documentElement.classList.contains('story-stage')) { pending = false; return; } // the story tracks it
 const line = Math.min(window.innerHeight * .38, 300);
 let active = chapters[0];
 for (const chapter of chapters) { if (chapter.getBoundingClientRect().top <= line) active = chapter; }
 for (const link of links) { if (link.dataset.benefitLink === active?.id) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); }
 pending = false;
}
window.addEventListener('scroll', () => { if (!pending) { pending = true; requestAnimationFrame(updateActive); } }, {passive:true});
window.addEventListener('resize', updateActive);
updateActive();
</script>
