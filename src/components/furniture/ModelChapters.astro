---
// The product model's four sections down the page: copy and visual side by side, alternating sides; the snapshot-vs-
// living section (the EPD chart) runs the full width. It leads because it is the page's core argument: a model beats
// a one-off report. Then the parts, the supply chain, and out to your systems and AI tools (MCP) last.
// (No summary bullets: they repeated the sections one to one. "Live impact" folded into the snapshot section.)
// No pinning, no snapping. Their canvases are drawn by data-scenes.ts.
import ProductMemory from './ProductMemory.astro';
import McpGraphic from './McpGraphic.astro';
// each section's short name, in its label
const capTabs: Record<string, string> = { 'product-memory': 'Snapshot vs. living model', 'input-interface': 'Every part, connected', 'supply-chain': 'Mapped supply chain', integrations: 'Built to connect' };
const capabilities = [
 ['An EPD is a snapshot. Your product model remembers.','A report goes out of date the day a supplier changes. The model updates with your data, logs every change with its date and source, and recalculates everything that depends on it, from cost drivers to CO₂.','product-memory'],
 ['Every part of the product, in one place','3D geometry, BOMs, materials, specs and certificates, linked down to the last bolt. Design sees what drives cost and impact. Sales sees what it can claim.','input-interface'],
 ['Know where every part comes from','Suppliers and sub-suppliers, linked to the components they deliver. When a supplier changes, you see every product it touches.','supply-chain'],
 ['Ready for your systems and your AI','API and MCP access give your ERP, PIM and AI agents unified, structured product context instead of loose files.','integrations'],
];
---
<div class="model-chapters">{capabilities.map(([title,text,anchor],i)=><article class:list={["model-chapter", { "model-chapter-wide": anchor === "product-memory" }]} id={`model-${anchor}`}><div class="model-chapter-copy"><span class="model-chapter-label">{`0${i+1}`} · {capTabs[anchor] ?? title}</span><h3>{title.split(/(?<=\.) /).map((part, j) => j > 0 ? <><br/><span>{part}</span></> : part)}</h3><p>{text}</p></div><div class:list={["model-visual", `model-visual-${anchor}`]}>{anchor === 'product-memory' && <ProductMemory compact />}{anchor === 'input-interface' && <div class="model-scene" role="img" aria-label="Incoming product data passes through our Input interface and converges at the Dynamic Product Model"><canvas data-scene="lens" aria-hidden="true"></canvas></div>}{anchor === 'integrations' && <McpGraphic />}{anchor === 'supply-chain' && <div class="model-scene" role="img" aria-label="Materials, components and suppliers mapped into the finished product, one path traced at a time"><canvas data-scene="supply" aria-hidden="true"></canvas></div>}</div></article>)}</div>
