---
// Animated Product Connect logo, as a small 3D scene: four dots orbit a circle tilted 45 degrees away from
// the viewer (centre 412.4,189 / radius 139.7 in logo units, the circle the static logo's dots sit on),
// clockwise, seen in perspective. Near the top of the orbit they are closer (bigger, up to x1.39), near the
// bottom further away (smaller, down to x0.78), and they keep the logo's uneven spacing. In front of the ring
// (the top half of the orbit) a dot cuts a gap in it, like the notches in the static logo; behind it (the
// bottom half) the ring passes in front of the dot, with the same 12-unit clear margin around the ring. Each dot is drawn twice - under the ring always, and
// over it while in front - with the cut made by a mask. Positions are precomputed (72 steps per lap).
// The orbit reaches to the right of the logo's own box (overflow visible), so it takes the same space in a
// layout as PcLogo. Colours as PcLogo: ring and black dots in the current text colour, blue dot brand blue
// (--pc-logo-dot). With reduced motion it shows the resting frame, still (same as public/logo-rest.svg).
interface Props {
  class?: string;
  seconds?: number; // one full lap
  // "loop": plays continuously. "hover": rests on the frame most like the static logo and plays while its
  // link (or itself) is hovered, easing to a stop on that frame after the pointer leaves; a tap plays one
  // lap that eases into the same frame.
  trigger?: "loop" | "hover";
}
const { class: className, seconds = 3, trigger = "loop" } = Astro.props;
const id = `pc-logo-gap-${Math.random().toString(36).slice(2, 8)}`;
const dur = `${seconds}s`;
---
