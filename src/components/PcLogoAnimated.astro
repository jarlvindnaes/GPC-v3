<script>
  // Hover / tap playback for trigger="hover". The SVG's own timeline stays paused and is scrubbed here
  // frame by frame, so the ending can ease. REST is the point in the lap (fraction) where the dots look
  // most like the static logo: the logo sits there, runs at full speed while hovered, and after the pointer
  // leaves eases out over the rest of the lap to stop on REST again. A tap runs one eased lap.
  const REST = 0.0072;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const easeOut = (u: number) => 1 - (1 - u) ** 2; // starts at twice the speed, ends at rest
  for (const svg of document.querySelectorAll<SVGSVGElement>('[data-pc-logo-animated="hover"]')) {
    if (reduce) {
      continue; // CSS shows the still resting frame instead
    }
    const lap = Number(svg.dataset.seconds) || 3;
    const rest = REST * lap;
    let time = rest; // position in the timeline (seconds)
    let mode: "idle" | "run" | "settle" = "idle";
    let from = 0;
    let to = 0;
    let settleStart = 0;
    let settleFor = 0;
    let last = 0;
    let frame = 0;
    const show = () => svg.setCurrentTime(time);
    const settle = () => {
      svg.pauseAnimations();
      show();
    };
    settle();
    // The SVG timeline only starts at the page's load event, which can undo an earlier pause.
    if (document.readyState !== "complete") {
      window.addEventListener("load", settle, { once: true });
    }
    const tick = (now: number) => {
      frame = 0;
      if (mode === "run") {
        time += (now - last) / 1000;
        last = now;
      } else if (mode === "settle") {
        const u = Math.min(1, (now - settleStart) / (settleFor * 1000));
        time = from + (to - from) * easeOut(u);
        if (u >= 1) {
          time = rest; // same frame, timeline wound back
          mode = "idle";
        }
      }
      show();
      if (mode !== "idle") {
        frame = requestAnimationFrame(tick);
      }
    };
    const kick = () => {
      if (!frame) {
        frame = requestAnimationFrame(tick);
      }
    };
    // Ease from the current position to the next rest point. An ease-out that starts at full speed needs
    // twice the remaining time; capped so a nearly full lap still ends within about one lap.
    const easeToRest = () => {
      from = time;
      to = rest + Math.ceil((time - rest) / lap) * lap;
      if (to - from < 0.15 * lap) {
        to += lap;
      }
      settleFor = Math.min(2 * (to - from), to - from + lap / 3);
      settleStart = performance.now();
      mode = "settle";
      kick();
    };
    const target = svg.closest("a") ?? svg;
    target.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") {
        mode = "run";
        last = performance.now();
        kick();
      }
    });
    target.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse" && mode === "run") {
        easeToRest();
      }
    });
    // Touch: one lap that starts quick and eases into the rest frame (3 s for a 3 s lap).
    target.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" && mode === "idle") {
        from = time;
        to = time + lap;
        settleFor = lap;
        settleStart = performance.now();
        mode = "settle";
        kick();
      }
    });
  }
</script>

