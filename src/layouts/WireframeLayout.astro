---
import "../index.css";
import { BackToTop } from "../components/wireframe/BackToTop";
import { NavAutoHide } from "../components/wireframe/NavAutoHide";

interface Props {
  title?: string;
  description?: string;
  label?: string;
  image?: string;
}

// Intended production home for these pages (canonical + Open Graph URLs).
const SITE_ORIGIN = "https://productconnect.com";

const {
  title = "Product Connect — digital product passports for furniture",
  description = "Turn the furniture you already make into verified digital twins, ESPR-ready Digital Product Passports, and component-level LCA — straight from your existing 3D models, with nothing re-typed.",
  label = "WIREFRAME · SMV",
  image
} = Astro.props;

const base = import.meta.env.BASE_URL;
// The pages deploy under a base path (/GPC-v3/ or /pc-wireframes/); map that onto the production origin.
const relativePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname.replace(/^\//, "");
const canonical = `${SITE_ORIGIN}/${relativePath}`;
const ogImage = image ?? `${SITE_ORIGIN}/wireframes/hero-commercial-poster.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Staging mirror: keep it out of the index, but follow links and stay launch-ready. -->
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0F1D45" />

    <!-- Favicons — identical to the Product Connect platform -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Product Connect" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="Product Connect" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Product Connect" />

    <link rel="preload" href={`${base}fonts/plus-jakarta-sans-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/space-grotesk-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`${base}wireframes/wireframe.css`} />
  </head>
  <body class="bg-white font-sans text-brand-text">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-medium focus:text-slate-900 focus:shadow-lg"
    >
      Skip to main content
    </a>
    <header class="bg-brand-deep px-4 py-2 text-center text-white text-xs tracking-wide">
      <strong>{label}</strong> · message &amp; structure only. Visuals are placeholders.
    </header>
    <slot />
    <NavAutoHide client:load />
    <BackToTop client:load />

    <script>
      // Cursor-tracked blue gradient on the highlighted (.hl) parts of headlines. Like the main site, the
      // gradient follows the mouse across the whole page (not just on hover): a single rAF-throttled
      // mousemove updates --mouse-x/--mouse-y (percent relative to each element) so each highlight lights up
      // as the cursor sweeps near it. Skipped on touch devices (no pointer to follow).
      const hlTargets = [...document.querySelectorAll<HTMLElement>("h1 .hl, h2 .hl, h3 .hl")];
      if (hlTargets.length > 0 && !window.matchMedia("(pointer: coarse)").matches) {
        let raf = 0;
        let pos: { x: number; y: number } | null = null;
        const flush = () => {
          raf = 0;
          if (!pos) {
            return;
          }
          for (const el of hlTargets) {
            const rect = el.getBoundingClientRect();
            if (!rect.width || !rect.height) {
              continue;
            }
            el.style.setProperty("--mouse-x", `${((pos.x - rect.left) / rect.width) * 100}%`);
            el.style.setProperty("--mouse-y", `${((pos.y - rect.top) / rect.height) * 100}%`);
          }
        };
        window.addEventListener("mousemove", (event) => {
          pos = { x: event.clientX, y: event.clientY };
          if (!raf) {
            raf = requestAnimationFrame(flush);
          }
        });
      }
    </script>
  </body>
</html>
