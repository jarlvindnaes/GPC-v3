---
import "../index.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Product Connect | Global Product Infrastructure",
  description = "Product Connect helps furniture manufacturers digitise products, manage supply chains, calculate environmental impact, and generate ESPR-compliant Digital Product Passports."
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1D45" />
    <title>{title}</title>
    <link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/space-grotesk-latin.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-white font-sans selection:bg-indigo-100 selection:text-indigo-900">
    <slot />
  </body>
</html>
