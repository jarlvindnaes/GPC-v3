---
import WireframeLayout from "../../layouts/WireframeLayout.astro";
import { ParticleField } from "../../components/wireframe/ParticleField";
import { EngineFlow } from "../../components/wireframe/EngineFlow";
import { ExplodingChair } from "../../components/wireframe/ExplodingChair";
import { ScrewSpinner } from "../../components/wireframe/ScrewSpinner";
import { PassportPhone } from "../../components/wireframe/PassportPhone";
import { withBase } from "../../utilities/withBase";
import { ShieldCheck, Database, QrCode, Box, Network, ClipboardList, FileCheck, Leaf, ChartColumn, BadgeCheck, ShoppingCart, Ship } from "lucide-react";
import { brands } from "../../utilities/brands";
import CinematicHero from "../../components/nextgen/CinematicHero";
import "../../styles/nextgen-scoped.css";

const base = import.meta.env.BASE_URL;
---

<WireframeLayout
  title="Product Connect — digital product passports for furniture makers"
  description="Turn the furniture you already make into verified digital twins, ESPR-ready Digital Product Passports, and component-level LCA — straight from your existing 3D models, with nothing re-typed."
  label="WIREFRAME · SMV"
>

<!-- ============ NAV ============ -->
<nav class="nav" aria-label="Primary">
  <div class="container nav__inner">
    <a class="logo" href={withBase("/wireframes/")}><span class="brand-mark"></span><span class="logo-text">PRODUCT&nbsp;CONNECT</span></a>
    <div class="nav__links">
      <a href="#how">The data layer</a>
      <a href="#value">Value</a>
      <a href="#cost">Time &amp; cost</a>
      <a href="#pricing">Pricing</a>
      <a href={withBase("/wireframes/enterprise")}>Enterprise</a>
      <a class="btn btn--primary" href="#cta">Book a demo</a>
    </div>
  </div>
</nav>

<main id="main-content">

<!-- ============ HERO (Astra cinematic 3D - merged from nextgen Landing) ============ -->
<div class="ng">
<header class="ng-hero cinematic-hero">
  <div class="hero-topline"><span><i></i> PHYSICAL PRODUCTS. CONNECTED INTELLIGENCE.</span></div>
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">CO₂ CALCULATIONS + DIGITAL PRODUCT PASSPORTS</p>
      <h1>Beautiful outside.<br/><em>Intelligent<br/>inside.</em></h1>
      <p class="hero-description">You make the furniture. We help you understand its impact — and turn your product data into a Digital Product Passport.</p>
      <div class="hero-actions"><a class="button lime" href="#cta">See it with your products <span aria-hidden="true">↗</span></a><a class="text-link" href="#how">See what’s inside <span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="hero-stage">
      <CinematicHero base={base} client:load />
    </div>
  </div>
  <div class="hero-bottom"><span>From the smallest component to the complete story.</span><a href="#how">Discover the connection <span aria-hidden="true">↓</span></a></div>
</header>
</div>

<!-- ============ TRUST (light, tight) ============ -->
<section class="section section--tight">
  <div class="container">
    <span class="kicker" style="margin-bottom:6px; display:block; text-align:center">Trusted by leading product companies</span>
    <div class="logo-marquee" aria-label="Manufacturers using Product Connect">
      <div class="logo-track">
        <div class="logo-group">
          {brands.map((b) => (
            <div class="brand">
              {b.photo !== false && <img class="brand__photo" src={`${base}wireframes/product-images/${b.slug}.jpg`} alt="" />}
              <img class:list={["logo-img", { "logo-img--wide": b.wide }]} src={`${base}wireframes/logos/${b.slug}.svg`} alt={b.name} />
            </div>
          ))}
        </div>
        <div class="logo-group" aria-hidden="true">
          {brands.map((b) => (
            <div class="brand">
              {b.photo !== false && <img class="brand__photo" src={`${base}wireframes/product-images/${b.slug}.jpg`} alt="" />}
              <img class:list={["logo-img", { "logo-img--wide": b.wide }]} src={`${base}wireframes/logos/${b.slug}.svg`} alt="" />
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="chat-card after" style="margin-top:36px">
      <div class="bubble q">What's your CO2 footprint?</div>
      <div class="bubble a">32.3 kg. Precisely.<br />Want it broken down by component?</div>
      <span class="who">- Your furniture with Product Connect, smarter than you think</span>
    </div>
  </div>
</section>

<!-- ============ THE DATA LAYER (DARK - under the hood) ============ -->
<section class="section section--dark" id="how">
  <ParticleField client:visible={{ rootMargin: "1200px" }} />
  <div class="container">
    <div class="section__head">
      <span class="kicker">The data layer</span>
      <h2>One data layer. <span class="hl">Not ten point tools.</span></h2>
      <p class="sub">Most companies bolt on a new tool for every regulation, and the data scatters across systems. Product Connect replaces the stack with one foundation - enter a fact once, and it feeds every report, EPD, and passport. Calculate a component once; every product that shares it reuses the result.</p>
    </div>
    <div class="engine engine--tiered">
      <EngineFlow client:visible={{ rootMargin: "1200px" }} />
      <div class="engine__tiers" aria-hidden="true">
        <div class="tier">
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__label">Tier 3</span>
          <span class="tier__desc">Raw material data</span>
        </div>
        <div class="tier">
          <span class="tier__bar"></span>
          <span class="tier__bar"></span>
          <span class="tier__label">Tier 2</span>
          <span class="tier__desc">Material data</span>
        </div>
        <div class="tier">
          <span class="tier__bar"></span>
          <span class="tier__label">Tier 1</span>
          <span class="tier__desc">Product data</span>
        </div>
      </div>
      <div class="engine__col">
        <h3>Data in</h3>
        <ul class="engine__list">
          <li><Database /> ERP / PLM / PIM systems</li>
          <li><Box /> 3D / CAD across product lines</li>
          <li class="engine__supplier"><Network /> Multi-tier supplier data</li>
          <li><ClipboardList /> Bills of materials &amp; materials</li>
          <li><FileCheck /> Certificates &amp; test reports</li>
        </ul>
      </div>
      <div class="engine__hub">
        <div class="core"><span class="core__logo" aria-hidden="true"></span><b>PRODUCT CONNECT</b><span>one product graph, every SKU</span></div>
      </div>
      <div class="engine__col">
        <h3>Value out</h3>
        <ul class="engine__list">
          <li class="engine__out">
            <BadgeCheck />
            <div class="engine__out-body">
              <span class="engine__out-title">Compliance</span>
              <ul class="engine__out-pts">
                <li>Regulatory &amp; CBAM reporting</li>
                <li>Risk assessment</li>
                <li>Audit-ready EPDs &amp; DPPs</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <Leaf />
            <div class="engine__out-body">
              <span class="engine__out-title">Sustainability</span>
              <ul class="engine__out-pts">
                <li>GHG accounting &amp; ESG reporting</li>
                <li>Impact measurement</li>
                <li>Stakeholder engagement</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <ChartColumn />
            <div class="engine__out-body">
              <span class="engine__out-title">Development</span>
              <ul class="engine__out-pts">
                <li>Product design &amp; engineering</li>
                <li>Component-level LCA</li>
                <li>Production certification</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <Ship />
            <div class="engine__out-body">
              <span class="engine__out-title">Operations</span>
              <ul class="engine__out-pts">
                <li>Product planning</li>
                <li>Quality control</li>
                <li>Spare parts &amp; resource efficiency</li>
              </ul>
            </div>
          </li>
          <li class="engine__out">
            <ShoppingCart />
            <div class="engine__out-body">
              <span class="engine__out-title">Procurement</span>
              <ul class="engine__out-pts">
                <li>Supplier onboarding</li>
                <li>Contract management</li>
                <li>Spend analysis</li>
              </ul>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ COMPONENT-LEVEL (light) - reuse + 3D auto-detect + exploded scroll video ============ -->
<section class="section" id="components">
  <div class="components-photo" aria-hidden="true"></div>
  <div class="components-fade" aria-hidden="true"></div>
  <div class="container">
    <div class="section__head">
      <span class="kicker">Component-level by design</span>
      <h2>Collect component data once. <span class="hl">Reuse it everywhere.</span></h2>
      <p class="sub">We gather data and calculate LCA at the <b>component</b> level - a leg, a screw, a fabric - not just the finished product. So the work compounds: every product that shares a component inherits its data automatically, with nothing re-typed.</p>
    </div>

    <!-- A single metal screw lifted from the chair model, isolated and turning in the top-right -->
    <ScrewSpinner client:visible={{ rootMargin: "1200px" }} />

    <div class="split" style="margin-top:44px">
      <div>
        <!-- Live scroll-scrubbed exploded assembly (real 3D model); breaks out behind the copy on desktop -->
        <ExplodingChair client:visible={{ rootMargin: "1200px" }} />
      </div>
      <div class="components-card">
        <h3 style="margin-bottom:6px">No re-typing. No re-calculating. No starting over.</h3>
        <p class="lead" style="font-size:16px">Your data compounds - the more you add, the less work each new product becomes.</p>
        <ul class="ticks" style="margin-top:18px">
          <li>LCA calculated per component - not re-entered product by product</li>
          <li>Add a component's data once; every product that uses it updates</li>
          <li>Upload a 3D model and we detect its components automatically</li>
          <li>Shared parts across models are recognised - so coverage grows with every upload</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ VALUE (light) - 3 gains + 1 vision (trimmed per April feedback) ============ -->
<section class="section" id="value">
  <div class="value-photo" aria-hidden="true"></div>
  <div class="container">
    <div class="section__head">
      <span class="kicker">What you get</span>
      <h2>Value, <span class="hl">not just compliance.</span></h2>
      <p class="sub">Compliance is the floor. The data you build to get there is what pays you back.</p>
    </div>
    <div class="grid grid--3">
      <div class="card">
        <div class="ic"><ShieldCheck /></div>
        <h3>Compliance, handled</h3>
        <p>ESPR-ready Digital Product Passports and EPDs, generated from component-level data. When the law lands, you're already done.</p>
      </div>
      <div class="card">
        <div class="ic"><Database /></div>
        <h3>One source of truth</h3>
        <p>A complete data layer for your products - BOMs, materials, suppliers, CO₂ - that feeds your sales material, your website, and your reporting.</p>
      </div>
      <div class="card">
        <div class="ic"><QrCode /></div>
        <h3>Products that sell themselves</h3>
        <p>Scan-or-tap passport pages - QR code or NFC tag - turn compliance data into a customer experience, and open a direct channel for spare parts and services.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ DATA QUALITY & VERIFIED EPD (DARK - under the hood credibility) ============ -->
<section class="section section--dark" id="verified">
  <div class="container split">
    <div>
      <span class="kicker">Data quality &amp; verification</span>
      <h2>Audit-ready data you can trace to the core.</h2>
      <p class="sub">
        Suppliers log in and verify the data on their own components - first-hand, primary data straight from
        the source. Every value is tagged with how we know it. No spreadsheet or consultant can prove that.
      </p>
      <p class="sub" style="margin-top:14px">
        And when you need it, we take an EPD all the way to third-party verification - audit-ready by default.
      </p>
      <div class="chips">
        <span class="chip">EN 15804</span>
        <span class="chip">ISO 14025</span>
        <span class="chip">ISO 14040 / 14044</span>
        <span class="chip">ESPR</span>
        <span class="chip">GS1</span>
      </div>
    </div>
    <div>
      <!-- Provenance ladder (pure CSS) - supplier-verified is the top tier -->
      <div class="ladder">
        <div class="ladder__row ladder__row--top">
          <span class="ladder__name">Supplier-verified</span>
          <span class="ladder__meta">first-hand, primary data</span>
          <span class="ladder__tag">Highest quality</span>
        </div>
        <div class="ladder__row">
          <span class="ladder__name">Authored</span>
          <span class="ladder__meta">entered by your team</span>
        </div>
        <div class="ladder__row">
          <span class="ladder__name">Extracted</span>
          <span class="ladder__meta">pulled from your files &amp; 3D</span>
        </div>
        <div class="ladder__row">
          <span class="ladder__name">Estimated</span>
          <span class="ladder__meta">industry averages</span>
        </div>
      </div>
      <p class="note">Every value is tagged with its provenance. The more suppliers verify, the higher your overall data quality climbs.</p>
    </div>
  </div>
</section>

<!-- ============ DPP SHOWCASE (light) - the phone (one visual; globe moved to Enterprise supply-chain) ============ -->
<section class="section" id="passport">
  <div class="container split">
    <div>
      <span class="kicker">The passport</span>
      <h2>Not just a web page. <span class="hl">A passport that proves itself.</span></h2>
      <p class="lead" style="margin-top:16px">
        Every product gets a beautiful, mobile-first page behind a QR code or NFC tag: footprint, materials, origin,
        care instructions - and a direct line to spare parts. A scan - or a tap - becomes a customer relationship.
      </p>

      <!-- mobile-only: phone sits right under the lead so the product is seen before the detail list -->
      <div class="passport-phone-m" style="margin:24px 0">
        <PassportPhone client:visible={{ rootMargin: "2000px" }} />
      </div>

      <ul class="ticks" style="margin-top:20px">
        <li><b>Provably genuine</b> - digitally signed, so anyone can confirm it's real in one tap. Not just a web page someone could fake.</li>
        <li>Consumer-facing, mobile-optimised, on-brand</li>
        <li>QR code or NFC tag - your choice; customers just scan or tap</li>
        <li>Spare parts &amp; upgrades sold straight from the passport</li>
      </ul>
      <p class="note">Issued as cryptographically signed credentials (did:web) and checked by an independent third party (EECC) - the authenticity standard set out in EU ESPR 2024/1781.</p>

      <!-- Verified-credentials proof card - mirrors the live "Verify credentials" result -->
      <div class="verify-card">
        <div class="vc-head"><span class="shield">✓</span> Independently verified by EECC</div>
        <div class="vc-items">
          <span class="vchk">Product Identity</span>
          <span class="vchk">Material Composition</span>
          <span class="vchk">Environmental Impact</span>
          <span class="vchk">Traceability</span>
        </div>
      </div>
    </div>
    <div class="passport-phone-d">
      <PassportPhone client:visible={{ rootMargin: "2000px" }} />
    </div>
  </div>
</section>


<!-- ============ TIME & COST (DARK) - traditional EPD vs Product Connect ============ -->
<section class="section section--dark" id="cost">
  <div class="container">
    <div class="section__head">
      <span class="kicker">Time &amp; cost</span>
      <h2>From €28,000 and five months to <span class="hl">about €1,000 and a week.</span></h2>
      <p class="sub">That's a traditional, consultant-led EPD versus Product Connect - and it's just your first one. Every EPD after reuses the data you've already built, so it's faster and cheaper still.</p>
    </div>

    <!-- Comparison timeline (pure CSS) -->
    <div style="margin-top:44px">
      <div class="cmp-axis">
        <span class="cmp-weeks">weeks</span>
        <span class="cmp-zero" style="left:0%">0</span>
        <span style="left:23.8%">5</span>
        <span style="left:47.6%">10</span>
        <span style="left:71.4%">15</span>
        <span style="left:95.2%">20</span>
        <span style="left:100%; transform:translateX(-100%)">→</span>
      </div>

      <div class="cmp-row">
        <div class="cmp-row__label"><b>Traditional EPD</b><span>consultant-led</span></div>
        <div class="cmp-track">
          <div class="cmp-seg cmp-seg--data" style="width:35.6%"><span class="cmp-seg__price">€9,500</span><span class="cmp-seg__label">Data gathering</span></div>
          <div class="cmp-seg cmp-seg--lca" style="width:23.8%"><span class="cmp-seg__price">€14,000</span><span class="cmp-seg__label">LCA + report</span></div>
          <div class="cmp-seg cmp-seg--ver" style="width:28.6%"><span class="cmp-seg__price">€4,500</span><span class="cmp-seg__label">Verification</span></div>
          <div class="cmp-seg cmp-seg--pub" style="width:12%"><span class="cmp-seg__price">€0*</span><span class="cmp-seg__label">Publication</span></div>
        </div>
      </div>

      <div class="cmp-row">
        <div class="cmp-row__label"><b>Product Connect</b><span>platform</span></div>
        <div class="cmp-track">
          <div class="cmp-seg cmp-pc" style="width:4.8%; min-width:16px; border-radius:6px 4px 4px 6px"></div>
          <span class="cmp-pc-note">≈ 1 week, then instant</span>
        </div>
      </div>
    </div>

    <!-- Summary cards -->
    <div class="grid grid--2" style="margin-top:36px">
      <div class="card">
        <span class="kicker" style="color:var(--dark-soft)">Traditional EPD route</span>
        <div style="font-size:32px; font-weight:800; margin:6px 0 2px">≈ €28,000</div>
        <p>≈ 5 months · consultant-led</p>
      </div>
      <div class="card" style="border-color:var(--emerald); background:rgba(0,178,126,0.1)">
        <span class="kicker" style="color:var(--emerald)">With Product Connect</span>
        <div style="font-size:32px; font-weight:800; margin:6px 0 2px">≈ €1,000 <span style="font-size:15px; font-weight:500; color:var(--dark-soft)">/ EPD + €499 / mo</span></div>
        <p>≈ 1 week</p>
      </div>
    </div>

    <p class="note">* Publication cost = EPD International hosting fee (registration €1,030 + annual €515–2,575), which applies to both routes.</p>
  </div>
</section>

<!-- ============ PRICING (light) ============ -->
<section class="section" id="pricing">
  <div class="pricing-photo" aria-hidden="true"></div>
  <div class="container">
    <div class="section__head">
      <span class="kicker">Pricing</span>
      <h2>Simple tiers. <span class="hl">All features in every plan.</span></h2>
      <p class="sub">Priced by components hosted - the legs, seats, fabrics, and screws that make up your products. A typical product has 10–50 components.</p>
    </div>
    <div class="price-grid">
      <div class="price">
        <h3>Starter</h3>
        <div class="amount">€499<small>/mo</small></div>
        <div class="cap">Up to 250 components - about 25 simple products</div>
        <ul class="ticks">
          <li>All platform features</li>
          <li>Guided onboarding</li>
          <li>Digital Product Passports</li>
          <li>CO₂ per component</li>
        </ul>
        <a class="btn btn--ghost" href="#cta">Start now</a>
      </div>
      <div class="price price--featured">
        <h3>Growth</h3>
        <div class="amount">€999<small>/mo</small></div>
        <div class="cap">Up to 1,000 components - full catalogues with complex BOMs</div>
        <ul class="ticks">
          <li>Everything in Starter</li>
          <li>4× component capacity</li>
          <li>Supplier verification at scale</li>
          <li>Verified EPD add-ons</li>
        </ul>
        <a class="btn btn--primary" href="#cta">Start now</a>
      </div>
      <div class="price">
        <h3>Enterprise</h3>
        <div class="amount">Let's talk</div>
        <div class="cap">Large or complex portfolios, ERP integration, 10,000+ components</div>
        <ul class="ticks">
          <li>Everything in Growth</li>
          <li>ERP integration &amp; DPP minting</li>
          <li>Dedicated onboarding</li>
        </ul>
        <a class="btn btn--ghost" href={withBase("/wireframes/enterprise")}>See Enterprise →</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ AUDIENCE SWITCH + CONTACT (Astra - merged from nextgen Landing) ============ -->
<div class="ng">
<section class="audience">
  <p class="eyebrow">MADE TO GROW WITH YOU</p>
  <div>
    <h2>Complex portfolio?<br/><em>Meet the bigger picture.</em></h2>
    <a class="button outline" href={withBase("/wireframes/enterprise")}>Explore enterprise <span>↗</span></a>
  </div>
  <p>For larger manufacturers in furniture and building products: connect suppliers, shared components and your existing systems.</p>
</section>

<section class="contact" id="cta">
  <p class="eyebrow">LET’S MAKE IT CONCRETE</p>
  <h2>Your products.<br/><em>Let’s connect the dots.</em></h2>
  <div class="contact-bottom">
    <p>Bring one of your products. We’ll walk through its data, its footprint and what its passport could look like.</p>
    <a class="button dark" href="mailto:hello@getproductconnect.com?subject=Product%20Connect%20%E2%80%94%20Product%20demo">Let’s start a conversation <span>↗</span></a>
  </div>
  <p class="contact-email">hello@getproductconnect.com</p>
</section>
</div>

</main>

<!-- ============ FOOTER ============ -->
<footer class="footer">
  <div class="container footer__inner">
    <div>
      <div class="logo" style="color:#fff"><span class="brand-mark"></span><span class="logo-text">PRODUCT&nbsp;CONNECT</span></div>
      <p style="margin-top:10px; max-width:36ch; font-size:14px">The product-data platform for furniture manufacturers. Copenhagen, Denmark.</p>
    </div>
    <div class="footer__links">
      <a href="#how">The data layer</a>
      <a href="#value">Value</a>
      <a href="#pricing">Pricing</a>
      <a href={withBase("/wireframes/enterprise")}>Enterprise</a>
      <a href="#">Contact</a>
    </div>
  </div>
</footer>

</WireframeLayout>
