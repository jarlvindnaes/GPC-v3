---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FeatureGrid } from '../components/FeatureGrid';
import { StorytellingScroll } from '../components/StorytellingScroll';
import { TrustLogos } from '../components/TrustLogos';
import Footer from '../components/v4/Footer.astro';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="How it works — Product Connect" description="From 3D models and supplier data to impact insights and next-generation Digital Product Passports. See how Product Connect works.">
<a class="how-skip" href="#main">Skip to content</a>
<header class="how-header"><a class="how-brand" href={base}><span>pc</span> Product Connect</a><nav aria-label="Main navigation"><a href={base}>Platform</a><a href={`${base}how-it-works/`} aria-current="page">How it works</a><a href={`${base}pricing/`}>Pricing</a></nav><a class="how-button" href="mailto:hello@getproductconnect.com">Talk to sales ↗</a></header>
<main id="main">
<section class="how-intro"><p class="how-eyebrow">PRODUCT CONNECT</p><h1>How it works.</h1><p>Bring your data. Map your supply chain, uncover insights, and publish your first Digital Product Passports — all on day one.</p><a class="how-button" href="#workflow">Explore the steps ↓</a></section>
<TrustLogos client:visible /><section class="how-savings"><p class="how-eyebrow">SAVE TIME</p><h2>Less data chasing.<br/><span>Your team’s time, back.</span></h2><p>Bring supplier and component data together, so your team can spend more time improving products.</p><div><article><h3>Bring your data.</h3><p>Start with the product files and supplier information you already have.</p></article><article><h3>Connect the knowledge.</h3><p>Materials, components and suppliers, together in one product model.</p></article><article><h3>Put it to work.</h3><p>Use the same foundation for impact insights and product passports.</p></article></div></section>
<div id="workflow"><FeatureGrid client:only="react" /></div><StorytellingScroll client:only="react" />

<section class="how-end"><h2>Live from day one.<br/><span>Bring your data.</span></h2><a class="how-button" href="mailto:hello@getproductconnect.com">Talk to sales ↗</a></section>
</main><Footer />
</BaseLayout>
<style>
.how-header{max-width:1240px;margin:auto;height:80px;padding:0 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;position:sticky;top:0;z-index:50;background:#fffffff2;border-bottom:1px solid #e9eaec;backdrop-filter:blur(16px);color:#242528;font:14px Inter,sans-serif}.how-header nav{display:flex;gap:30px}.how-header [aria-current]{color:#6579b5}.how-brand{display:flex;align-items:center;gap:14px;font-size:16px;font-weight:600}.how-brand span{font-size:30px;letter-spacing:-5px;color:#7887d8}.how-button{display:inline-flex;border:1px solid #dedfe2;border-radius:7px;padding:12px 18px;background:white;font-size:14px;color:#242528}.how-intro,.how-savings,.how-passport,.how-end{max-width:1240px;margin:auto;padding:85px 48px;color:#242528}.how-intro,.how-passport,.how-end{text-align:center}.how-eyebrow{font-size:12px!important;letter-spacing:.14em;color:#7d818a!important;margin-bottom:24px!important}.how-intro h1{font:500 clamp(48px,7vw,84px)/1.05 Inter,sans-serif;letter-spacing:-.05em}.how-intro>p:not(.how-eyebrow){max-width:720px;margin:28px auto;font-size:20px;line-height:1.6;color:#72777e}.how-savings{background:#f7f8fa}.how-savings h2,.how-passport h2,.how-end h2{font:500 clamp(30px,4vw,48px)/1.15 Inter,sans-serif;letter-spacing:-.045em}.how-savings h2 span,.how-end h2 span{color:#8a909b}.how-savings>p:not(.how-eyebrow),.how-passport>p:not(.how-eyebrow){max-width:690px;font-size:17px;line-height:1.7;color:#72777e;margin-top:24px}.how-passport>p{margin-inline:auto}.how-savings>div{display:grid;grid-template-columns:repeat(3,1fr);gap:35px;margin-top:45px}.how-savings h3{font-size:17px;font-weight:500;margin-bottom:12px}.how-savings article p{color:#72777e;line-height:1.7;font-size:15px}.how-passport .how-fall{font-size:12px!important}.how-end .how-button{margin-top:30px}#workflow{scroll-margin-top:80px}.how-skip{position:fixed;top:-100px;z-index:100;background:white;padding:15px}.how-skip:focus{top:0}@media(max-width:720px){.how-header{padding:0 18px}.how-header nav{gap:14px}.how-header>.how-button{display:none}.how-brand{font-size:13px}.how-intro,.how-savings,.how-passport,.how-end{padding:55px 24px}.how-savings>div{grid-template-columns:1fr;gap:25px}.how-intro>p:not(.how-eyebrow){font-size:17px}}
</style>
