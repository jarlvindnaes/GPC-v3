---
import { DppPhoneScreen } from "../components/dpp/DppPhoneScreen";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="DPP Phone Test | Product Connect">
  <!-- Standalone test page: just the DPP phone content in a 375x812 frame.
       No navbar, footer, or smooth scroll. Visit /GPC-v3/dpp-test -->
  <div
    style="display:flex; align-items:center; justify-content:center; min-height:100vh; background:#1e1e2e;"
  >
    <div
      style="width:375px; height:812px; border-radius:40px; overflow:hidden; box-shadow:0 24px 80px rgba(0,0,0,0.5); flex-shrink:0; position:relative; background:#fff;"
    >
      <DppPhoneScreen client:only="react" />
    </div>
  </div>
</BaseLayout>
