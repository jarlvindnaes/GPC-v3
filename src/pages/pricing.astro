---
import { Pricing } from "../components/Pricing";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Pricing | Product Connect">
  <main class="pt-32 pb-24">
    <div class="mx-auto mb-16 max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1
        class="mb-6 font-display font-semibold text-3xl text-balance text-brand-darkest tracking-tight sm:text-5xl md:text-6xl"
      >
        Simple, transparent pricing
      </h1>
      <p class="mx-auto max-w-2xl text-pretty text-base text-brand-text sm:text-lg md:text-xl">
        We don't profit from your dependency. We profit from your capability.
      </p>
    </div>
    <!-- Pricing is static content: no client directive → rendered to HTML, zero JS -->
    <Pricing />
  </main>
</SiteLayout>
