---
// Playground: the animated Product Connect logo (PcLogoAnimated) next to the static one (PcLogo),
// large and at header size, on light and dark.
import PcLogo from '../components/PcLogo.astro';
import PcLogoAnimated from '../components/PcLogoAnimated.astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Logo animation — Product Connect</title>
<meta name="robots" content="noindex" />
<link rel="icon" href={`${base}nextgen/favicon.svg`} />
<style is:inline set:html={`@font-face{font-family:Inter;src:url("${base}fonts/inter-latin.woff2") format("woff2");font-display:swap;font-weight:100 900}`} />
</head>
<body>
<main>
  <section class="panel light">
    <p class="label">Animated</p>
    <PcLogoAnimated class="big" />
    <div class="row">
      <span class="brand"><PcLogoAnimated class="small" /><span>product<br />connect</span></span>
      <span class="brand"><PcLogo class="small" /><span>product<br />connect</span></span>
    </div>
    <p class="note">Header size: animated (left), static (right)</p>
  </section>
  <section class="panel dark">
    <p class="label">Animated, on dark</p>
    <PcLogoAnimated class="big" />
    <div class="row">
      <span class="brand"><PcLogoAnimated class="small" /><span>product<br />connect</span></span>
      <span class="brand"><PcLogo class="small" /><span>product<br />connect</span></span>
    </div>
    <p class="note">Header size: animated (left), static (right)</p>
  </section>
</main>
<style>
  body { margin: 0; font-family: Inter, Arial, sans-serif; }
  main { display: grid; grid-template-columns: 1fr 1fr; min-height: 100svh; }
  .panel { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 48px; padding: 64px 24px; }
  .light { background: #fff; color: #242528; }
  .dark { background: #0a1017; color: #fff; --pc-logo-dot: #d6ef8c; }
  .label { margin: 0; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; opacity: .6; }
  .panel :global(.big) { height: min(260px, 40vw); margin-right: min(110px, 17vw); /* room for the dots' loop on the right */ }
  .panel :global(.small) { height: 34px; }
  .row { display: flex; gap: 72px; }
  .brand { display: flex; align-items: center; gap: 12px; font-size: 17px; line-height: .98; letter-spacing: -.7px; font-weight: 550; }
  .note { margin: 0; font-size: 12px; opacity: .55; }
  @media (max-width: 720px) { main { grid-template-columns: 1fr; } }
</style>
</body>
</html>
